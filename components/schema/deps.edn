{:paths ["src" "gen" "resources" "classes"]
 ;; fdb sits in top-level deps even though only the prep step's javac uses
 ;; the record layer's annotations: b/javac builds its basis from the
 ;; brick's deps.edn with no aliases, so it sees these rather than the
 ;; :build alias's own :deps. The :build alias repeats the pin because an
 ;; alias :deps key replaces the project's, and gen-proto resolves the
 ;; record-layer JAR off that alias's classpath to extract its .proto
 ;; files.
 :deps {pin/protojure {:local/root "../../deps/protojure"}
        pin/fdb {:local/root "../../deps/fdb"}}
 :deps/prep-lib {:alias :build :fn build/gen-proto :ensure "classes"}
 :aliases {:test {:extra-paths ["test" "test-resources"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                          pin/fdb {:local/root "../../deps/fdb"}}
                   :extra-deps {com.repldriven.queenswood/build
                                {:local/root "../../bases/build"}}
                   :paths ["."]}}}
