{
  "type": "record",
  "name": "TransactionPosted",
  "namespace": "com.repldriven.mono.transactions",
  "doc": "A transaction and its legs, as recorded.",
  "fields": [
    {"name": "bank_id",          "type": "string"},
    {"name": "transaction_id",   "type": "string"},
    {"name": "transaction_type", "type": {"type": "enum",
                                          "name": "TransactionType",
                                          "symbols": ["TRANSACTION_TYPE_UNKNOWN",
                                                      "TRANSACTION_TYPE_INTERNAL_TRANSFER",
                                                      "TRANSACTION_TYPE_INBOUND_TRANSFER",
                                                      "TRANSACTION_TYPE_OUTBOUND_TRANSFER",
                                                      "TRANSACTION_TYPE_FEE",
                                                      "TRANSACTION_TYPE_INTEREST_ACCRUAL",
                                                      "TRANSACTION_TYPE_INTEREST_CAPITAL",
                                                      "TRANSACTION_TYPE_REWARD"]}},
    {"name": "currency",         "type": "string", "doc": "ISO 4217"},
    {"name": "scheme_account_id", "type": ["null", "string"], "default": null,
     "doc": "the cash account the scheme moved the money through, where the payment scheme itself settled the posting"},
    {"name": "legs",
     "type": {"type": "array",
              "items": {
                "type": "record",
                "name": "PostedLeg",
                "fields": [
                  {"name": "account_id",     "type": "string"},
                  {"name": "balance_type",   "type": {"type": "enum",
                                                      "name": "BalanceType",
                                                      "symbols": ["BALANCE_TYPE_UNKNOWN",
                                                                  "BALANCE_TYPE_DEFAULT",
                                                                  "BALANCE_TYPE_INTEREST_ACCRUED",
                                                                  "BALANCE_TYPE_PURCHASE",
                                                                  "BALANCE_TYPE_CASH",
                                                                  "BALANCE_TYPE_SUSPENSE",
                                                                  "BALANCE_TYPE_INTEREST_PAYABLE"]}},
                  {"name": "balance_status", "type": {"type": "enum",
                                                      "name": "BalanceStatus",
                                                      "symbols": ["BALANCE_STATUS_UNKNOWN",
                                                                  "BALANCE_STATUS_POSTED",
                                                                  "BALANCE_STATUS_PENDING_INCOMING",
                                                                  "BALANCE_STATUS_PENDING_OUTGOING"]}},
                  {"name": "side",           "type": {"type": "enum",
                                                      "name": "LegSide",
                                                      "symbols": ["LEG_SIDE_UNKNOWN",
                                                                  "LEG_SIDE_DEBIT",
                                                                  "LEG_SIDE_CREDIT"]}},
                  {"name": "amount",         "type": "long"},
                  {"name": "control",        "type": ["null", "boolean"], "default": null}
                ]}}}
  ]
}
