{
  "type": "record",
  "name": "CreateBank",
  "namespace": "com.repldriven.queenswood.schema.bank",
  "fields": [
    {"name": "name",   "type": "string"},
    {"name": "status", "type": {"type": "enum",
                                "name": "BankStatus",
                                "symbols": ["BANK_STATUS_UNKNOWN",
                                            "BANK_STATUS_TEST",
                                            "BANK_STATUS_LIVE"]}},
    {"name": "tier",   "type": "string"},
    {"name": "providers", "type": {"type": "array", "items": {
      "type": "record",
      "name": "BankProvider",
      "fields": [
        {"name": "kind",     "type": "string"},
        {"name": "provider", "type": "string"}
      ]
    }}, "default": []},
    {"name": "company_binding", "type": ["null", {
      "type": "record",
      "name": "CompanyBinding",
      "fields": [
        {"name": "registry", "type": {"type": "enum",
                                      "name": "CompanyRegistry",
                                      "symbols": ["COMPANY_REGISTRY_UNKNOWN",
                                                  "COMPANY_REGISTRY_UK_COMPANIES_HOUSE"]}},
        {"name": "company_number",  "type": "string"},
        {"name": "name",            "type": "string"},
        {"name": "status",          "type": "string"},
        {"name": "company_type",    "type": "string"},
        {"name": "jurisdiction",    "type": ["null", "string"], "default": null},
        {"name": "incorporated_on", "type": ["null", "long"], "default": null},
        {"name": "registered_office_address", "type": ["null", {
          "type": "record",
          "name": "RegisteredOfficeAddress",
          "fields": [
            {"name": "address_line_1", "type": ["null", "string"], "default": null},
            {"name": "locality",       "type": ["null", "string"], "default": null},
            {"name": "postal_code",    "type": ["null", "string"], "default": null},
            {"name": "country",        "type": ["null", "string"], "default": null}
          ]
        }], "default": null}
      ]
    }], "default": null},
    {"name": "currencies", "type": {"type": "array", "items": "string"}},
    {"name": "audience", "type": ["null", "string"], "default": null,
     "doc": "JWT aud claim for the bank's service-account client, resolved by bank-api from its status->audience config"},
    {"name": "member", "type": ["null", {
      "type": "record",
      "name": "MemberSpec",
      "doc": "The owner member to create with the bank, when a person creates it",
      "fields": [
        {"name": "user_id", "type": "string"},
        {"name": "role", "type": {"type": "enum",
                                  "name": "Role",
                                  "symbols": ["ROLE_UNKNOWN", "ROLE_OWNER"]}}
      ]
    }], "default": null},
    {"name": "owner_invitation", "type": ["null", {
      "type": "record",
      "name": "OwnerInvitationSpec",
      "doc": "The owner invitation to create with the bank, when an operator names an owner",
      "fields": [
        {"name": "email",      "type": "string"},
        {"name": "token_hash", "type": ["null", "string"], "default": null}
      ]
    }], "default": null},
    {"name": "actor", "type": {
      "type": "record",
      "name": "ActorSpec",
      "doc": "Who created the bank",
      "fields": [
        {"name": "kind", "type": {"type": "enum",
                                  "name": "ActorKind",
                                  "symbols": ["ACTOR_KIND_MEMBER",
                                              "ACTOR_KIND_OPERATOR",
                                              "ACTOR_KIND_BANK"]}},
        {"name": "principal_id", "type": "string"}
      ]
    }}
  ]
}
