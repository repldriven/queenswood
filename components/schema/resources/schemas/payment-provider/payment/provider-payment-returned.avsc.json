{
  "type": "record",
  "name": "ProviderPaymentReturned",
  "namespace": "com.repldriven.queenswood.schema.payment_provider.payment",
  "fields": [
    {"name": "end_to_end_id",         "type": "string"},
    {"name": "scheme",                "type": "string"},
    {"name": "debit_credit_code",     "type": {
      "type": "enum",
      "name": "DebitCreditCode",
      "symbols": [
        "DEBIT_CREDIT_CODE_UNKNOWN",
        "DEBIT_CREDIT_CODE_DEBIT",
        "DEBIT_CREDIT_CODE_CREDIT"
      ]
    }},
    {"name": "scheme_transaction_id", "type": "string"},
    {"name": "amount",                "type": "long"},
    {"name": "currency",              "type": "string"},
    {"name": "reason_code",           "type": "string"},
    {"name": "reason",                "type": ["null", "string"], "default": null},
    {"name": "timestamp_returned",    "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
