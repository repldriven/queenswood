{
  "type": "record",
  "name": "RecordTransaction",
  "namespace": "com.repldriven.queenswood.schema.transaction",
  "fields": [
    {"name": "bank_id",           "type": "string",
     "doc": "owning bank; heads the primary key of every balance the legs reach"},
    {"name": "transaction_type",  "type": {"type": "enum",
                                            "name": "TransactionType",
                                            "symbols": ["TRANSACTION_TYPE_INTERNAL_TRANSFER",
                                                         "TRANSACTION_TYPE_INBOUND_TRANSFER",
                                                         "TRANSACTION_TYPE_OUTBOUND_TRANSFER",
                                                         "TRANSACTION_TYPE_FEE",
                                                         "TRANSACTION_TYPE_INTEREST_ACCRUAL",
                                                         "TRANSACTION_TYPE_INTEREST_CAPITALIZATION"]}},
    {"name": "currency",          "type": "string", "doc": "ISO 4217"},
    {"name": "reference",         "type": ["null", "string"], "default": null},
    {"name": "legs",
     "type": {"type": "array",
              "items": {
                "type": "record",
                "name": "RecordTransactionLeg",
                "fields": [
                  {"name": "account_id",     "type": "string"},
                  {"name": "balance_type",   "type": {"type": "enum",
                                                       "name": "BalanceType",
                                                       "symbols": ["BALANCE_TYPE_DEFAULT",
                                                                    "BALANCE_TYPE_INTEREST_ACCRUED"]}},
                  {"name": "balance_status", "type": {"type": "enum",
                                                       "name": "BalanceStatus",
                                                       "symbols": ["BALANCE_STATUS_POSTED",
                                                                    "BALANCE_STATUS_PENDING_INCOMING",
                                                                    "BALANCE_STATUS_PENDING_OUTGOING"]}},
                  {"name": "side",           "type": {"type": "enum",
                                                       "name": "LegSide",
                                                       "symbols": ["LEG_SIDE_DEBIT",
                                                                    "LEG_SIDE_CREDIT"]}},
                  {"name": "amount",         "type": "long", "doc": "minor units"},
                  {"name": "product_type",
                   "type": ["null",
                            {"type": "enum",
                             "name": "AccountProductType",
                             "symbols": ["ACCOUNT_PRODUCT_TYPE_UNKNOWN",
                                         "ACCOUNT_PRODUCT_TYPE_GENERAL_LEDGER",
                                         "ACCOUNT_PRODUCT_TYPE_SUB_LEDGER_CURRENT",
                                         "ACCOUNT_PRODUCT_TYPE_SUB_LEDGER_SAVINGS",
                                         "ACCOUNT_PRODUCT_TYPE_SUB_LEDGER_TERM_DEPOSIT",
                                         "ACCOUNT_PRODUCT_TYPE_SUB_LEDGER_OWN_FUNDS"]}],
                   "default": null,
                   "doc": "the cash account's product type, which a control sums its legs by, see ADR-0042"}
                ]}}}
  ]
}
