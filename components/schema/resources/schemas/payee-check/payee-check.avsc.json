{
  "type": "record",
  "name": "PayeeCheck",
  "namespace": "com.repldriven.queenswood.schema.payee_check",
  "fields": [
    {
      "name": "bank_id",
      "type": "string"
    },
    {
      "name": "check_id",
      "type": "string"
    },
    {
      "name": "request",
      "type": {
        "type": "record",
        "name": "PayeeCheckRequest",
        "fields": [
          {
            "name": "creditor_name",
            "type": "string"
          },
          {
            "name": "account",
            "type": {
              "type": "record",
              "name": "AccountIdentifier",
              "fields": [
                {
                  "name": "sort_code",
                  "type": "string"
                },
                {
                  "name": "account_number",
                  "type": "string"
                }
              ]
            }
          },
          {
            "name": "account_type",
            "type": {
              "type": "enum",
              "name": "AccountType",
              "symbols": [
                "ACCOUNT_TYPE_UNKNOWN",
                "ACCOUNT_TYPE_PERSONAL",
                "ACCOUNT_TYPE_BUSINESS"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "result",
      "type": {
        "type": "record",
        "name": "PayeeCheckResult",
        "fields": [
          {
            "name": "match_result",
            "type": {
              "type": "enum",
              "name": "MatchResult",
              "symbols": [
                "MATCH_RESULT_UNKNOWN",
                "MATCH_RESULT_MATCH",
                "MATCH_RESULT_CLOSE_MATCH",
                "MATCH_RESULT_NO_MATCH",
                "MATCH_RESULT_UNAVAILABLE"
              ]
            }
          },
          {
            "name": "actual_name",
            "type": "string"
          },
          {
            "name": "reason_code",
            "type": "string"
          },
          {
            "name": "reason",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
