{
  "type": "record",
  "name": "IdvSession",
  "namespace": "com.repldriven.queenswood.schema.idv",
  "fields": [
    {"name": "bank_id",         "type": "string"},
    {"name": "session_id",      "type": "string"},
    {"name": "verification_id", "type": "string"},
    {"name": "party_id",        "type": "string"},
    {"name": "status",          "type": {"type": "enum",
                                          "name": "IdvSessionStatus",
                                          "symbols": ["IDV_SESSION_STATUS_UNKNOWN",
                                                       "IDV_SESSION_STATUS_OPENING",
                                                       "IDV_SESSION_STATUS_READY",
                                                       "IDV_SESSION_STATUS_COMPLETED",
                                                       "IDV_SESSION_STATUS_FAILED"]}},
    {"name": "channel",         "type": {"type": "enum",
                                          "name": "IdvSessionChannel",
                                          "symbols": ["IDV_SESSION_CHANNEL_UNKNOWN",
                                                       "IDV_SESSION_CHANNEL_WEB",
                                                       "IDV_SESSION_CHANNEL_MOBILE"]}},
    {"name": "return_url",      "type": "string"},
    {"name": "created_at",      "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "created_by",      "type": {"type": "record",
                                          "name": "ActorSpec",
                                          "doc": "Who created it",
                                          "fields": [
                                            {"name": "kind", "type": {"type": "enum",
                                                                      "name": "ActorKind",
                                                                      "symbols": ["ACTOR_KIND_MEMBER",
                                                                                  "ACTOR_KIND_OPERATOR",
                                                                                  "ACTOR_KIND_BANK"]}},
                                            {"name": "principal_id", "type": "string"}]}},
    {"name": "updated_at",      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null}
  ]
}
