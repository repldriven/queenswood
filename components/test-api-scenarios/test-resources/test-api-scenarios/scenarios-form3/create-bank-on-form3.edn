{:name "A bank is created on the payment provider this installation offers, and not on another"
 :tags #{:api :banks :happy}
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-bank-on-form3-001"}
             :body {:name "Rails Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :providers {:payment "form3"}}}
   :as :bank-0
   :assert {:status 201 :body {:providers {:payment "form3" :idv "zyphe"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-bank-on-form3-002"}
             :body {:name "Not Offered Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :providers {:payment "modulr"}}}
   :assert {:status 422 :body {:type ":bank/unknown-provider"}}}]}
