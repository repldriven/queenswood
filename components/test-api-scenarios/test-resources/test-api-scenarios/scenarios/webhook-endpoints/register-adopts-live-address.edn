{:name "Registering an address the bank already has returns that endpoint"
 ;; A client that crashed and registers again under a fresh key gets
 ;; the endpoint it had, with the secret it was given, rather than a
 ;; second endpoint or a rotated secret.
 :given [{:fixture :bank :as :org-0 :with {:name "Webhook Adopt Org"}}
         {:command :api/request
          :request {:method :post
                    :path "/v1/webhook-endpoints"
                    :auth [:ref :org-0 :token]
                    :headers {:idempotency-key "ik-webhook-adopt-001"}
                    :body {:address "https://93.184.216.34/hooks"
                           :kinds ["payment.outbound-completed"]}}
          :as :first
          :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :headers {:idempotency-key "ik-webhook-adopt-002"}
             :body {:address "https://93.184.216.34/hooks"
                    :kinds ["payment.outbound-failed"]}}
   :audited false
   :assert {:status 200
            :body {:endpoint {:endpoint-id [:ref :first :endpoint
                                            :endpoint-id]
                              :kinds ["payment.outbound-completed"]}
                   :secret [:ref :first :secret]}}}]
 :then
 [{:command :api/request
   :request
   {:method :get :path "/v1/webhook-endpoints" :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:items [{}]}}}]}
