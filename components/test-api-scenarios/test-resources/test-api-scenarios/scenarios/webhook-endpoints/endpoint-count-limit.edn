{:name "A bank's second webhook endpoint is refused by its tier's limit"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Webhook Cap Org" :status "live" :tier "few-webhooks"}}
  ;; The tier allows one endpoint.
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://93.184.216.34/hooks-1"
                    :kinds ["payment.outbound-completed"]}}
   :as :endpoint-0
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://93.184.216.34/hooks-2"
                    :kinds ["payment.outbound-completed"]}}
   :assert {:status 429
            :problem {:type ":policy/limit-exceeded"
                      :detail
                      "Few-webhooks tier - a bank has at most 1 webhook endpoint"}}}]
 :then
 ;; The refusal came before any write, so the bank holds what it held.
 [{:command :api/request
   :request
   {:method :get :path "/v1/webhook-endpoints" :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body
            {:items
             [{:endpoint-id [:ref :endpoint-0 :endpoint :endpoint-id]}]}}}]}
