{:name "Registering an address the platform will not deliver to is refused"
 ;; A host in each range the platform will not call: link-local,
 ;; private, and the cloud metadata service. An IP literal resolves to
 ;; itself, so the rule decides on the address as written and no DNS is
 ;; involved. The rig admits plain HTTP and loopback, where its receiver
 ;; listens.
 :given [{:fixture :bank :as :org-0 :with {:name "Webhook Address Org"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://169.254.10.1/hooks"}}
   :assert {:status 422 :problem {:type ":webhook-endpoint/invalid-address"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://10.1.2.3/hooks"}}
   :assert {:status 422 :problem {:type ":webhook-endpoint/invalid-address"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://169.254.169.254/latest"}}
   :assert {:status 422 :problem {:type ":webhook-endpoint/invalid-address"}}}]
 :then
 ;; Nothing was registered for any of them.
 [{:command :api/request
   :request {:method :get :path "/v1/webhook-endpoints" :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:items []}}}]}
