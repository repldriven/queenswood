{:name "An account opening is delivered to the tenant's endpoint, signed"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Webhook Delivery Org"}}
  {:fixture :person :as :party-0 :with {:token [:ref :org-0 :token]}}
  {:fixture :product :as :prod-0 :with {:token [:ref :org-0 :token]}}
  {:command :webhook/open-receiver :as :receiver}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address [:ref :receiver :address]
                    :kinds ["cash-account.opened"]}}
   :as :endpoint-0
   :assert {:status 201}}]
 :when
 [{:fixture :account
   :as :acct-0
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :prod-0 :product :product-id]}}]
 :then
 ;; One notification for the opening, whose two legs each write a
 ;; changelog entry. The bank's own account opens alongside, and the
 ;; endpoint may hear of it too.
 [{:command :webhook/await-delivery
   :address [:ref :receiver :address]
   :where {:kind "cash-account.opened"
           :resource-id [:ref :acct-0 :account :account-id]}
   :secret [:ref :endpoint-0 :secret]
   :as :delivered}
  ;; The notification's data is the account as its read route renders it.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :acct-0 :account :account-id]}
             :auth [:ref :org-0 :token]}
   :as :read
   :assert {:status 200}}
  {:command :assert/equals
   :actual [:ref :delivered 0 :body :data]
   :expected [:ref :read]}
  ;; Recorded as delivered, under the id the request carried.
  {:command :api/poll
   :request {:method :get
             :path "/v1/webhook-endpoints/{endpoint-id}/deliveries"
             :path-params {:endpoint-id
                           [:ref :endpoint-0 :endpoint :endpoint-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:items [:m/embeds
                          [{:delivery-id [:ref :delivered 0 :headers
                                          :webhook-id]
                            :status "delivered"}]]}}}]}
