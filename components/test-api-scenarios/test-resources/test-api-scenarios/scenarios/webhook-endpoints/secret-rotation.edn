{:name "Registration and rotation carry the signing secret, a read does not"
 :tags #{:api :webhook-endpoints :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-webhook-rotation-bank-001"}
             :body {:name "Webhook Rotation Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth :org-0-token
             :headers {:idempotency-key "ik-webhook-rotation-endpoint-001"}
             :body {:address "https://93.184.216.34/hooks"
                    :kinds ["cash-account.opened"]}}
   :as :endpoint-0
   :assert {:status 201 :body {:secret [:m/regex "^whsec_[A-Za-z0-9_-]{16,}$"]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints/{endpoint-id}/rotate-secret"
             :path-params {:endpoint-id
                           [:ref :endpoint-0 :endpoint :endpoint-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-webhook-rotation-rotate-001"}}
   :as :rotation-0
   :assert {:status 200
            :body {:secret [:m/regex "^whsec_[A-Za-z0-9_-]{16,}$"]
                   :endpoint {:endpoint-id
                              [:ref :endpoint-0 :endpoint :endpoint-id]}}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/webhook-endpoints/{endpoint-id}"
             :path-params {:endpoint-id
                           [:ref :endpoint-0 :endpoint :endpoint-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:endpoint-id [:ref :endpoint-0 :endpoint :endpoint-id]
                   :secret [:m/absent]}}}
  {:command :api/request
   :request {:method :get :path "/v1/webhook-endpoints" :auth :org-0-token}
   :assert {:status 200
            :body {:items
                   [:m/embeds
                    [{:endpoint-id [:ref :endpoint-0 :endpoint :endpoint-id]
                      :secret [:m/absent]}]]}}}]}
