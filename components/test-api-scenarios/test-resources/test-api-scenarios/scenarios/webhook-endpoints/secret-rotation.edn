{:name "Registration and rotation carry the signing secret, a read does not"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Webhook Rotation Org" :status "live"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://93.184.216.34/hooks"
                    :kinds ["payment.outbound-completed"]}}
   :as :endpoint-0
   :assert {:status 201
            :body {:secret [:m/regex "^whsec_[A-Za-z0-9_-]{16,}$"]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints/{endpoint-id}/rotate-secret"
             :path-params {:endpoint-id [:ref :endpoint-0 :endpoint
                                         :endpoint-id]}
             :auth [:ref :org-0 :token]}
   :as :rotation-0
   :assert {:status 200
            :body {:secret [:m/regex "^whsec_[A-Za-z0-9_-]{16,}$"]
                   :endpoint {:endpoint-id [:ref :endpoint-0 :endpoint
                                            :endpoint-id]}}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/webhook-endpoints/{endpoint-id}"
             :path-params {:endpoint-id [:ref :endpoint-0 :endpoint
                                         :endpoint-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:endpoint-id [:ref :endpoint-0 :endpoint :endpoint-id]
                   :secret [:m/absent]}}}
  {:command :api/request
   :request
   {:method :get :path "/v1/webhook-endpoints" :auth [:ref :org-0 :token]}
   :assert
   {:status 200
    :body
    {:items [:m/embeds
             [{:endpoint-id [:ref :endpoint-0 :endpoint :endpoint-id]
               :secret [:m/absent]}]]}}}]}
