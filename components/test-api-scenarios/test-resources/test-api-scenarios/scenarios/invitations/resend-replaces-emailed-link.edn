{:name "A resent invitation's email replaces the first email's link"
 ;; A resend answers the same invitation with a fresh expiry and records
 ;; the resend. The first email is read before it, so both emails are
 ;; sent; the second records its own token hash, so only the newer link
 ;; accepts.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "link-owner"
   :password "link-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "link-invitee"
   :password "link-invitee"
   :as :invitee-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Resend Link Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "link-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation
                                           :invitation-id]}
             :auth :owner-token}
   :as :owner-membership
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "link-invitee.resent@example.test" :role "viewer"}}
   :as :invitation
   :assert {:status 201}}
  {:command :mail/await-invitation
   :to "link-invitee.resent@example.test"
   :invitation-id [:ref :invitation :invitation-id]
   :as :first-email}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/resend"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:invitation-id [:ref :invitation :invitation-id]
                   :email "link-invitee.resent@example.test"
                   :status "pending"
                   :expires-at [:m/mismatch [:ref :invitation :expires-at]]
                   :token [:m/absent]}}}
  {:command :mail/await-invitation
   :to "link-invitee.resent@example.test"
   :invitation-id [:ref :invitation :invitation-id]
   :nth 2
   :as :second-email}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :first-email :token]}}
   :assert {:status 404 :problem {:type ":invitation/not-found"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :second-email :token]}}
   :assert {:status 201
            :body {:bank-id [:ref :bank :bank-id] :role "viewer"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:kind "invitation-resent"
                             :actor {:kind "member"
                                     :principal-id
                                     [:ref :owner-membership :user-id]}
                             :invitation-id [:ref :invitation
                                             :invitation-id]}]]}}}]}
