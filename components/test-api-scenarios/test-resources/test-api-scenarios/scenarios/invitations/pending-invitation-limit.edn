{:name "A bank's third pending invitation is refused by its tier's limit"
 ;; The tier allows a bank two pending invitations, an operator's as much
 ;; as a member's. Withdrawing one makes room for another.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Pending Limit Bank"
                    :status "test"
                    :tier "few-invitations"
                    :currencies ["GBP"]}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "pending-limit-1@example.test"
                    :role "developer"
                    :reason "Setting the team up"}}
   :as :first
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "pending-limit-2@example.test"
                    :role "developer"
                    :reason "Setting the team up"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "pending-limit-3@example.test"
                    :role "developer"
                    :reason "Setting the team up"}}
   :assert {:status 429
            :problem {:type ":policy/limit-exceeded"
                      :detail
                      "Few-invitations tier - a bank has at most 2 pending invitations"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/withdraw"
             :path-params {:invitation-id [:ref :first :invitation-id]}
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200 :body {:status "withdrawn"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "pending-limit-3@example.test"
                    :role "developer"
                    :reason "Setting the team up"}}
   :assert {:status 201}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/in-any-order
                           [{:email "pending-limit-2@example.test"}
                            {:email "pending-limit-3@example.test"}]]}}}]}
