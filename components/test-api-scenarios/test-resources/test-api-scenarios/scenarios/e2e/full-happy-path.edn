{:name
 "Full happy path: two parties, two products, transfers, payment, interest"
 :tags #{:e2e :happy-path}
 ;; Mirrors bank-test-scenarios/full-happy-path.edn end-to-end via the
 ;; API:
 ;;
 ;;   - Customer bank (own-funds house account auto-created)
 ;;   - Two products: current (rate 0) and savings (rate 3650 bps)
 ;;   - Two person parties — Arthur and Ford — each with a current
 ;;     and a savings account
 ;;   - The bank's own-funds account funded with £50,000 from outside
 ;;     via the simulate endpoint (DEBIT 1100 cash-at-correspondent)
 ;;   - Each party rewarded £1,000 from the bank's own funds via an
 ;;     internal transfer (the bank pays customers from inside)
 ;;   - Arthur moves £750 current → savings
 ;;   - Ford moves £350 current → savings
 ;;   - Ford pays £25 outbound through the scheme path
 ;;   - Daily interest accrues on the savings products and is capitalised
 ;;
 ;; All amounts in pence. Balances asserted via the `:default`
 ;; / `:interest-payable` entries on GET /v1/cash-accounts/{id}/
 ;; balances; the `:m/embeds` matcher pins specific entries
 ;; without constraining what else is present.
 :given
 ;; --- Bank + party setup -------------------------------------------
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-full-happy-path-bank-001"}
             :body {:name "Full Happy Path Customer"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-0 :client-id]
         :client-secret [:ref :bank-0 :client-secret]
         :status :live}
   :as :bank-0-token}
  ;; Two products: current (0 bps) and savings (3650 bps)
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-full-happy-path-prod-001"}
             :body {:name "Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :current-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :current-draft :product-id]
                  :version-id [:ref :current-draft :version-id]}
    :auth :bank-0-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-full-happy-path-prod-002"}
             :body {:name "Savings"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 3650
                    :effective-from "2026-01-01"}}
   :as :savings-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :savings-draft :product-id]
                  :version-id [:ref :savings-draft :version-id]}
    :auth :bank-0-token}
   :assert {:status 200 :body {:status "published"}}}
  ;; Arthur Dent → :arthur (auto-activates via IDV chain)
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-create-arthur-party"}
             :body {:type "person"
                    :display-name "Arthur Dent"
                    :given-name "Arthur"
                    :family-name "Dent"
                    :date-of-birth "1950-07-27"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN555001A"
                                          :issuing-country "GB"}}}
   :as :arthur
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :arthur :party-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:status "active"}}}
  ;; Ford Prefect → :ford
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-create-ford-party"}
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1948-04-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN555002B"
                                          :issuing-country "GB"}}}
   :as :ford
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :ford :party-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:status "active"}}}
  ;; Customer accounts: arthur-current, arthur-savings, ford-current,
  ;; ford-savings — open and wait for "opened".
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-open-arthur-current"}
             :body {:party-id [:ref :arthur :party-id]
                    :name "Arthur Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :arthur-current
   :assert {:status 200 :body {:account-status "opening"}}}
  ;; Re-bind :arthur-current to the polled GET response so later
  ;; steps see the full record (including :bban, which the POST
  ;; response doesn't expose).
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}
   :as :arthur-current}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-open-arthur-savings"}
             :body {:party-id [:ref :arthur :party-id]
                    :name "Arthur Savings"
                    :currency "GBP"
                    :product-id [:ref :savings-draft :product-id]}}
   :as :arthur-savings
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :arthur-savings :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-open-ford-current"}
             :body {:party-id [:ref :ford :party-id]
                    :name "Ford Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :ford-current
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-open-ford-savings"}
             :body {:party-id [:ref :ford :party-id]
                    :name "Ford Savings"
                    :currency "GBP"
                    :product-id [:ref :savings-draft :product-id]}}
   :as :ford-savings
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :ford-savings :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  ;; --- Money in ---------------------------------------------------
  ;; £50,000 from outside into the bank's own-funds house account
  ;; (DEBIT 1100 cash-at-correspondent / CREDIT the house account,
  ;; which rolls up into the 3100 own-funds control)
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/inbound-transfer"
             :path-params {:bank-id [:ref :bank-0 :bank-id]}
             :auth :admin
             :headers {:idempotency-key "ik-fhp-inbound-settlement"}
             :body {:account-id [:ref :bank-0 :accounts 0 :account-id]
                    :amount 5000000
                    :currency "GBP"}}
   :assert {:status 200}}
  ;; £1,000 reward to each party's current account
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-reward-arthur"}
             :body {:debtor-account-id [:ref :bank-0 :accounts 0 :account-id]
                    :creditor-account-id [:ref :arthur-current :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Reward Arthur"}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-reward-ford"}
             :body {:debtor-account-id [:ref :bank-0 :accounts 0 :account-id]
                    :creditor-account-id [:ref :ford-current :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Reward Ford"}}
   :assert {:status 200}}]
 :when
 ;; --- Customer activity ------------------------------------------
 ;; Arthur: £750 current → savings
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-arthur-cur-to-sav"}
             :body {:debtor-account-id [:ref :arthur-current :account-id]
                    :creditor-account-id [:ref :arthur-savings :account-id]
                    :currency "GBP"
                    :amount 75000
                    :reference "Arthur saves"}}
   :assert {:status 200}}
  ;; Ford: £350 current → savings
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-ford-cur-to-sav"}
             :body {:debtor-account-id [:ref :ford-current :account-id]
                    :creditor-account-id [:ref :ford-savings :account-id]
                    :currency "GBP"
                    :amount 35000
                    :reference "Ford saves"}}
   :assert {:status 200}}
  ;; Ford: £25 outbound to Arthur, settling the beer and nuts debt.
  ;; Arthur's BBAN is sort-code ++ account-number from the SCAN
  ;; payment address on his current account.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-fhp-ford-outbound"}
             :body {:debtor-account-id [:ref :ford-current :account-id]
                    :creditor-bban [:ref :arthur-current :bban]
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Beer and nuts"}}
   :assert {:status 200}}]
 :then
 ;; Outbound is async (scheme command → ClearBank → settled event).
 ;; Give the chain ~2s to settle before checking balances.
 ;;
 ;; --- Pre-interest balances --------------------------------------
 ;;   own-funds (house): 5_000_000 - 100_000 - 100_000 = 4_800_000
 ;;   Arthur cur          1_000_00 - 750_00 + 25_00   =    27_500
 ;;   Arthur sav                  + 750_00            =    75_000
 ;;   Ford   cur          1_000_00 - 350_00 - 25_00   =    62_500
 ;;   Ford   sav                  + 350_00            =    35_000
 [{:command :wait :duration-ms 2000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank-0 :accounts 0 :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 4800000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 27500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-savings :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 75000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 62500 :currency "GBP"}}}}
  ;; The settled outbound reads as a posted debit on Ford's statement: the
  ;; submit reserved in pending-outgoing, and settlement cleared the
  ;; reservation and posted the real outflow. Phase is the leg's
  ;; balance-status, not a mutable transaction lifecycle.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :bank-0-token}
   :assert
   {:status 200
    :body {:transactions [:m/embeds
                          [{:reference "Beer and nuts"
                            :transaction-type "outbound-transfer"
                            :side "debit"
                            :balance-status "posted"}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-savings :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 35000 :currency "GBP"}}}}
  ;; --- Interest run -----------------------------------------------
  ;; Daily interest on savings at 3650 bps:
  ;;   Arthur sav  75_000 → 75p accrued
  ;;   Ford   sav  35_000 → 35p accrued
  ;; Both land in customer.interest-accrued (not visible in
  ;; available); the offset is the bank's 2400 interest-payable
  ;; ledger account. The own-funds house account is untouched.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/accrue"
             :path-params {:bank-id [:ref :bank-0 :bank-id]}
             :auth :admin
             :headers {:idempotency-key "ik-fhp-accrue-interest"}
             :body {:as-of-date "2026-05-01"}}
   :assert {:status 200}}
  ;; The own-funds house account is unaffected by interest (the
  ;; offset is the 2400 interest-payable ledger control), so it
  ;; still reads 4_800_000.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank-0 :accounts 0 :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 4800000 :currency "GBP"}}}}
  ;; Capitalisation moves each saver's accrued interest into their
  ;; spendable default-posted balance, offset by the 2400 ledger:
  ;;   Arthur savings.default  += 75      →    75_075
  ;;   Ford   savings.default  += 35      →    35_035
  ;;   current + own-funds accounts unchanged.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/capitalize"
             :path-params {:bank-id [:ref :bank-0 :bank-id]}
             :auth :admin
             :headers {:idempotency-key "ik-fhp-capitalize"}
             :body {:as-of-date "2026-05-01"}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank-0 :accounts 0 :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 4800000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 27500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-savings :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 75075 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-current :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 62500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-savings :account-id]}
             :auth :bank-0-token}
   :assert {:status 200
            :body {:available-balance {:value 35035 :currency "GBP"}}}}]}
