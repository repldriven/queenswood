{:name "Inviting twice under one key creates one invitation"
 :tags #{:access :api :idempotency :happy}
 ;; The second call is answered from the cache: the same invitation,
 ;; marked as a replay. Neither answer carries a token, which only the
 ;; invitation email does. A resend after the replay is a fresh write,
 ;; and the invitee accepts by their verified email.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "replay-owner"
   :password "replay-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "replay-invitee"
   :password "replay-invitee"
   :as :invitee-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-access-replay-bank-001"}
             :body {:name "Replay Invitation Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "replay-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation :invitation-id]}
             :auth :owner-token}
   :assert {:status 201 :body {:role "owner"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-replay-invite-001"}
             :body {:email "replay-invitee@queenswood.local" :role "developer"}}
   :as :first
   :assert {:status 201
            :headers {:idempotent-replayed [:m/absent]}
            :body {:invitation-id [:m/regex "^inv\\."]
                   :token [:m/absent]}}}]
 :then
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-replay-invite-001"}
             :body {:email "replay-invitee@queenswood.local" :role "developer"}}
   :assert {:status 201
            :headers {:idempotent-replayed "true"}
            :body {:invitation-id [:ref :first :invitation-id]
                   :email "replay-invitee@queenswood.local"
                   :status "pending"
                   :token [:m/absent]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/in-any-order
                           [{:email "replay-owner@queenswood.local"
                             :status "accepted"}
                            {:invitation-id [:ref :first :invitation-id]
                             :email "replay-invitee@queenswood.local"
                             :status "pending"}]]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/resend"
             :path-params {:invitation-id [:ref :first :invitation-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-invitation-create-replay-001"}}
   :as :resent
   :assert {:status 200
            :headers {:idempotent-replayed [:m/absent]}
            :body {:invitation-id [:ref :first :invitation-id]
                   :token [:m/absent]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :first :invitation-id]}
             :auth :invitee-token}
   :assert {:status 201
            :body {:bank-id [:ref :bank :bank-id] :role "developer"}}}]}
