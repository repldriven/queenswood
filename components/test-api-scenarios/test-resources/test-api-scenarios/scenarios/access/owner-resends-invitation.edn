{:name "An owner resends an invitation, and the invitee accepts it"
 :tags #{:access :api :happy}
 ;; A resend answers the same invitation with a fresh expiry and records
 ;; the resend. That only the fresh link's token accepts is proved in the
 ;; `membership` brick, since the token reaches nobody but the email.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "resend-owner"
   :password "resend-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "resend-invitee"
   :password "resend-invitee"
   :as :invitee-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-access-owner-resends-invitation-001"}
             :body {:name "Resend Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "resend-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation :invitation-id]}
             :auth :owner-token}
   :as :owner-membership
   :assert {:status 201 :body {:role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-owner-resends-invitation-002"}
             :body {:email "resend-invitee@queenswood.local" :role "developer"}}
   :as :invitation
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/resend"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-owner-resends-invitation-003"}}
   :as :resent
   :assert {:status 200
            :body {:invitation-id [:ref :invitation :invitation-id]
                   :email "resend-invitee@queenswood.local"
                   :status "pending"
                   :expires-at [:m/mismatch [:ref :invitation :expires-at]]
                   :token [:m/absent]}}}]
 :then
 [{:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :invitee-token}
   :assert {:status 201
            :body {:bank-id [:ref :bank :bank-id] :role "developer"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:kind "invitation-resent"
                             :actor {:kind "member"
                                     :principal-id
                                     [:ref :owner-membership :user-id]}
                             :invitation-id [:ref :invitation :invitation-id]}]]}}}]}
