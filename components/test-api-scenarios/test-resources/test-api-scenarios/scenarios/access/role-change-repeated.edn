{:name "Making a member admin twice answers both and records one change"
 :tags #{:access :api :idempotency :happy}
 ;; The body names the role, so the second call converges on the state
 ;; the first made and writes no event. The history's newest two events
 ;; are the one change and the acceptance before it.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "repeat-owner"
   :password "repeat-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "repeat-member"
   :password "repeat-member"
   :as :member-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-access-role-change-repeated-001"}
             :body {:name "Repeated Role Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "repeat-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation :invitation-id]}
             :auth :owner-token}
   :as :owner-membership
   :assert {:status 201 :body {:role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-role-change-repeated-002"}
             :body {:email "repeat-member@queenswood.local" :role "developer"}}
   :as :invitation
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :member-token}
   :as :member-membership
   :assert {:status 201 :body {:role "developer"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/memberships/{membership-id}/change-role"
             :path-params {:membership-id [:ref :member-membership
                                           :membership-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:role "admin"}}
   :assert {:status 200
            :body {:membership-id [:ref :member-membership :membership-id]
                   :role "admin"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/memberships/{membership-id}/change-role"
             :path-params {:membership-id [:ref :member-membership
                                           :membership-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:role "admin"}}
   :assert {:status 200
            :body {:membership-id [:ref :member-membership :membership-id]
                   :role "admin"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :query-params {"page[size]" 2}}
   :assert {:status 200
            :body {:items [{:kind "role-changed"
                            :subject-user-id [:ref :member-membership :user-id]
                            :role-before "developer"
                            :role-after "admin"}
                           {:kind "invitation-accepted"
                            :subject-user-id [:ref :member-membership
                                              :user-id]}]}}}]}
