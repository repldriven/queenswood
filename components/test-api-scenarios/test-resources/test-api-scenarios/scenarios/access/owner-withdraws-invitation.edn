{:name "An owner withdraws a pending invitation, and the bank no longer lists it"
 :tags #{:access :api :happy}
 ;; The bank's list still holds the owner's own accepted invitation, so
 ;; it is never empty and every item it holds is checked against the
 ;; withdrawn one.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "withdraw-owner"
   :password "withdraw-owner"
   :as :owner-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key
                       "ik-access-owner-withdraws-invitation-001"}
             :body {:name "Withdraw Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "withdraw-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation :invitation-id]}
             :auth :owner-token}
   :as :owner-membership
   :assert {:status 201 :body {:role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key
                       "ik-access-owner-withdraws-invitation-002"}
             :body {:email "withdraw-invitee@example.test" :role "viewer"}}
   :as :invitation
   :assert {:status 201}}
  {:command :api/request
   :request {:method :get
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:invitation-id [:ref :invitation :invitation-id]
                             :status "pending"}]]}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/withdraw"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:reason "Sent to the wrong address"}}
   :assert {:status 200
            :body {:invitation-id [:ref :invitation :invitation-id]
                   :email "withdraw-invitee@example.test"
                   :status "withdrawn"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/all-of
                           [:m/embeds
                            [{:invitation-id [:ref :bank :owner-invitation :invitation-id]
                              :status "accepted"}]]
                           [:m/seq-of
                            [:m/mismatch
                             {:invitation-id [:ref :invitation :invitation-id]}]]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/banks/{bank-id}/audit-events"
             :path-params {:bank-id [:ref :bank :bank-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:kind "invitation-withdrawn"
                             :actor {:kind "member"
                                     :principal-id
                                     [:ref :owner-membership :user-id]}
                             :invitation-id [:ref :invitation :invitation-id]
                             :email "withdraw-invitee@example.test"
                             :role-after "viewer"
                             :reason "Sent to the wrong address"}]]}}}]}
