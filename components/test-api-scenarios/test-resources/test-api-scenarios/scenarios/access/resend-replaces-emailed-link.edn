{:name "A resent invitation's email replaces the first email's link"
 :tags #{:access :api}
 ;; The first email is read before the resend, so both emails are sent.
 ;; The resend returns the token hash to the invitation's id and the
 ;; second email records its own, so only the newer link accepts.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "link-owner"
   :password "link-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "link-invitee"
   :password "link-invitee"
   :as :invitee-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-access-resend-link-bank-001"}
             :body {:name "Resend Link Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "link-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation
                                           :invitation-id]}
             :auth :owner-token}
   :assert {:status 201 :body {:role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-resend-link-invite-001"}
             :body {:email "link-invitee.resent@example.test" :role "viewer"}}
   :as :invitation
   :assert {:status 201}}
  {:command :mail/await-invitation
   :to "link-invitee.resent@example.test"
   :invitation-id [:ref :invitation :invitation-id]
   :as :first-email}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/resend"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-resend-link-resend-001"}}
   :assert {:status 200 :body {:status "pending"}}}
  {:command :mail/await-invitation
   :to "link-invitee.resent@example.test"
   :invitation-id [:ref :invitation :invitation-id]
   :nth 2
   :as :second-email}]
 :then
 [{:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :first-email :token]}}
   :assert {:status 404 :problem {:type ":invitation/not-found"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :second-email :token]}}
   :assert {:status 201
            :body {:bank-id [:ref :bank :bank-id] :role "viewer"}}}]}
