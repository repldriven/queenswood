{:name "A recipient declines an invitation with its token"
 :tags #{:access :api :happy}
 ;; The invitation names an address the recipient does not sign in with,
 ;; so the token is the proof that reaches it, and it still reads the
 ;; invitation once declined.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "decline-owner"
   :password "decline-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "decline-invitee"
   :password "decline-invitee"
   :as :invitee-token}
  {:command :api/request
   :request {:method :get :path "/v1/me" :auth :invitee-token}
   :as :invitee-me
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-access-recipient-declines-001"}
             :body {:name "Decline Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "decline-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation
                                           :invitation :invitation-id]}
             :auth :owner-token
             :headers {:invitation-token [:ref :bank :owner-invitation :token]}}
   :as :owner-membership
   :assert {:status 201 :body {:role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-recipient-declines-002"}
             :body {:email "decline-invitee@example.test" :role "developer"}}
   :as :invitation
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/decline"
             :path-params {:invitation-id [:ref :invitation :invitation
                                           :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :invitation :token]}}
   :assert {:status 200
            :body {:invitation-id [:ref :invitation :invitation
                                   :invitation-id]
                   :bank-id [:ref :bank :bank-id]
                   :role "developer"
                   :status "declined"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/me/invitations/{invitation-id}"
             :path-params {:invitation-id [:ref :invitation :invitation
                                           :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :invitation :token]}}
   :assert {:status 200
            :body {:invitation-id [:ref :invitation :invitation
                                   :invitation-id]
                   :status "declined"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation
                                           :invitation-id]}
             :auth :invitee-token
             :headers {:invitation-token [:ref :invitation :token]}}
   :assert {:status 409 :problem {:type ":invitation/invalid-status"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/access-events"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:kind "invitation-declined"
                             :actor {:kind "member"
                                     :principal-id
                                     [:ref :invitee-me :user :user-id]}
                             :subject-user-id [:ref :invitee-me :user
                                               :user-id]
                             :invitation-id [:ref :invitation :invitation
                                             :invitation-id]
                             :email "decline-invitee@example.test"
                             :role-after "developer"}]]}}}]}
