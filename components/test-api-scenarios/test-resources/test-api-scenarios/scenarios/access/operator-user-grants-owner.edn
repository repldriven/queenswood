{:name "An operator signed in as a user grants an owner, and history names them"
 :tags #{:access :api :happy}
 ;; The bank is created with no owner, so the operator's is the only owner
 ;; invitation. An operator-realm user acts on the bank the Bank-Id header
 ;; names, and is recorded by user id and named from their user record,
 ;; captured from `GET /v1/me` for the same token.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood-ops
   :client-id "queenswood-app"
   :username "ops"
   :password "ops"
   :as :ops-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "opsgrant-founder"
   :password "opsgrant-founder"
   :as :founder-token}
  {:command :api/request
   :request {:method :get :path "/v1/me" :auth :ops-token}
   :as :ops-me
   :assert {:status 200
            :body {:user {:user-id [:m/regex "^usr\\."]
                          :name [:m/non-empty]}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-access-operator-user-grants-owner-001"}
             :body {:name "Operator Grant Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank
   :assert {:status 201 :body {:owner-invitation [:m/absent]}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :ops-token
             :headers {:bank-id [:ref :bank :bank-id]
                       :idempotency-key "ik-access-operator-user-grants-owner-002"}
             :body {:email "opsgrant-founder@queenswood.local"
                    :role "owner"
                    :reason "The founder asked to be set up as owner"}}
   :as :invitation
   :assert {:status 201
            :body {:role "owner"
                   :invited-by {:kind "operator"
                                :principal-id [:ref :ops-me :user :user-id]
                                :name [:ref :ops-me :user :name]}
                   :token [:m/absent]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :founder-token}
   :as :founder-membership
   :assert {:status 201 :body {:role "owner"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/access-events"
             :auth :founder-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :query-params {"page[size]" 2}}
   :assert
   {:status 200
    :body {:items [{:kind "invitation-accepted"
                    :actor {:kind "member"
                            :principal-id [:ref :founder-membership :user-id]}}
                   {:kind "invitation-created"
                    :actor {:kind "operator"
                            :principal-id [:ref :ops-me :user :user-id]
                            :name [:ref :ops-me :user :name]}
                    :invitation-id [:ref :invitation :invitation-id]
                    :email "opsgrant-founder@queenswood.local"
                    :role-after "owner"
                    :reason "The founder asked to be set up as owner"}]}}}]}
