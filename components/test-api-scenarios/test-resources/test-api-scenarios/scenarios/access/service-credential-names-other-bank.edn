{:name "A service credential naming another bank in Bank-Id is refused"
 :tags #{:access :api :auth :unhappy}
 ;; The same bearer reads its own bank, with or without the header, so
 ;; what refuses the last read is the bank the header names.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key
                       "ik-access-service-credential-names-other-bank-001"}
             :body {:name "Credential Bank A"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-a
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key
                       "ik-access-service-credential-names-other-bank-002"}
             :body {:name "Credential Bank B"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-b
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-a :client-id]
         :client-secret [:ref :bank-a :client-secret]
         :status :live}
   :as :bank-a-token}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/cash-accounts" :auth :bank-a-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :headers {:bank-id [:ref :bank-a :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :headers {:bank-id [:ref :bank-b :bank-id]}}
   :assert {:status 403
            :problem {:type "auth/forbidden"
                      :detail "The caller is not a member of this bank"}}}]}
