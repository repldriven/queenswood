{:name "An endpoint that is down receives everything it missed once it recovers"
 ;; The rig retries every quarter-second and opens an endpoint's breaker
 ;; after three failures for a quarter-second at first, so the outage
 ;; plays out here in seconds.
 :given [{:fixture :bank :as :bank-0 :with {:name "Outage Journey"}}
         {:fixture :webhook-receiver
          :as :hook
          :with {:token [:ref :bank-0 :token]}}]
 :when
 [{:fixture :person
   :as :before
   :with {:token [:ref :bank-0 :token]
          :display-name "Ford Prefect"
          :given-name "Ford"
          :family-name "Prefect"
          :national-insurance "TN000011A"}}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "party.opened" :resource-id [:ref :before :party :party-id]}
   :secret [:ref :hook :registered :secret]}
  {:command :webhook/receiver-answers
   :address [:ref :hook :receiver :address]
   :status 503}
  {:fixture :person
   :as :during
   :with {:token [:ref :bank-0 :token]
          :display-name "Tricia McMillan"
          :given-name "Tricia"
          :family-name "McMillan"
          :national-insurance "TN000012A"}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/webhook-endpoints/{endpoint-id}/deliveries"
             :path-params {:endpoint-id [:ref :hook :registered :endpoint
                                         :endpoint-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [:m/embeds
                          [{:status "pending" :last-response-status 503}]]}}}
  ;; A notification raised while the endpoint is down is kept for it.
  {:fixture :person
   :as :later
   :with {:token [:ref :bank-0 :token]
          :display-name "Zaphod Beeblebrox"
          :given-name "Zaphod"
          :family-name "Beeblebrox"
          :national-insurance "TN000013A"}}
  {:command :webhook/receiver-answers
   :address [:ref :hook :receiver :address]
   :status 200}]
 :then
 [{:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "party.opened" :resource-id [:ref :during :party :party-id]}
   :secret [:ref :hook :registered :secret]}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "party.opened" :resource-id [:ref :later :party :party-id]}
   :secret [:ref :hook :registered :secret]}
  ;; The customer did nothing, and the endpoint was never paused.
  {:command :api/request
   :request {:method :get
             :path "/v1/webhook-endpoints/{endpoint-id}"
             :path-params {:endpoint-id [:ref :hook :registered :endpoint
                                         :endpoint-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "enabled"}}}]}
