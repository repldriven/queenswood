{:name "An endpoint fails until it is paused, and recovers everything it missed"
 ;; The rig retries every quarter-second and pauses after four failed
 ;; attempts and a second without a success, so the outage plays out
 ;; here in seconds.
 :given [{:fixture :bank :as :bank-0 :with {:name "Outage Journey"}}
         {:fixture :webhook-receiver
          :as :hook
          :with {:token [:ref :bank-0 :token]}}]
 :when
 [{:fixture :person
   :as :before
   :with {:token [:ref :bank-0 :token]
          :display-name "Ford Prefect"
          :given-name "Ford"
          :family-name "Prefect"
          :national-insurance "TN000011A"}}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "party.opened" :resource-id [:ref :before :party :party-id]}
   :secret [:ref :hook :registered :secret]
   :as :delivered}
  {:command :webhook/receiver-answers
   :address [:ref :hook :receiver :address]
   :status 503}
  {:fixture :person
   :as :during
   :with {:token [:ref :bank-0 :token]
          :display-name "Tricia McMillan"
          :given-name "Tricia"
          :family-name "McMillan"
          :national-insurance "TN000012A"}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/webhook-endpoints/{endpoint-id}"
             :path-params {:endpoint-id [:ref :hook :registered :endpoint
                                         :endpoint-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "paused"}}}
  ;; Nothing is sent to a paused endpoint, but the notification is kept.
  {:fixture :person
   :as :paused
   :with {:token [:ref :bank-0 :token]
          :display-name "Zaphod Beeblebrox"
          :given-name "Zaphod"
          :family-name "Beeblebrox"
          :national-insurance "TN000013A"}}
  {:command :webhook/receiver-answers
   :address [:ref :hook :receiver :address]
   :status 200}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints/{endpoint-id}/enable"
             :path-params {:endpoint-id [:ref :hook :registered :endpoint
                                         :endpoint-id]}
             :auth [:ref :bank-0 :token]
             :body {}}
   :assert {:status 200 :body {:status "enabled"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints/{endpoint-id}/resend"
             :path-params {:endpoint-id [:ref :hook :registered :endpoint
                                         :endpoint-id]}
             :auth [:ref :bank-0 :token]
             :body {:from [:ref :delivered 0 :body :occurred-at]}}
   :assert {:status 200}}]
 :then
 [{:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "party.opened" :resource-id [:ref :paused :party :party-id]}
   :secret [:ref :hook :registered :secret]}
  ;; What got through before the outage arrives again as the same
  ;; notification, which the customer recognises as done.
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "party.opened" :resource-id [:ref :before :party :party-id]}
   :count 2
   :secret [:ref :hook :registered :secret]
   :as :twice}
  {:command :assert/equals
   :actual [:ref :twice 1 :body :notification-id]
   :expected [:ref :delivered 0 :body :notification-id]}]}
