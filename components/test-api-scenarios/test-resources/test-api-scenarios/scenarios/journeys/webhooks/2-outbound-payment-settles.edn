{:name "The customer is told a payment settled, or failed, under the key it sent"
 :runs-on {:payment :every}
 ;; A creditor sort code of 000000 is one every payment simulator
 ;; declines before settlement.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Payment Webhook Journey"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :funded-account
   :as :debtor
   :with {:bank-id [:ref :bank-0 :bank :bank-id]
          :token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}
  {:fixture :webhook-receiver :as :hook :with {:token [:ref :bank-0 :token]}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-webhook-journey-settles-001"}
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Invoice 123"}}
   :as :settling
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-webhook-journey-declined-001"}
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "00000000000001"
                    :creditor-name "Unreachable Creditor"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Invoice 124"}}
   :as :declined
   :assert {:status 201}}]
 :then
 [{:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "payment.outbound-completed"
           :resource-id [:ref :settling :payment-id]
           :idempotency-key [:m/regex "^ik-webhook-journey-settles-001"]}
   :secret [:ref :hook :registered :secret]}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "payment.outbound-failed"
           :resource-id [:ref :declined :payment-id]
           :idempotency-key [:m/regex "^ik-webhook-journey-declined-001"]}
   :secret [:ref :hook :registered :secret]}]}
