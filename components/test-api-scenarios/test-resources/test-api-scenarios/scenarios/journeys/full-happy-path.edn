{:name
 "Full happy path: two parties, two products, transfers, payment, interest"
 ;; End to end through the API:
 ;;
 ;;   - Customer bank (own-funds house account auto-created)
 ;;   - Two products: current (rate 0) and savings (rate 3650 bps)
 ;;   - Two person parties — Arthur and Ford — each with a current
 ;;     and a savings account
 ;;   - The bank's own-funds account funded with £50,000 from outside
 ;;     via the simulate endpoint (DEBIT 1100 cash-at-correspondent)
 ;;   - Each party rewarded £1,000 from the bank's own funds via an
 ;;     internal transfer (the bank pays customers from inside)
 ;;   - Arthur moves £750 current → savings
 ;;   - Ford moves £350 current → savings
 ;;   - Ford pays £25 outbound through the scheme path
 ;;   - Daily interest accrues on the savings products and is capitalised
 ;;
 ;; All amounts in pence. Balances asserted via the `:default`
 ;; / `:interest-payable` entries on GET /v1/cash-accounts/{id}/
 ;; balances; the `:m/embeds` matcher pins specific entries
 ;; without constraining what else is present.
 :given
 ;; --- Bank + party setup -------------------------------------------
 [{:fixture :bank :as :bank-0 :with {:name "Full Happy Path Customer"}}
  ;; Two products: current (0 bps) and savings (3650 bps)
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :product
   :as :savings-draft
   :with {:token [:ref :bank-0 :token]
          :name "Savings"
          :template-id "tpl.00000000000000000000000002"
          :interest-rate-bps 3650}}
  ;; Arthur Dent → :arthur (auto-activates via IDV chain)
  {:fixture :person
   :as :arthur
   :with {:token [:ref :bank-0 :token]
          :date-of-birth "1950-07-27"
          :national-insurance "TN555001A"}}
  ;; Ford Prefect → :ford
  {:fixture :person
   :as :ford
   :with {:token [:ref :bank-0 :token]
          :display-name "Ford Prefect"
          :given-name "Ford"
          :family-name "Prefect"
          :date-of-birth "1948-04-01"
          :national-insurance "TN555002B"}}
  ;; Customer accounts: arthur-current, arthur-savings, ford-current,
  ;; ford-savings — open and wait for "opened".
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :arthur :party :party-id]
                    :name "Arthur Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :arthur-current
   :assert {:status 201}}
  ;; Re-bind :arthur-current to the polled GET response so later
  ;; steps see the full record (including :bban, which the POST
  ;; response doesn't expose).
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "opened"}}
   :as :arthur-current}
  {:fixture :account
   :as :arthur-savings
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :savings-draft :product :product-id]
          :name "Arthur Savings"}}
  {:fixture :account
   :as :ford-current
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :ford :party :party-id]
          :product-id [:ref :current-draft :product :product-id]
          :name "Ford Current"}}
  {:fixture :account
   :as :ford-savings
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :ford :party :party-id]
          :product-id [:ref :savings-draft :product :product-id]
          :name "Ford Savings"}}
  ;; --- Money in ---------------------------------------------------
  ;; £50,000 from outside into the bank's own-funds house account
  ;; (DEBIT 1100 cash-at-correspondent / CREDIT the house account,
  ;; which rolls up into the 3100 own-funds control)
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 5000000
                    :currency "GBP"}}
   :assert {:status 200}}
  ;; £1,000 reward to each party's current account
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :bank-0 :bank :accounts 0 :account-id]
                    :creditor-account-id [:ref :arthur-current :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Reward Arthur"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :bank-0 :bank :accounts 0 :account-id]
                    :creditor-account-id [:ref :ford-current :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Reward Ford"}}
   :assert {:status 201}}]
 :when
 ;; --- Customer activity ------------------------------------------
 ;; Arthur: £750 current → savings
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :arthur-current :account-id]
                    :creditor-account-id [:ref :arthur-savings :account :account-id]
                    :currency "GBP"
                    :amount 75000
                    :reference "Arthur saves"}}
   :assert {:status 201}}
  ;; Ford: £350 current → savings
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :ford-current :account :account-id]
                    :creditor-account-id [:ref :ford-savings :account :account-id]
                    :currency "GBP"
                    :amount 35000
                    :reference "Ford saves"}}
   :assert {:status 201}}
  ;; Ford: £25 outbound to Arthur, settling the beer and nuts debt.
  ;; Arthur's BBAN is sort-code ++ account-number from the SCAN
  ;; payment address on his current account.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :ford-current :account :account-id]
                    :creditor-bban [:ref :arthur-current :bban]
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Beer and nuts"}}
   :assert {:status 201}}
  ;; Outbound is async (scheme command → provider → settled event).
  ;; Give the chain ~2s to settle before checking balances.
  ;;
  ;; --- Pre-interest balances --------------------------------------
  ;;   own-funds (house): 5_000_000 - 100_000 - 100_000 = 4_800_000
  ;;   Arthur cur          1_000_00 - 750_00 + 25_00   =    27_500
  ;;   Arthur sav                  + 750_00            =    75_000
  ;;   Ford   cur          1_000_00 - 350_00 - 25_00   =    62_500
  ;;   Ford   sav                  + 350_00            =    35_000
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank-0 :bank :accounts 0 :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 4800000 :currency "GBP"}}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 27500 :currency "GBP"}}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-savings :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 75000 :currency "GBP"}}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-current :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 62500 :currency "GBP"}}}}
  ;; The settled outbound reads as a posted debit on Ford's statement: the
  ;; submit reserved in pending-outgoing, and settlement cleared the
  ;; reservation and posted the real outflow. Phase is the leg's
  ;; balance-status, not a mutable transaction lifecycle.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :ford-current :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert
   {:status 200
    :body {:items [:m/embeds
                          [{:reference "Beer and nuts"
                            :transaction-type "outbound-transfer"
                            :side "debit"
                            :balance-status "posted"}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-savings :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 35000 :currency "GBP"}}}}
  ;; --- Interest run -----------------------------------------------
  ;; A forced run of the daily-interest job accrues a day's interest on
  ;; savings at 3650 bps, then capitalises it into each saver's
  ;; spendable default-posted balance:
  ;;   Arthur sav  75_000 → +75 → 75_075
  ;;   Ford   sav  35_000 → +35 → 35_035
  ;; The offset is the bank's 2400 interest-payable ledger account, so
  ;; the own-funds house account and the current accounts are
  ;; unchanged.
  {:command :api/request
   :request {:method :post
             :path "/v1/jobs/{job-id}/runs"
             :path-params {:job-id "daily-interest"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 201
            :body {:job-id "daily-interest"
                   :status "succeeded"
                   :tasks [{:label "accrue"
                            :status "succeeded"
                            :records-failed 0}
                           {:label "capitalize"
                            :status "succeeded"
                            :records-failed 0}]}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank-0 :bank :accounts 0 :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 4800000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-current :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 27500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :arthur-savings :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 75075 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-current :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 62500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :ford-savings :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 35035 :currency "GBP"}}}}]}
