{:name
 "An account stays on the terms it opened under after new ones are published"
 :runs-on {:payment :every}
 ;; What the account earns on those terms is the interest journeys',
 ;; which run the daily-interest job.
 :given [{:fixture :bank :as :bank-0 :with {:name "Original Terms Journey"}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :person
          :as :ford
          :with {:token [:ref :bank-0 :token]
                 :display-name "Ford Prefect"
                 :given-name "Ford"
                 :family-name "Prefect"
                 :national-insurance "TN000002A"}}
         {:fixture :product
          :as :v1
          :with {:token [:ref :bank-0 :token]
                 :name "Easy Saver"
                 :template-id "tpl.00000000000000000000000002"
                 :effective-from "2020-01-01"
                 :interest-rate-bps 500}}
         {:fixture :account
          :as :original
          :with {:token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :v1 :product :product-id]
                 :name "Easy Saver"}}]
 :when
 ;; Later, a lower rate is published.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product :product-id]}
             :auth [:ref :bank-0 :token]
             :body {:name "Easy Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 250
                    :effective-from "2024-01-01"}}
   :as :v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth [:ref :bank-0 :token]}
   :assert {:status 200}}
  {:fixture :account
   :as :newcomer
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :ford :party :party-id]
          :product-id [:ref :v1 :product :product-id]
          :name "Easy Saver"}}]
 :then
 ;; The original account reads its terms from v1, at v1's rate; the
 ;; newcomer's from v2.
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :original :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :as :original-read
   :assert {:status 200 :body {:version-id [:ref :v1 :product :version-id]}}}
  {:command :api/request
   :request {:method :get
             :path
             "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :v1 :product :product-id]
                           :version-id [:ref :original-read :version-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "published" :interest-rate-bps 500}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :newcomer :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :as :newcomer-read
   :assert {:status 200 :body {:version-id [:ref :v2 :version-id]}}}
  {:command :api/request
   :request {:method :get
             :path
             "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :v1 :product :product-id]
                           :version-id [:ref :newcomer-read :version-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "published" :interest-rate-bps 250}}}]}
