{:name
 "The customer's system publishes new terms, and only new accounts take them"
 :runs-on {:payment :every}
 :given [{:fixture :bank :as :bank-0 :with {:name "Product Terms Journey"}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :person
          :as :ford
          :with {:token [:ref :bank-0 :token]
                 :display-name "Ford Prefect"
                 :legal-name "Ford Prefect"}}
         {:fixture :product
          :as :v1
          :with {:token [:ref :bank-0 :token]
                 :name "Easy Saver"
                 :template-id "tpl.00000000000000000000000002"
                 :effective-from "2020-01-01"
                 :interest-rate-bps 150}}
         {:fixture :account
          :as :earlier
          :with {:token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :v1 :product :product-id]
                 :name "Easy Saver"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product :product-id]}
             :auth [:ref :bank-0 :token]
             :body {:name "Easy Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2024-01-01"}}
   :as :v2
   :assert {:status 201
            :body {:product-id [:ref :v1 :product :product-id]
                   :version-id [:m/mismatch [:ref :v1 :product :version-id]]
                   :version-number 2
                   :status "draft"}}}
  {:command :api/request
   :request {:method :put
             :path
             "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :v1 :product :product-id]
                           :version-id [:ref :v2 :version-id]}
             :auth [:ref :bank-0 :token]
             :body {:name "Easy Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 125
                    :effective-from "2024-01-01"}}
   :assert {:status 200 :body {:interest-rate-bps 125}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "published"}}}
  {:fixture :account
   :as :later
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :ford :party :party-id]
          :product-id [:ref :v1 :product :product-id]
          :name "Easy Saver"}}]
 :then
 ;; The account opened on v1 stays on it; the new one opens on v2.
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :earlier :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:version-id [:ref :v1 :product :version-id]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :later :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:version-id [:ref :v2 :version-id]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-products/{product-id}"
             :path-params {:product-id [:ref :v1 :product :product-id]}
             :auth [:ref :bank-0 :token]}
   :assert
   {:status 200
    :body
    {:versions [:m/in-any-order
                [{:version-id [:ref :v1 :product :version-id]
                  :status "published"
                  :interest-rate-bps 150}
                 {:version-id [:ref :v2 :version-id]
                  :status "published"
                  :interest-rate-bps 125}]]}}}]}
