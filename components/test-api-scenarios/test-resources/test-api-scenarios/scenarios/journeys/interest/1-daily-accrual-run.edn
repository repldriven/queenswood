{:name "The daily run pays a penny or more, and carries what falls short"
 :runs-on {:payment :every}
 ;; 3650 bps is a hundredth of the balance a day: £1,000 earns 100p, and
 ;; 50p earns half a hundredth of a penny, which only advances the carry.
 :given [{:fixture :bank :as :bank-0 :with {:name "Daily Accrual Journey"}}
         {:fixture :product
          :as :saver
          :with {:token [:ref :bank-0 :token]
                 :name "Easy Saver"
                 :template-id "tpl.00000000000000000000000002"
                 :effective-from "2020-01-01"
                 :interest-rate-bps 3650}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :funded-account
          :as :earning
          :with {:bank-id [:ref :bank-0 :bank :bank-id]
                 :token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :saver :product :product-id]
                 :name "Easy Saver"
                 :amount 100000}}
         {:fixture :funded-account
          :as :carrying
          :with {:bank-id [:ref :bank-0 :bank :bank-id]
                 :token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :saver :product :product-id]
                 :name "Easy Saver"
                 :amount 50}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/jobs/{job-id}/runs"
             :path-params {:job-id "daily-interest"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 201
            :body
            {:job-id "daily-interest"
             :trigger-source "forced"
             :status "completed"
             :tasks
             [{:label "accrue" :status "completed" :failed-count 0}
              {:label "capitalize" :status "completed" :failed-count 0}]}}}
  ;; The run is daily, so a second one today is refused rather than
  ;; paid twice.
  {:command :api/request
   :request {:method :post
             :path "/v1/jobs/{job-id}/runs"
             :path-params {:job-id "daily-interest"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 409
            :problem {:type ":scheduler/period-already-run"
                      :detail "The job has already run this period"}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :earning :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100100 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :carrying :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 50 :currency "GBP"}}}}]}
