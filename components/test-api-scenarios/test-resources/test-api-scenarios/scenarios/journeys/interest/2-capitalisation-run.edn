{:name "Capitalisation pays the accrued interest and squares the bank's books"
 :runs-on {:payment :every}
 ;; The seeded daily-interest job capitalises straight after it accrues,
 ;; so the operator's cadence is daily.
 :given [{:fixture :bank :as :bank-0 :with {:name "Capitalisation Journey"}}
         {:fixture :product
          :as :saver
          :with {:token [:ref :bank-0 :token]
                 :name "Easy Saver"
                 :template-id "tpl.00000000000000000000000002"
                 :effective-from "2020-01-01"
                 :interest-rate-bps 3650}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :funded-account
          :as :saving
          :with {:bank-id [:ref :bank-0 :bank :bank-id]
                 :token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :saver :product :product-id]
                 :name "Easy Saver"
                 :amount 100000}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/jobs/{job-id}/runs"
             :path-params {:job-id "daily-interest"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 201
            :body {:status "completed"
                   :tasks [{:label "accrue" :status "completed"}
                           {:label "capitalize"
                            :status "completed"
                            :failed-count 0}]}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :saving :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :until
   {:status 200
    :body {:items [:m/embeds
                   [{:transaction-type "interest-capitalization"
                     :side "credit"
                     :balance-status "posted"}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :saving :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 100100 :currency "GBP"}}}}
  ;; Interest payable is back to nothing once the run has paid what it
  ;; accrued, and the expense holds the day's interest as a debit.
  {:command :api/request
   :request
   {:method :get :path "/v1/ledger-accounts" :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body
            {:items
             [:m/embeds
              [{:code "2400" :posted-balance {:value 0 :currency "GBP"}}
               {:code "5100" :posted-balance {:value -100 :currency "GBP"}}]]
             :trial-balance [:m/embeds [{:currency "GBP"}]]}}}]}
