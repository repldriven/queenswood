{:name "The operator creates a bank in one call, ready for its customer"
 :runs-on {:payment :every}
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Onboarding Journey Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["EUR" "GBP" "USD"]
                    :owner-email "onboarding-owner@queenswood.local"}}
   :as :bank
   :assert
   {:status 201
    :body
    {:bank-id [:m/regex "^bnk\\."]
     :name "Onboarding Journey Bank"
     :status "live"
     :tier "micro"
     :client-id [:m/regex "^bnk\\."]
     :client-secret [:m/non-empty]
     :party {:party-id [:m/regex "^pty\\."]
             :party-type "organization"
             :display-name "Onboarding Journey Bank"}
     ;; One own-funds account per currency, held by the bank's own party.
     :accounts [:m/in-any-order
                [{:currency "EUR"
                  :name "Bank own funds"
                  :product-type "own-funds"
                  :party-id [:ref :bank :party :party-id]
                  :balances [:m/non-empty]}
                 {:currency "GBP"
                  :name "Bank own funds"
                  :product-type "own-funds"
                  :party-id [:ref :bank :party :party-id]
                  :balances [:m/non-empty]}
                 {:currency "USD"
                  :name "Bank own funds"
                  :product-type "own-funds"
                  :party-id [:ref :bank :party :party-id]
                  :balances [:m/non-empty]}]]
     :owner-invitation {:email "onboarding-owner@queenswood.local"
                        :role "owner"
                        :status "pending"}}}}
  ;; The operator hands the credential over, and the customer's system
  ;; exchanges it for a token.
  {:command :auth/mint-token
   :for {:client-id [:ref :bank :client-id]
         :client-secret [:ref :bank :client-secret]
         :status :live}
   :as :bank-token}]
 :then
 [{:command :api/poll
   :request {:method :get :path "/v1/cash-accounts" :auth :bank-token}
   :until {:status 200
           :body {:items [:m/in-any-order
                          [{:currency "EUR" :account-status "opened"}
                           {:currency "GBP" :account-status "opened"}
                           {:currency "USD" :account-status "opened"}]]}}}
  {:command :api/request
   :request {:method :get :path "/v1/bank/policies" :auth :bank-token}
   :assert {:status 200
            :body {:items [:m/embeds [{:name "Micro tier policy"}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200
            :body {:items [{:email "onboarding-owner@queenswood.local"
                            :role "owner"
                            :status "pending"}]}}}]}
