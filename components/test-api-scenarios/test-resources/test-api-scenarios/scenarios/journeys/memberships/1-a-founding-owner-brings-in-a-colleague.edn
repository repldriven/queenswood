{:name
 "A founding owner creates a bank and brings in a colleague as a developer"
 :given [{:command :auth/mint-user-token
          :realm :queenswood
          :client-id "queenswood-console"
          :username "member"
          :password "member"
          :as :founder-token}
         {:command :auth/mint-user-token
          :realm :queenswood
          :client-id "queenswood-console"
          :username "founder-colleague"
          :password "founder-colleague"
          :as :colleague-token}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/me/memberships" :auth :founder-token}
   :assert {:status 200 :body {:items []}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :founder-token
             :body {:company-number "SC299784" :name "Cyberdyne Systems"}}
   :as :bank
   :assert {:status 201
            :headers {:location "/v1/bank"}
            :body {:name "Cyberdyne Systems"
                   :client-id [:m/regex "^bnk\\."]
                   :client-secret [:m/non-empty]
                   :membership {:role "owner"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :founder-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "founder-colleague@queenswood.local"
                    :role "developer"}}
   :as :invitation
   :assert {:status 201 :body {:role "developer" :status "pending"}}}
  {:command :mail/await-invitation
   :to "founder-colleague@queenswood.local"
   :invitation-id [:ref :invitation :invitation-id]
   :as :email}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :email :invitation-id]}
             :auth :colleague-token
             :headers {:invitation-token [:ref :email :token]}}
   :as :colleague-membership
   :assert {:status 201
            :body {:bank-id [:ref :bank :bank-id]
                   :bank-name "Cyberdyne Systems"
                   :role "developer"}}}
  ;; A developer works with the bank's money but not its people.
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :colleague-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "founder-guest@example.test" :role "viewer"}}
   :assert {:status 403
            :problem {:type "auth/forbidden"
                      :detail "Insufficient privileges"}}}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/me/memberships" :auth :colleague-token}
   :assert {:status 200
            :body {:items
                   [{:bank-id [:ref :bank :bank-id] :role "developer"}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :colleague-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/memberships"
             :auth :founder-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert
   {:status 200
    :body
    {:items [:m/in-any-order
             [{:email "member@queenswood.local"
               :role "owner"
               :created-organisation true}
              {:membership-id [:ref :colleague-membership
                               :membership-id]
               :email "founder-colleague@queenswood.local"
               :role "developer"}]]}}}]}
