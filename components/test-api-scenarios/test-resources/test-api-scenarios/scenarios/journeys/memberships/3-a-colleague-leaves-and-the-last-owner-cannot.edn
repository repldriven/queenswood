{:name "An owner removes a departed developer, then leaves once an admin owns"
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "last-owner"
   :password "last-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "last-admin"
   :password "last-admin"
   :as :admin-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "last-developer"
   :password "last-developer"
   :as :developer-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Last Owner Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "last-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation
                                           :invitation-id]}
             :auth :owner-token}
   :as :owner-membership
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "last-admin@queenswood.local" :role "admin"}}
   :as :admin-invitation
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :admin-invitation
                                           :invitation-id]}
             :auth :admin-token}
   :as :admin-membership
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "last-developer@queenswood.local" :role "developer"}}
   :as :developer-invitation
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :developer-invitation
                                           :invitation-id]}
             :auth :developer-token}
   :as :developer-membership
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/memberships/{membership-id}/remove"
             :path-params {:membership-id [:ref :developer-membership
                                           :membership-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:reason "Left the company"}}
   :assert {:status 204}}
  ;; The developer's token outlives the removal, and is refused at once.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 403
            :problem {:type "auth/forbidden"
                      :detail "The caller is not a member of this bank"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/memberships/{membership-id}/leave"
             :path-params {:membership-id [:ref :owner-membership
                                           :membership-id]}
             :auth :owner-token}
   :assert {:status 409
            :problem {:type ":membership/last-owner"
                      :detail "Make someone else an owner first"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/memberships/{membership-id}/change-role"
             :path-params {:membership-id [:ref :admin-membership
                                           :membership-id]}
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:role "owner" :reason "Taking over the bank"}}
   :assert {:status 200
            :body {:membership-id [:ref :admin-membership :membership-id]
                   :role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/memberships/{membership-id}/leave"
             :path-params {:membership-id [:ref :owner-membership
                                           :membership-id]}
             :auth :owner-token}
   :assert {:status 204}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/memberships/{membership-id}/leave"
             :path-params {:membership-id [:ref :owner-membership
                                           :membership-id]}
             :auth :owner-token}
   :assert {:status 409 :problem {:type ":membership/invalid-status"}}}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/me/memberships" :auth :owner-token}
   :assert {:status 200 :body {:items []}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/memberships"
             :auth :admin-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert
   {:status 200
    :body {:items [{:membership-id [:ref :admin-membership
                                    :membership-id]
                    :role "owner"}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :admin-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :query-params {"page[size]" 3}}
   :assert
   {:status 200
    :body
    {:items
     [{:kind "member-left"
       :actor {:kind "member" :principal-id [:ref :owner-membership :user-id]}
       :membership-id [:ref :owner-membership
                       :membership-id]
       :role-before "owner"}
      {:kind "role-changed"
       :subject-user-id [:ref :admin-membership :user-id]
       :role-before "admin"
       :role-after "owner"
       :reason "Taking over the bank"}
      {:kind "member-removed"
       :actor {:kind "member" :principal-id [:ref :owner-membership :user-id]}
       :subject-user-id [:ref :developer-membership
                         :user-id]
       :role-before "developer"
       :reason "Left the company"
       :occurred-at [:m/non-empty]}]}}}]}
