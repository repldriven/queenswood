{:name
 "An operator creates a bank naming its owner, who accepts on first sign-in"
 :given [{:command :auth/mint-user-token
          :realm :queenswood
          :client-id "queenswood-console"
          :username "handover-owner"
          :password "handover-owner"
          :as :owner-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Handover Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "handover-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201
            :body {:client-id [:m/regex "^bnk\\."]
                   :client-secret [:m/non-empty]
                   :member [:m/absent]
                   :owner-invitation {:bank-id [:ref :bank :bank-id]
                                      :email "handover-owner@queenswood.local"
                                      :role "owner"
                                      :status "pending"
                                      :invited-by {:kind "operator"
                                                   :principal-id
                                                   "queenswood-admin"}
                                      :token [:m/absent]}}}}
  {:command :mail/await-invitation
   :to "handover-owner@queenswood.local"
   :invitation-id [:ref :bank :owner-invitation :invitation-id]
   :as :email}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :email :invitation-id]}
             :auth :owner-token
             :headers {:invitation-token [:ref :email :token]}}
   :as :owner-member
   :assert {:status 201
            :body {:bank-id [:ref :bank :bank-id]
                   :bank-name "Handover Bank"
                   :role "owner"}}}
  ;; The owner can now invite the rest of the team.
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "handover-colleague@example.test" :role "admin"}}
   :as :invitation
   :assert {:status 201 :body {:role "admin" :status "pending"}}}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/me/members" :auth :owner-token}
   :assert
   {:status 200
    :body {:items [{:member-id [:ref :owner-member
                                    :member-id]
                    :bank-id [:ref :bank :bank-id]
                    :role "owner"}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/members"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert
   {:status 200
    :body {:items [{:member-id [:ref :owner-member
                                    :member-id]
                    :email "handover-owner@queenswood.local"
                    :role "owner"
                    :created-organisation false
                    :invited-by {:kind "operator"
                                 :principal-id "queenswood-admin"}}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert
   {:status 200
    :body
    {:items
     [{:kind "invitation-created"
       :actor {:kind "member" :principal-id [:ref :owner-member :user-id]}
       :role-after "admin"}
      {:kind "invitation-accepted"
       :actor {:kind "member" :principal-id [:ref :owner-member :user-id]}
       :role-after "owner"}
      {:kind "invitation-created"
       :actor {:kind "operator" :principal-id "queenswood-admin"}
       :email "handover-owner@queenswood.local"
       :role-after "owner"}
      {:kind "bank-created"
       :actor {:kind "operator" :principal-id "queenswood-admin"}}]}}}]}
