{:name "The operator grants a new owner, who removes the departed one"
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "gone-owner"
   :password "gone-owner"
   :as :departed-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "gone-successor"
   :password "gone-successor"
   :as :successor-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Gone Owner Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "gone-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation
                                           :invitation-id]}
             :auth :departed-token}
   :as :departed-member
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "gone-successor@queenswood.local"
                    :role "owner"
                    :reason "The only owner has left; verified by phone"}}
   :as :invitation
   :assert {:status 201
            :body {:role "owner"
                   :invited-by {:kind "operator"
                                :principal-id "queenswood-admin"
                                :name "Queenswood"}}}}
  {:command :mail/await-invitation
   :to "gone-successor@queenswood.local"
   :invitation-id [:ref :invitation :invitation-id]
   :as :email}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :email :invitation-id]}
             :auth :successor-token
             :headers {:invitation-token [:ref :email :token]}}
   :as :successor-member
   :assert {:status 201 :body {:role "owner"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/members/{member-id}/remove"
             :path-params {:member-id [:ref :departed-member
                                           :member-id]}
             :auth :successor-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:reason "Left the company"}}
   :assert {:status 204}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/members"
             :auth :successor-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert
   {:status 200
    :body {:items [{:member-id [:ref :successor-member
                                    :member-id]
                    :role "owner"
                    :invited-by {:kind "operator"
                                 :principal-id "queenswood-admin"
                                 :name "Queenswood"}}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :successor-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :query-params {"page[size]" 3}}
   :assert
   {:status 200
    :body
    {:items [{:kind "member-removed"
              :actor {:kind "member"
                      :principal-id [:ref :successor-member
                                     :user-id]}
              :subject-user-id [:ref :departed-member :user-id]
              :role-before "owner"
              :reason "Left the company"}
             {:kind "invitation-accepted"
              :actor {:kind "member"
                      :principal-id [:ref :successor-member
                                     :user-id]}}
             {:kind "invitation-created"
              :actor {:kind "operator"
                      :principal-id "queenswood-admin"
                      :name "Queenswood"}
              :email "gone-successor@queenswood.local"
              :role-after "owner"
              :reason "The only owner has left; verified by phone"}]}}}
  {:command :api/request
   :request {:method :get :path "/v1/me/members" :auth :departed-token}
   :assert {:status 200 :body {:items []}}}]}
