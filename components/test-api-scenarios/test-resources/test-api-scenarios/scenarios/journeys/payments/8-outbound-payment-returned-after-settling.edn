{:name "A settled payment the beneficiary's bank sends back is returned"
 :runs-on {:payment :every}
 :requires #{:outbound-returned}
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Outbound Returned Journey"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :funded-account
   :as :debtor
   :with {:bank-id [:ref :bank-0 :bank :bank-id]
          :token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}
  {:fixture :webhook-receiver :as :hook :with {:token [:ref :bank-0 :token]}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Marvin"
                    :currency "GBP"
                    :amount 4200
                    :scheme "fps"
                    :reference "Sent back"}}
   :as :payment
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:payment-status "completed"}}}
  ;; The beneficiary's bank cannot apply it.
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/outbound-return"
             :body {:end-to-end-id [:ref :payment :payment-id]
                    :reason-code "AC01"}}
   :assert {:status 202}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-status "returned" :return {:reason-code "AC01"}}}}
  ;; The amount is credited back.
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:posted-balance {:value 100000 :currency "GBP"}
                  :available-balance {:value 100000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :debtor :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert
   {:status 200
    :body {:items [:m/embeds
                   [{:reference "Sent back"
                     :transaction-type "outbound-return"
                     :side "credit"
                     :amount 4200}]]}}}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "payment.outbound-returned"
           :resource-id [:ref :payment :payment-id]}
   :secret [:ref :hook :registered :secret]
   :as :notified}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :as :read
   :assert {:status 200}}
  {:command :assert/equals
   :actual [:ref :notified 0 :body :data]
   :expected [:ref :read]}]}
