{:name "A submission retried after a lost reply makes one payment"
 :runs-on {:payment :every}
 :given [{:fixture :bank :as :bank-0 :with {:name "Idempotent Retry Journey"}}
         {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :funded-account
          :as :debtor
          :with {:bank-id [:ref :bank-0 :bank :bank-id]
                 :token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :current :product :product-id]}}]
 :when
 ;; The reply to the first submission never arrives.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-outbound-journey"}
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "Retried"}}
   :assert {:status 500}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-outbound-journey"}
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "Retried"}}
   :as :payment
   :assert {:status 201}}
  ;; A third send under the key is answered with the same payment.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-outbound-journey"}
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "Retried"}}
   :assert {:status 201
            :headers {:idempotent-replayed "true"}
            :body {:payment-id [:ref :payment :payment-id]}}}]
 :then
 ;; The customer is debited once.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "completed"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :opened :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:posted-balance {:value 97500 :currency "GBP"}
                  :available-balance {:value 97500 :currency "GBP"}}}}]}
