{:name "A Faster Payment arrives and the customer engineer sees it"
 :runs-on {:payment :every}
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Inbound Payment Journey"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}
  {:fixture :webhook-receiver :as :hook :with {:token [:ref :bank-0 :token]}}]
 :when
 ;; The payer's bank sends a Faster Payment to the account's address.
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 25
                    :currency "GBP"
                    :reference "Rent"
                    :debtor-name "Ford Prefect"}}
   :as :inbound
   :assert {:status 202}}]
 :then
 ;; No action from the tenant: the account is credited and the payment
 ;; is there to read.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 2500 :currency "GBP"}}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "settled"}
             :auth [:ref :bank-0 :token]}
   :until
   {:status 200
    :body {:items [{:end-to-end-id [:ref :inbound :endToEndIdentification]
                    :creditor-account-id [:ref :creditor :account :account-id]
                    :amount 2500
                    :reference "Rent"
                    :payment-status "settled"}]}}
   :as :settled}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "payment.inbound-settled"
           :resource-id [:ref :settled :items 0 :payment-id]}
   :secret [:ref :hook :registered :secret]
   :as :notified}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound/{payment-id}"
             :path-params {:payment-id [:ref :settled :items 0 :payment-id]}
             :auth [:ref :bank-0 :token]}
   :as :read
   :assert {:status 200}}
  {:command :assert/equals
   :actual [:ref :notified 0 :body :data]
   :expected [:ref :read]}]}
