{:name "A customer engineer checks the payee's name, then sends"
 :runs-on {:payment :every}
 :given [{:fixture :bank :as :bank-0 :with {:name "Payee Check Journey"}}
         {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :funded-account
          :as :debtor
          :with {:bank-id [:ref :bank-0 :bank :bank-id]
                 :token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :current :product :product-id]}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payee-checks"
             :auth [:ref :bank-0 :token]
             :body {:creditor-name "Arthur Dent"
                    :account {:sort-code "040062" :account-number "12345678"}
                    :account-type "personal"
                    :account-id [:ref :debtor :opened :account :account-id]}}
   :assert {:status 201 :body {:result {:match-result "match"}}}}
  ;; The names agree, so the tenant sends.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :opened :account
                                        :account-id]
                    :creditor-bban "04006212345678"
                    :creditor-name "Arthur Dent"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Checked"}}
   :as :payment
   :assert {:status 201}}]
 :then [{:command :api/poll
         :request {:method :get
                   :path "/v1/payments/outbound/{payment-id}"
                   :path-params {:payment-id [:ref :payment :payment-id]}
                   :auth [:ref :bank-0 :token]}
         :until {:status 200 :body {:payment-status "completed"}}}]}
