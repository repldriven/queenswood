{:name "Tenant lists their payee checks"
 :tags #{:api :happy :payee-checks}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-list-checks-bank-001"}
             :body {:name "Payee Check List Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/payee-checks"
             :auth :org-0-token
             :headers {:idempotency-key "ik-list-checks-chk-001"}
             :body {:creditor-name "Arthur Dent"
                    :account {:sort-code "040062" :account-number "12345678"}
                    :account-type "personal"}}
   :as :check-0
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/payee-checks" :auth :org-0-token}
   :assert
   {:status 200
    :body {:items [{:check-id [:ref :check-0 :check-id]
                    :result {:match-result "match"}}]}}}]}
