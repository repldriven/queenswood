{:name "Tenant lists their payee checks"
 :runs-on {:payment :every}
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Payee Check List Org" :status "live"}}
  ;; A check is made from the bank's own funds, so it waits for the
  ;; provider to open them.
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:items [:m/embeds [{:account-status "opened"}]]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payee-checks"
             :auth [:ref :org-0 :token]
             :body {:creditor-name "Arthur Dent"
                    :account {:sort-code "040062" :account-number "12345678"}
                    :account-type "personal"}}
   :as :check-0
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/payee-checks" :auth [:ref :org-0 :token]}
   :assert
   {:status 200
    :body {:items [{:check-id [:ref :check-0 :check-id]
                    :result {:match-result "match"}}]}}}]}
