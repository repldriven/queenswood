{:name "Tenant runs a payee check and the name is a match"
 :tags #{:api :happy :payee-checks}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-payee-check-match-bank-001"}
             :body {:name "Payee Check Match Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payee-checks"
             :auth :org-0-token
             :headers {:idempotency-key "ik-payee-check-match-chk-001"}
             :body {:creditor-name "Arthur Dent"
                    :account {:sort-code "040062" :account-number "12345678"}
                    :account-type "personal"}}
   :assert {:status 201
            :body {:check-id [:m/regex "^chk\\."]
                   :result {:match-result "match"}}}}]}
