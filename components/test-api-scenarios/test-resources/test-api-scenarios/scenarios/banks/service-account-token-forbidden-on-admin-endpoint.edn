{:name
 "Service-account JWT is rejected by the admin-only bank creation endpoint"
 :given
 [{:fixture :bank :as :bank-0 :with {:name "First Bank" :status "live"}}]
 :when
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth [:ref :bank-0 :token]
    :body
    {:name "Second Bank" :status "live" :tier "micro" :currencies ["GBP"]}}
   :assert {:status 403}}]}
