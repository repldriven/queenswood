{:name "Admin changes a bank's status from test to live"
 :tags #{:api :banks :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-change-status-happy-bank-001"}
             :body {:name "Status Change Test Org"
                    :status "test"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201 :body {:status "test"}}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/banks/{bank-id}/change-status"
                   :path-params {:bank-id [:ref :bank-0 :bank-id]}
                   :auth :admin
                   :body {:status "live"}}
         :assert {:status 200
                  :body {:bank-id [:ref :bank-0 :bank-id] :status "live"}}}]}
