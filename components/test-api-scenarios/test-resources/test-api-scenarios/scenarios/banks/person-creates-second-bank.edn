{:name "A person who owns one bank creates a second and holds both"
 ;; WEYLAND-YUTANI CORP LTD is `active` in the Companies House
 ;; simulator's examples, so only the person's existing membership could
 ;; refuse the create.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "second-org-person"
   :password "second-org-person"
   :as :person-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "First Org Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "second-org-person@queenswood.local"}}
   :as :first-bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :first-bank :owner-invitation
                                           :invitation-id]}
             :auth :person-token}
   :as :first-membership
   :assert {:status 201}}
  {:command :api/request
   :request {:method :get :path "/v1/me/memberships" :auth :person-token}
   :assert {:status 200}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/banks"
                   :auth :person-token
                   :body {:company-number "WY002122"
                          :name "Weyland-Yutani Bank"}}
         :as :onboarded
         :assert {:status 201 :body {:membership {:role "owner"}}}}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/me/memberships" :auth :person-token}
   :assert
   {:status 200
    :body
    {:items [:m/in-any-order
             [{:membership-id [:ref :first-membership
                               :membership-id]
               :bank-id [:ref :first-bank :bank-id]
               :bank-name "First Org Bank"
               :role "owner"}
              {:bank-id [:ref :onboarded :bank-id]
               :bank-name "Weyland-Yutani Bank"
               :role "owner"}]]}}}]}
