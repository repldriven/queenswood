{:name "Each bank gets its own fountain-allocated sort code"
 :tags #{:api :banks}
 ;; Banks are allocated a unique 6-digit sort code from a fountain at
 ;; creation (000001, 000002, ...). Two banks both creating successfully
 ;; proves distinctness — the Bank_by_sort_code index is unique, so a
 ;; collision would fail the second create. An opened account's BBAN
 ;; carries its bank's sort code (the first six digits).
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-sort-code-fountain-bank-001"}
             :body {:name "Sort Code Fountain A"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-a
   :assert {:status 201 :body {:sort-code [:m/regex "^[0-9]{6}$"]}}}
  ;; A second bank must also succeed — distinct sort code (unique index).
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-sort-code-fountain-bank-002"}
             :body {:name "Sort Code Fountain B"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :assert {:status 201 :body {:sort-code [:m/regex "^[0-9]{6}$"]}}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-a :client-id]
         :client-secret [:ref :bank-a :client-secret]
         :status :live}
   :as :bank-a-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-sort-code-fountain-prod-001"}
             :body {:name "Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :current-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :current-draft :product-id]
                  :version-id [:ref :current-draft :version-id]}
    :auth :bank-a-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-scf-create-party"}
             :body {:type "person"
                    :display-name "Slartibartfast Magrathea"
                    :given-name "Slartibartfast"
                    :family-name "Magrathea"
                    :date-of-birth "1947-05-19"
                    :nationality "GB"
                    :address {:building-number "1"
                              :street "Fjord Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN555200E"
                                          :issuing-country "GB"}}}
   :as :party
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party :party-id]}
             :auth :bank-a-token}
   :until {:status 200 :body {:status "active"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-scf-open-account"}
             :body {:party-id [:ref :party :party-id]
                    :name "Slartibartfast Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :account
   :assert {:status 200 :body {:account-status "opening"}}}]
 :then
 ;; The opened account's SCAN address carries bank A's sort code.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account :account-id]}
             :auth :bank-a-token}
   :until {:status 200
           :body {:account-status "opened"
                  :payment-addresses
                  [:m/embeds
                   [{:scan {:sort-code [:ref :bank-a :sort-code]}}]]}}}]}
