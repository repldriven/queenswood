{:name "Creating a bank with an owner twice under one key replays the invitation"
 :tags #{:api :banks :access :idempotency :happy}
 ;; The replay carries the bank, its client secret and the owner
 ;; invitation. Neither answer carries a token, which only the owner's
 ;; invitation email does.
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key
                       "ik-banks-create-bank-replay-owner-email-001"}
             :body {:name "Replayed Owner Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "replayed-owner@example.test"}}
   :as :bank-0
   :assert {:status 201
            :headers {:idempotent-replayed [:m/absent]}
            :body {:client-secret [:m/non-empty]
                   :owner-invitation {:invitation-id [:m/regex "^inv\\."]
                                      :token [:m/absent]}}}}]
 :then
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key
                       "ik-banks-create-bank-replay-owner-email-001"}
             :body {:name "Replayed Owner Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "replayed-owner@example.test"}}
   :assert {:status 201
            :headers {:idempotent-replayed "true"}
            :body {:bank-id [:ref :bank-0 :bank-id]
                   :client-secret [:ref :bank-0 :client-secret]
                   :owner-invitation
                   {:invitation-id [:ref :bank-0 :owner-invitation :invitation-id]
                    :email "replayed-owner@example.test"
                    :role "owner"
                    :token [:m/absent]}}}}]}
