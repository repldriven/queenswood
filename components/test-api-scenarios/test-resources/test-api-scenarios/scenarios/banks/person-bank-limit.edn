{:name "A person's fourth bank is refused by the micro tier's limit"
 ;; WEYLAND-YUTANI CORP LTD is `active` in the Companies House
 ;; simulator's examples, and one company may stand behind several banks,
 ;; so only the number of banks the person has created could refuse the
 ;; fourth. A bank an operator creates and hands to the person is the
 ;; operator's, and counts for nothing.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "bank-limit-person"
   :password "bank-limit-person"
   :as :person-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Bank Limit Operator Bank"
                    :status "test"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "bank-limit-person@queenswood.local"}}
   :as :operator-bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :operator-bank :owner-invitation
                                           :invitation-id]}
             :auth :person-token}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :person-token
             :body {:company-number "WY002122" :name "Bank Limit First"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :person-token
             :body {:company-number "WY002122" :name "Bank Limit Second"}}
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :person-token
             :body {:company-number "WY002122" :name "Bank Limit Third"}}
   :assert {:status 201 :body {:tier "micro" :member {:role "owner"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :person-token
             :body {:company-number "WY002122" :name "Bank Limit Fourth"}}
   :assert {:status 429
            :problem {:type ":policy/limit-exceeded"
                      :detail
                      "Micro tier - a person may create at most 3 banks"}}}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/me/members" :auth :person-token}
   :assert {:status 200
            :body {:items [:m/in-any-order
                           [{:bank-name "Bank Limit Operator Bank"
                             :role "owner"}
                            {:bank-name "Bank Limit First" :role "owner"}
                            {:bank-name "Bank Limit Second" :role "owner"}
                            {:bank-name "Bank Limit Third" :role "owner"}]]}}}]}
