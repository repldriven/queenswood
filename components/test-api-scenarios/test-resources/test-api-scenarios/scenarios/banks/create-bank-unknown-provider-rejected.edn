{:name "A create naming a provider or a kind the installation does not offer is refused"
 :tags #{:api :banks :unhappy}
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-bank-unknown-provider-001"}
             :body {:name "Unknown Provider Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :providers {:payment "no-such-provider"}}}
   :assert {:status 422 :body {:type ":bank/unknown-provider"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-bank-unknown-provider-002"}
             :body {:name "Unknown Kind Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :providers {:no-such-kind "modulr"}}}
   :assert {:status 422 :body {:type ":bank/unknown-provider"}}}]}
