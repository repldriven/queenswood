{:name "Changing a bank to its current status is rejected"
 :given [{:fixture :bank
          :as :bank-0
          :with {:name "Same Status Test Org" :status "live"}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/bank/change-status"
                   :auth :admin
                   :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
                   :body {:status "live"}}
         :assert {:status 409 :body {:type ":bank/invalid-status"}}}]}
