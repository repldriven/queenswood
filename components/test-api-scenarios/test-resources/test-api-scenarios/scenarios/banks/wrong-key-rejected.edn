{:name "Wrong bearer token is rejected"
 :tags #{:api :auth :banks :unhappy}
 :when
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth "wrong-key"
    :headers {:idempotency-key "ik-wrong-key-rejected-bank-001"}
    :body
    {:name "Bad Key Bank" :status "live" :tier "micro" :currencies ["GBP"]}}
   :assert {:status 401}}]}
