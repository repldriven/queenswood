{:name "Admin changes a bank's tier"
 :tags #{:api :banks :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-change-tier-happy-bank-001"}
             :body {:name "Tier Change Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201 :body {:tier "micro"}}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/banks/{bank-id}/change-tier"
                   :path-params {:bank-id [:ref :bank-0 :bank-id]}
                   :auth :admin
                   :body {:tier "test-scenario"}}
         :assert {:status 200
                  :body
                  {:bank-id [:ref :bank-0 :bank-id] :tier "test-scenario"}}}]}
