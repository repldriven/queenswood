{:name "Changing a bank to an unknown tier is rejected"
 :tags #{:api :banks :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-change-tier-unknown-tier-bank-001"}
             :body {:name "Unknown Tier Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/banks/{bank-id}/change-tier"
                   :path-params {:bank-id [:ref :bank-0 :bank-id]}
                   :auth :admin
                   :body {:tier "no-such-tier"}}
         :assert {:status 422 :body {:type ":bank/unknown-tier"}}}]}
