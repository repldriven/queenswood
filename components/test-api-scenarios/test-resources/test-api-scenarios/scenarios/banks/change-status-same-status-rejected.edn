{:name "Changing a bank to its current status is rejected"
 :tags #{:api :banks :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-change-status-same-status-bank-001"}
             :body {:name "Same Status Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/banks/{bank-id}/change-status"
                   :path-params {:bank-id [:ref :bank-0 :bank-id]}
                   :auth :admin
                   :body {:status "live"}}
         :assert {:status 409 :body {:type ":bank/invalid-status"}}}]}
