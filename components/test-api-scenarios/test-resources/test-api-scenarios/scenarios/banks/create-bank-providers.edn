{:name
 "A bank runs on the providers its create names, the default of each other kind"
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Provider Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :providers {:payment "modulr" :idv "zyphe"}}}
   :as :named
   :assert {:status 201 :body {:providers {:payment "modulr" :idv "zyphe"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Default Provider Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :defaulted
   :assert {:status 201 :body {:providers {:payment "modulr" :idv "zyphe"}}}}]
 :then [{:command :api/request
         :request {:method :get
                   :path "/v1/bank"
                   :auth :admin
                   :headers {:bank-id [:ref :named :bank-id]}}
         :assert {:status 200
                  :body {:providers {:payment "modulr" :idv "zyphe"}}}}]}
