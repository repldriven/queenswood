{:name "A tier's third bank is refused by the tier's limit, an operator's too"
 ;; The `two-banks` tier holds two banks, whoever creates them. Only a
 ;; test system has it, and no other scenario creates a bank on it.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Tier Limit First"
                    :status "test"
                    :tier "two-banks"
                    :currencies ["GBP"]}}
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Tier Limit Second"
                    :status "test"
                    :tier "two-banks"
                    :currencies ["GBP"]}}
   :as :second
   :assert {:status 201 :body {:tier "two-banks"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Tier Limit Third"
                    :status "test"
                    :tier "two-banks"
                    :currencies ["GBP"]}}
   :assert
   {:status 429
    :problem
    {:type ":policy/limit-exceeded"
     :detail
     "Two-banks tier - the installation holds at most 2 banks on the tier"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Tier Limit Elsewhere"
                    :status "test"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :assert {:status 201 :body {:tier "micro"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/bank"
             :auth :admin
             :headers {:bank-id [:ref :second :bank-id]}}
   :assert {:status 200 :body {:name "Tier Limit Second" :tier "two-banks"}}}]}
