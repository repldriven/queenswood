{:name "Admin creates a bank in every currency the API offers"
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Polyglot Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["EUR" "GBP" "USD"]}}
   :as :bank-0
   :assert
   {:status 201
    :body
    {:name "Polyglot Bank"
     :status "live"
     :bank-id [:m/regex "^bnk\\."]
     ;; The organisation party the house accounts are opened on.
     :party {:party-id [:m/regex "^pty\\."]
             :type "organization"
             :display-name "Polyglot Bank"}
     ;; One own-funds house account per requested currency -- the
     ;; chart identifies an account by role and currency, not by
     ;; number, so all three are the same own-funds role. Their
     ;; 3100 coding lives on the ledger side; a cash account
     ;; carries no :gl-code, because CashAccountProduct reserves
     ;; the field and bank-query resolves it off the product
     ;; version. in-any-order pins the count at three, and maps in
     ;; expected position embed, so no other field needs listing.
     ;; :party-id is read back off this same response rather than
     ;; matched by pattern, so the assertion is identity with the
     ;; organisation party, not merely shape. Each account's
     ;; address arrives from the payment provider after the
     ;; bank is created, so none is asserted here.
     :accounts [:m/in-any-order
                [{:currency "EUR"
                  :name "Bank own funds"
                  :product-type "own-funds"
                  :party-id [:ref :bank-0 :party :party-id]
                  :balances [:m/non-empty]}
                 {:currency "GBP"
                  :name "Bank own funds"
                  :product-type "own-funds"
                  :party-id [:ref :bank-0 :party :party-id]
                  :balances [:m/non-empty]}
                 {:currency "USD"
                  :name "Bank own funds"
                  :product-type "own-funds"
                  :party-id [:ref :bank-0 :party :party-id]
                  :balances [:m/non-empty]}]]}}}]}
