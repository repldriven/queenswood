{:name "A bank's credential reads its own bank, and an operator reads any"
 ;; The same bearer reads its own bank, with or without the header, so
 ;; what refuses the later reads is the bank the header names.
 :given
 [{:fixture :bank :as :org-0 :with {:name "Reading Bank" :status "live"}}
  {:fixture :bank :as :org-1 :with {:name "Other Reading Bank" :status "live"}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :bank :client-id]
         :client-secret [:ref :org-0 :bank :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/bank"
             :auth :admin
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200
            :body {:bank-id [:ref :org-0 :bank :bank-id]
                   :name "Reading Bank"
                   :party {:party-id [:m/regex "^pty\\."]}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200 :body {:bank-id [:ref :org-0 :bank :bank-id]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/policies"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/effective-policy"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200 :body {:items [{:kind "bank-created"}]}}}
  {:command :api/request
   :request {:method :get :path "/v1/cash-accounts" :auth :org-0-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200}}]
 :then [;; Another bank's are refused, whether or not it exists.
        {:command :api/request
         :request {:method :get
                   :path "/v1/bank"
                   :auth :org-0-token
                   :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
         :assert {:status 403}}
        {:command :api/request
         :request {:method :get
                   :path "/v1/bank/policies"
                   :auth :org-0-token
                   :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
         :assert {:status 403}}
        {:command :api/request
         :request {:method :get
                   :path "/v1/bank/effective-policy"
                   :auth :org-0-token
                   :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
         :assert {:status 403}}
        {:command :api/request
         :request {:method :get
                   :path "/v1/bank/audit-events"
                   :auth :org-0-token
                   :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
         :assert {:status 403}}
        {:command :api/request
         :request {:method :get
                   :path "/v1/cash-accounts"
                   :auth :org-0-token
                   :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
         :assert {:status 403
                  :problem {:type "auth/forbidden"
                            :detail "The caller is not a member of this bank"}}}
        ;; An operator names the bank in the header alone.
        {:command :api/request
         :request {:method :get
                   :path "/v1/bank/audit-events"
                   :auth :admin
                   :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
         :assert {:status 200 :body {:items [{:kind "bank-created"}]}}}]}
