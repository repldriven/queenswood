{:name "A reward the house account cannot cover is left due, with why"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Reward Deferred Test Org" :tier "test-scenario"}}
  ;; A version that promises £10 to every account opened under it.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Welcome Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :opening-reward {:amount 1000}
                    :effective-from "2026-01-01"}}
   :as :product
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :product :product-id]
                  :version-id [:ref :product :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:fixture :person
   :as :arthur
   :with {:token [:ref :org-0 :token]}}
  {:fixture :account
   :as :account
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :product :product-id]
          :name "Arthur Current"}}]
 :when
 [;; The house account holds nothing, so the posting is refused as the
  ;; account opens and the reward is left due.
  {:command :api/poll
   :request {:method :get
             :path "/v1/rewards"
             :query-params {:account-id [:ref :account :account :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:items [{:status "deferred"}]}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/rewards"
             :auth [:ref :org-0 :token]
             :query-params {"account-id" [:ref :account :account :account-id]}}
   :assert
   {:status 200
    :body
    {:items
     [{:kind "opening" :amount 1000 :status "deferred" :deferred-reason [:m/regex ".+"]}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :account :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 0 :currency "GBP"}}}}]}
