{:name "IDV reject outcome transitions the party to :status \"rejected\""
 :tags #{:api :idv :parties :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-idv-reject-marks-party-bank-001"}
             :body {:name "IDV Reject Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 ;; The Onfido simulator routes by first-name: `Reject*` → "consider"
 ;; outcome → IDV "rejected". The bank-party watcher branches on the
 ;; IDV status-after and rejects the party in lockstep, so the GET below
 ;; lands on :status "rejected" once the webhook → event-processor →
 ;; watcher chain has settled.
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-idv-reject-marks-rejected-001"}
             :body {:type "person"
                    :display-name "Reject Smith"
                    :given-name "Reject"
                    :family-name "Smith"
                    :date-of-birth "1950-07-27"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN000050R"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  ;; Poll the party until it reaches "rejected" rather than timing
  ;; out at a fixed wait — the cascade is fast but the headroom
  ;; tolerates a slow event-processor or watcher hop.
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200
           :body {:party-id [:ref :party-0 :party-id] :status "rejected"}}}]}
