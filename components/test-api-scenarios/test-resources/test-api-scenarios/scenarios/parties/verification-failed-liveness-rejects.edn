{:name "Failing the liveness check rejects the person"
 :runs-on {:idv :every}
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Verification Test Org" :status "live"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :token]
             :body {:party-type "person"
                    :display-name "Arthur Dent"
                    :legal-name "Arthur Dent"}}
   :as :party-0
   :assert {:status 201 :body {:status "pending"}}}
  {:command :idv/verify
   :party [:ref :party-0 :party-id]
   :auth [:ref :org-0 :token]
   :outcome "liveness-failed"}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}/verification"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:status "rejected"
                  :criteria [:m/embeds [{:name "liveness" :state "failed"}]]}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "rejected"}}}]}
