{:name
 "A lost create-party reply is retried under the same key and
        creates one party"
 ;; The command commits and its reply never arrives, so the API answers
 ;; 500 and the cache releases its claim rather than caching a failure.
 ;; The retry under the same key therefore runs the handler again -- it
 ;; is not a replay, and carries no replay header -- and the store-level
 ;; key is what keeps it to one party: the write violates, the party is
 ;; read back under [bank-id, idempotency-key], and the caller is handed
 ;; the party the first attempt made rather than a 422 on the national
 ;; identifier the first attempt also wrote.
 ;;
 ;; The lost reply is produced by a test-only seam keyed on the
 ;; `ik-lost-reply-` prefix; see `test_api_scenarios/fault.clj`.
 :given [{:fixture :bank
          :as :bank-0
          :with {:name "Party Lost Reply Test" :status "live"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-party-first"}
             :body {:party-type "person"
                    :display-name "Ford Prefect"
                    :legal-name "Ford Prefect"}}
   :assert {:status 500}}
  ;; The party the lost attempt wrote is committed, so it appears in the
  ;; listing before the retry is sent -- otherwise the retry would race
  ;; the first command rather than follow it.
  {:command :api/poll
   :request {:method :get :path "/v1/parties" :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [:m/embeds [{:display-name "Ford Prefect"}]]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-party-first"}
             :body {:party-type "person"
                    :display-name "Ford Prefect"
                    :legal-name "Ford Prefect"}}
   :as :retry
   ;; The claim was released, so this ran rather than replayed.
   :assert {:status 201
            :headers {:idempotent-replayed [:m/absent]}
            :body {:display-name "Ford Prefect"}}}
  {:command :idv/verify
   :party [:ref :retry :party-id]
   :auth [:ref :bank-0 :token]}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/parties" :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:items
                   [:m/in-any-order
                    [{:party-id [:ref :retry :party-id]}
                     {:party-id [:ref :bank-0 :bank :party :party-id]}]]}}}]}
