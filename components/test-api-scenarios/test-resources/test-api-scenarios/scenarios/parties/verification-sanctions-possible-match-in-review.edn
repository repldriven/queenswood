{:name "A possible sanctions match puts the verification in review"
 :tags #{:api :idv :parties :unhappy}
 :given
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth :admin
    :headers {:idempotency-key "ik-verification-sanctions-possible-match-in-review-bank-001"}
    :body
    {:name "Verification Test Org" :status "live" :tier "micro" :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-verification-sanctions-possible-match-in-review-001"}
             :body {:type "person"
                    :display-name "Arthur Dent"
                    :given-name "Arthur"
                    :family-name "Dent"
                    :date-of-birth "1952-03-11"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN200009V"
                                          :issuing-country "GB"}}}
   :as :party-0
   :verify {:outcome "sanctions-possible-match"}
   :assert {:status 201 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}/verification"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "in-review" :criteria [:m/embeds [{:name "sanctions" :state "in-review"}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "pending"}}}]}
