{:name "Tenant retrieves a party by id"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Get Party Test Org" :status "live"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :token]
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1948-04-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN000002B"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 201}}
  {:command :idv/verify
   :party [:ref :party-0 :party-id]
   :auth [:ref :org-0 :token]}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:party-id [:ref :party-0 :party-id]
                   :type "person"
                   :display-name "Ford Prefect"}}}]}
