{:name "Suspending a party IDV rejected is refused"
 :tags #{:api :parties :lifecycle :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-suspend-party-from-bank-001"}
             :body {:name "Suspend Rejected Party Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  ;; The Onfido simulator routes by first-name: `Reject*` → "consider"
  ;; → IDV "rejected" → party "rejected". Polling to that end state is
  ;; what makes the source status deterministic — a person party is
  ;; only ever "pending" in transit, so a scenario cannot hold one
  ;; there long enough to aim at it.
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-rejected-party"}
             :body {:type "person"
                    :display-name "Reject Party"
                    :given-name "Reject"
                    :family-name "Party"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888014A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200
           :body {:party-id [:ref :party-0 :party-id] :status "rejected"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/suspend"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-rejected-party-suspend"}}
   :assert {:status 409 :body {:type ":party/invalid-status"}}}]}
