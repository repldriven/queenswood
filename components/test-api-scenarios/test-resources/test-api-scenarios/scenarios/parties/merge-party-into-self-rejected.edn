{:name "Merging a party into itself is rejected"
 :tags #{:api :parties :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-merge-party-into-self-bank-001"}
             :body {:name "Merge Into Self Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-merge-into-self-party"}
             :body {:type "person"
                    :display-name "Self Merging Customer"
                    :given-name "Self"
                    :family-name "Merging"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888010A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/parties/{party-id}/merge"
                   :path-params {:party-id [:ref :party-0 :party-id]}
                   :auth :org-0-token
                   :headers {:idempotency-key "ik-merge-into-self-merge"}
                   :body {:into-party-id [:ref :party-0 :party-id]}}
         :assert {:status 422 :body {:type ":party/merge-into-self"}}}]}
