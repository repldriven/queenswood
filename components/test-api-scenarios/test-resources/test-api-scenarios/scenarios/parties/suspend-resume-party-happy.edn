{:name "Tenant suspends and resumes a party"
 :tags #{:api :parties :lifecycle :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-suspend-resume-party-bank-001"}
             :body {:name "Suspend Resume Party Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-resume-party"}
             :body {:type "person"
                    :display-name "Suspending Party"
                    :given-name "Suspending"
                    :family-name "Party"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888013A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/suspend"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-resume-party-suspend"}}
   :assert {:status 200
            :body {:party-id [:ref :party-0 :party-id]
                   :status "suspended"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/resume"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-suspend-resume-party-resume"}}
   :assert {:status 200
            :body {:party-id [:ref :party-0 :party-id]
                   :status "active"}}}]}
