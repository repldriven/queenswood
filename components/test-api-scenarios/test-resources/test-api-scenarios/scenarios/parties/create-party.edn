{:name "Tenant creates a person party"
 :runs-on {:idv :every}
 :given
 [{:fixture :bank :as :org-0 :with {:name "Parties Test Org" :status "live"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :token]
             :body {:type "person"
                    :display-name "Arthur Phillip Dent"
                    :given-name "Arthur"
                    :family-name "Dent"
                    :date-of-birth "1950-07-27"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN000001A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 201
            :body {:party-id [:m/regex "^pty\\."]
                   :type "person"
                   :display-name "Arthur Phillip Dent"
                   :status "pending"}}}
  {:command :idv/verify
   :party [:ref :party-0 :party-id]
   :auth [:ref :org-0 :token]}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "active"}}}]}
