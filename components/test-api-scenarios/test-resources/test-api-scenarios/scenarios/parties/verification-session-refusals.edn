{:name "Opening a verification session is refused where the request is not one it takes"
 :runs-on {:idv :every}
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Verification Session Org" :status "live"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :token]
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1960-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN300002S"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 201}}]
 :when
 [{:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}/verification"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "pending"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/verification-sessions"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]
             :body {:channel "web"
                    :return-url "http://app.example.test/back"
                    :email "ford.refusals@example.test"}}
   :assert {:status 400}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/verification-sessions"
             :path-params {:party-id "pty.01kprbmgcj35ptc8npmybhh4s9"}
             :auth [:ref :org-0 :token]
             :body {:channel "web"
                    :return-url "https://app.example.test/back"
                    :email "ford.refusals@example.test"}}
   :assert {:status 404 :body {:type ":idv/not-found"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/parties/{party-id}/verification-sessions/{session-id}"
             :path-params {:party-id [:ref :party-0 :party-id]
                           :session-id "ses.01kprbmgcj35ptc8npmybhh4sc"}
             :auth [:ref :org-0 :token]}
   :assert {:status 404 :body {:type ":idv/session-not-found"}}}]}
