{:name "A verification that has decided opens no more sessions"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Verification Session Org" :status "live"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :token]
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"}}
   :as :party-0
   :assert {:status 201}}
  {:command :idv/verify
   :party [:ref :party-0 :party-id]
   :auth [:ref :org-0 :token]}]
 :when [{:command :api/poll
         :request {:method :get
                   :path "/v1/parties/{party-id}"
                   :path-params {:party-id [:ref :party-0 :party-id]}
                   :auth [:ref :org-0 :token]}
         :until {:status 200 :body {:status "active"}}}
        {:command :api/request
         :request {:method :post
                   :path "/v1/parties/{party-id}/verification-sessions"
                   :path-params {:party-id [:ref :party-0 :party-id]}
                   :auth [:ref :org-0 :token]
                   :body {:channel "web"
                          :return-url "https://app.example.test/back"
                          :email "ford.after-decision@example.test"}}
         :assert {:status 409 :body {:type ":idv/invalid-status"}}}]}
