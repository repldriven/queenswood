{:name "A verification that has decided opens no more sessions"
 :tags #{:api :idv :parties :unhappy}
 :given
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth :admin
    :headers {:idempotency-key "ik-verification-session-after-decision-refused-bank-001"}
    :body
    {:name "Verification Session Org" :status "live" :tier "micro" :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-verification-session-after-decision-refused-party-001"}
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1960-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN300003S"
                                          :issuing-country "GB"}}}
   :as :party-0
   :verify {}
   :assert {:status 201}}]
 :when
 [{:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/verification-sessions"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-verification-session-after-decision-001"}
             :body {:channel "web"
                    :return-url "https://app.example.test/back"
                    :email "ford@example.test"}}
   :assert {:status 409 :body {:type ":idv/invalid-status"}}}]}
