{:name "A politically exposed person puts the verification in review"
 :runs-on {:idv :every}
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Verification Test Org" :status "live"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth [:ref :org-0 :token]
             :body {:type "person"
                    :display-name "Arthur Dent"
                    :given-name "Arthur"
                    :family-name "Dent"}}
   :as :party-0
   :assert {:status 201 :body {:status "pending"}}}
  {:command :idv/verify
   :party [:ref :party-0 :party-id]
   :auth [:ref :org-0 :token]
   :outcome "pep"}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}/verification"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:status "in-review"
                  :criteria [:m/embeds [{:name "pep" :state "in-review"}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:status "pending"}}}]}
