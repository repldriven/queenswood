{:name "A live bank cannot be funded over the simulator"
 ;; Simulating money arriving from outside is a sandbox affordance, so
 ;; a live bank is refused whoever asks — its own token or an operator
 ;; naming it.
 :given
 [{:fixture :bank :as :bank :with {:name "Live Bank" :status "live"}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank :bank :accounts 0 :account-id]}
             :auth [:ref :bank :token]}
   :as :before
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth [:ref :bank :token]
             :headers {:bank-id [:ref :bank :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :assert {:status 409 :problem {:type ":bank/invalid-status"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :assert {:status 409 :problem {:type ":bank/invalid-status"}}}]
 :then
 ;; Nothing reached the bank's books.
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :bank :bank :accounts 0 :account-id]}
             :auth [:ref :bank :token]}
   :assert {:status 200
            :body {:available-balance [:ref :before :available-balance]
                   :posted-balance [:ref :before :posted-balance]
                   :items [:m/in-any-order [:ref :before :items]]}}}]}
