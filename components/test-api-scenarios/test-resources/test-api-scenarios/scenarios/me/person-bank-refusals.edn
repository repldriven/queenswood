{:name "A person's bank is refused for an inactive company, and for an operator's choice"
 :tags #{:api :auth :me :banks :unhappy}
 ;; INITECH LTD is `dissolved` in the Companies House simulator's
 ;; examples, and only an active company may be bound to a bank. The
 ;; rejection writes nothing, so `dev` keeps the empty membership list
 ;; the first-sign-in scenario asserts, whichever file runs first.
 :when
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "dev"
   :password "dev"
   :as :dev-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :dev-token
             :headers {:idempotency-key
                       "ik-onboarding-inactive-company-001"}
             :body {:company-number "IN071194" :name "Initech Bank"}}
   :assert {:status 422 :body {:type ":bank/company-not-active"}}}
  ;; The tier is the operator's to choose, and so is a bank with no
  ;; company behind it.
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :dev-token
             :headers {:idempotency-key
                       "ik-onboarding-inactive-company-002"}
             :body {:company-number "IN071194"
                    :name "Initech Bank"
                    :tier "micro"}}
   :assert {:status 403 :body {:type "auth/forbidden"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :dev-token
             :headers {:idempotency-key
                       "ik-onboarding-inactive-company-003"}
             :body {:name "Initech Bank"}}
   :assert {:status 422 :body {:type ":bank/company-required"}}}
  {:command :api/request
   :request {:method :get :path "/v1/me/memberships" :auth :dev-token}
   :assert {:status 200 :body {:items []}}}]}
