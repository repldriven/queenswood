{:name "An operator's user token reads /v1/me and is refused an org route"
 :tags #{:api :auth :me :unhappy}
 ;; `/v1/me` does not expose roles, so the admin realm role is proven
 ;; by the pair rather than read: the token reached `/v1/me` at all,
 ;; which only a user JWT does, and the org route answered 403 rather
 ;; than 200 over a nil bank. A user with no membership carries `:org`
 ;; only when the realm gave it `admin`. The issuer assertion is what
 ;; shows the ops provider, not the orgs one, verified the token.
 :when
 [{:command :auth/mint-user-token
   :realm :queenswood-ops
   :client-id "queenswood-app"
   :username "ops"
   :password "ops"
   :as :ops-token}
  {:command :api/request
   :request {:method :get :path "/v1/me" :auth :ops-token}
   :assert {:status 200
            :body {:user {:issuer [:m/regex "/realms/queenswood-ops$"]
                          :email "ops@queenswood.local"}
                   :memberships []}}}
  ;; The detail is asserted because the status and the type alone do
  ;; not say which branch refused. A principal carrying no `:org` at
  ;; all is refused earlier in `authorize` with the same 403 and the
  ;; same type; this one carries `:org` and is refused for its bank.
  {:command :api/request
   :request {:method :get :path "/v1/cash-accounts" :auth :ops-token}
   :assert
   {:status 403
    :problem
    {:type "auth/forbidden"
     :detail
     "This route acts on the caller's bank and the token names none"}}}]}
