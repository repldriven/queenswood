{:name "Opening a cash account against an unknown product is rejected"
 :tags #{:api :cash-accounts :lifecycle :unhappy}
 ;; The product read runs before the account brick's own check, so the
 ;; kind carries the product brick's namespace. REQ-003 asks for
 ;; `:cash-account/product-not-found`; the status and the detail are
 ;; already what it asks for.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-open-unknown-product-bank-001"}
             :body {:name "Open Unknown Product Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-open-unknown-product-party"}
             :body {:type "person"
                    :display-name "Unknown Product Holder"
                    :given-name "Unknown"
                    :family-name "Holder"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN889008A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-open-unknown-product-prod-001"}
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :draft :product-id]
                  :version-id [:ref :draft :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-open-unknown-product-open"}
             :body {:party-id [:ref :party-0 :party-id]
                    :name "No Such Product"
                    :currency "GBP"
                    :product-id "prd.00000000000000000000000000"}}
   :assert {:status 404
            :problem
            {:type ":cash-account-product/product-not-found"}}}]}
