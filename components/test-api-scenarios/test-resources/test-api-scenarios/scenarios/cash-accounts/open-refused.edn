{:name "An account the payment provider declines is refused"
 :tags #{:serial}
 ;; The simulator declines the next account it is asked to open. The
 ;; account, written opening, becomes refused with the provider's reason
 ;; and never carries an address.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Open Refused"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-a
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-a :client-id]
         :client-secret [:ref :bank-a :client-secret]
         :status :live}
   :as :bank-a-token}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-a-token] :name "Current"}}
  {:fixture :person
   :as :party
   :with {:token [:ref :bank-a-token]
          :display-name "Slartibartfast Magrathea"
          :given-name "Slartibartfast"
          :family-name "Magrathea"
          :date-of-birth "1947-05-19"
          :national-insurance "TN555201E"
          :address {:building-number "1"
                    :street "Fjord Lane"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/open-refused"}
   :assert {:status 204}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :body {:party-id [:ref :party :party :party-id]
                    :name "Slartibartfast Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :account
   :assert {:status 201
            :body {:account-status "opening"
                   :payment-addresses []
                   :bban [:m/absent]}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account :account-id]}
             :auth :bank-a-token}
   :until {:status 200
           :body {:account-status "refused"
                  :refusal-reason "The account was declined"
                  :payment-addresses []
                  :bban [:m/absent]}}}]}
