{:name "An internal payment to a closed account is rejected"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Pay To Closed Test Org" :status "live"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Closed Payee"
          :legal-name "Closed Payee"}}
  {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
  {:fixture :account
   :as :debtor
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :draft :product :product-id]
          :name "Open Debtor"}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :draft :product :product-id]
          :name "Closed Creditor"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "closed"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-account-id [:ref :creditor :account :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "To a closed account"}}
   :assert {:status 409
            :problem {:type ":payment/creditor-account-not-operable"}}}]}
