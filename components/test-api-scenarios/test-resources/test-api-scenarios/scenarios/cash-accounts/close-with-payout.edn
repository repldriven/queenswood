{:name "A close moves the account's balance to the payout account it names"
 ;; The account holds 5000 and the close names another of the party's
 ;; accounts: the close moves the 5000 there in a closure transaction,
 ;; records the payout account on its operation, and the account closes
 ;; once it holds nothing.
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Close With Payout Bank"}}
         {:fixture :person
          :as :party-0
          :with {:token [:ref :org-0 :token]
                 :display-name "Payout Closer"
                 :legal-name "Payout Closer"}}
         {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
         {:fixture :funded-account
          :as :closing
          :with {:token [:ref :org-0 :token]
                 :bank-id [:ref :org-0 :bank :bank-id]
                 :party-id [:ref :party-0 :party :party-id]
                 :product-id [:ref :draft :product :product-id]
                 :name "To Be Closed"
                 :amount 5000}}
         {:fixture :account
          :as :payout
          :with {:token [:ref :org-0 :token]
                 :party-id [:ref :party-0 :party :party-id]
                 :product-id [:ref :draft :product :product-id]
                 :name "Payout"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :closing :opened :account
                                        :account-id]}
             :auth [:ref :org-0 :token]
             :body {:payout-account-id [:ref :payout :account :account-id]}}
   :assert {:status 200 :body {:status "closing"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :closing :opened :account
                                        :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "closed"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :payout :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 5000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :closing :opened :account
                                        :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:available-balance {:value 0}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :payout :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [{:transaction-type "closure"}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/operations"
             :path-params {:account-id [:ref :closing :opened :account
                                        :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [{:kind "close"
                            :payout-account-id [:ref :payout :account
                                                :account-id]}]}}}]}
