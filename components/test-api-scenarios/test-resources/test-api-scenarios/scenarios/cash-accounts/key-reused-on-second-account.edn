{:name "One key reused on a second account is refused, and the account stands"
 ;; The two closes share a path template but not a path, so the key is
 ;; live against a different request. Replaying the first answer would
 ;; report the second account as closed when it is not, which is worse
 ;; than a refusal: the caller is told to use a fresh key, and the
 ;; second account is left exactly as it was.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Key Reuse Test Org" :status "live"}}
  {:fixture :product
   :as :product
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :party
   :with {:token [:ref :bank-0 :token]
          :display-name "Reuse Customer"
          :given-name "Reuse"
          :family-name "Customer"
          :date-of-birth "1962-02-02"
          :national-insurance "TN555801H"
          :address {:building-number "3"
                    :street "Improbability Drive"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  {:fixture :account
   :as :first
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :party :party :party-id]
          :product-id [:ref :product :product :product-id]
          :name "First"}}
  {:fixture :account
   :as :second
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :party :party :party-id]
          :product-id [:ref :product :product :product-id]
          :name "Second"}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/cash-accounts/{account-id}/close"
                   :path-params {:account-id [:ref :first :account :account-id]}
                   :auth [:ref :bank-0 :token]
                   :headers {:idempotency-key "ik-key-reused-close-001"}}
         :assert {:status 200}}
        ;; The same key, a different account.
        {:command :api/request
         :request {:method :post
                   :path "/v1/cash-accounts/{account-id}/close"
                   :path-params
                   {:account-id [:ref :second :account :account-id]}
                   :auth [:ref :bank-0 :token]
                   :headers {:idempotency-key "ik-key-reused-close-001"}}
         :assert {:status 422 :problem {:type "mono/idempotency-key-reused"}}}]
 :then
 ;; The second account was never touched.
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :second :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:account-status "opened"}}}]}
