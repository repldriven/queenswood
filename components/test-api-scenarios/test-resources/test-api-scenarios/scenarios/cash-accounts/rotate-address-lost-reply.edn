{:name
 "A lost rotate-address reply is retried under the same key and
        rotates once"
 ;; The rotation commits and its reply never arrives, so the API answers
 ;; 500 and the cache releases its claim. The retry under the same key
 ;; runs the handler again -- it is not a replay, and carries no replay
 ;; header -- and the account's own record of the key that last rotated
 ;; it is what keeps it to one set of addresses: no allocation, no save,
 ;; no changelog entry, and the addresses the first attempt allocated
 ;; come back.
 ;;
 ;; The lost reply is produced by a test-only seam keyed on the
 ;; `ik-lost-reply-` prefix; see `test_api_scenarios/fault.clj`.
 :given [{:fixture :bank
          :as :bank-0
          :with {:name "Rotate Lost Reply Test" :status "live"}}
         {:fixture :person
          :as :party-0
          :with {:token [:ref :bank-0 :token]}}
         {:fixture :product :as :draft :with {:token [:ref :bank-0 :token]}}
         {:fixture :account
          :as :account-0
          :with {:token [:ref :bank-0 :token]
                 :party-id [:ref :party-0 :party :party-id]
                 :product-id [:ref :draft :product :product-id]
                 :name "To Be Rotated Once"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/rotate-address"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-rotate-0001"}}
   :assert {:status 500}}
  ;; The rotation the lost attempt made is committed, so the account
  ;; carries its new addresses before the retry is sent -- otherwise the
  ;; retry would race the first command rather than follow it.
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-addresses
                  [:m/mismatch [:ref :account-0 :account :payment-addresses]]}}
   :as :after-first}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/rotate-address"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-rotate-0001"}}
   ;; The claim was released, so this ran rather than replayed -- and
   ;; still answers with the addresses the first attempt allocated.
   :assert {:status 200
            :headers {:idempotent-replayed [:m/absent]}
            :body {:account-status "opened"
                   :payment-addresses [:ref :after-first :payment-addresses]}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:payment-addresses [:ref :after-first :payment-addresses]
                   :idempotency-key [:m/absent]
                   :last-rotation-idempotency-key [:m/absent]}}}]}
