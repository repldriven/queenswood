{:name "Opening a cash account for an inactive party is rejected"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Open Inactive Party Test Org" :status "live"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Suspended Holder"
          :given-name "Suspended"
          :family-name "Holder"
          :national-insurance "TN889006A"}}
  {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties/{party-id}/suspend"
             :path-params {:party-id [:ref :party-0 :party :party-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "For A Suspended Party"
                    :currency "GBP"
                    :product-id [:ref :draft :product :product-id]}}
   :assert {:status 422 :problem {:type ":cash-account/party-status"}}}]}
