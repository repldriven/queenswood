{:name
 "A close the provider refuses returns the account to where it closed from"
 :runs-on {:payment :every}
 :tags #{:serial}
 ;; The simulator refuses the next close it is asked for. An opened
 ;; account goes back to opened and a suspended one to suspended, each
 ;; carrying the provider's reason, and the customer is told.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Close Refused"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :account
   :as :open-one
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}
  {:fixture :account
   :as :suspended-one
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :suspended-one :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200}}
  {:fixture :webhook-receiver :as :hook :with {:token [:ref :bank-0 :token]}}]
 :when
 [{:command :api/request
   :request
   {:method :post :base :payment-simulator :path "/simulate/close-refused"}
   :assert {:status 204}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :open-one :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:account-status "closing"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :open-one :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:account-status "opened" :refusal-reason [:m/regex ".+"]}}
   :timeout-ms 45000}
  {:command :api/request
   :request
   {:method :post :base :payment-simulator :path "/simulate/close-refused"}
   :assert {:status 204}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :suspended-one :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:account-status "closing"}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :suspended-one :account
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:account-status "suspended" :refusal-reason [:m/regex ".+"]}}
   :timeout-ms 45000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :open-one :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :as :read
   :assert {:status 200}}
  {:command :webhook/await-delivery
   :address [:ref :hook :receiver :address]
   :where {:kind "cash-account.close-refused"
           :resource-id [:ref :open-one :account :account-id]
           :status-before "closing"
           :status-after "opened"}
   :secret [:ref :hook :registered :secret]
   :as :notified}
  {:command :assert/equals
   :actual [:ref :notified 0 :body :data]
   :expected [:ref :read]}]}
