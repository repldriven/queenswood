{:name "Closing a cash account with a non-zero balance is rejected"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Close Non-Zero Account Test Org"}}
  ;; Active party
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Non Zero Customer"
          :given-name "Non"
          :family-name "Zero"}}
  ;; Published product
  {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
  ;; Open the cash-account and wait for opened
  {:fixture :account
   :as :account-0
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :draft :product :product-id]
          :name "Not To Be Closed"}}
  ;; Fund the account so it holds a non-zero posted balance.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}
             :body {:amount 5000 :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :account-0 :account :account-id]
                    :currency "GBP"
                    :amount 5000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 5000 :currency "GBP"}}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 409 :body {:type ":cash-account/non-zero-on-close"}}}]}
