{:name "Opening a cash account twice under one key opens one account"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Open Replay Same Key Test Org" :status "live"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Replaying Holder"
          :given-name "Replaying"
          :family-name "Holder"
          :national-insurance "TN889010A"}}
  {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :headers {:idempotency-key "ik-open-replay-same-key-open"}
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Opened Once"
                    :currency "GBP"
                    :product-id [:ref :draft :product :product-id]}}
   :as :account-0
   ;; The first submission ran the handler, so it is not a replay.
   :assert {:status 201
            :headers {:idempotent-replayed [:m/absent]}
            :body {:account-status "opening"}}}
  ;; Same key, same body: one account id, and the second answer says it
  ;; is a replay.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :headers {:idempotency-key "ik-open-replay-same-key-open"}
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Opened Once"
                    :currency "GBP"
                    :product-id [:ref :draft :product :product-id]}}
   :assert {:status 201
            :headers {:idempotent-replayed "true"}
            :body {:account-id [:ref :account-0 :account-id]}}}]}
