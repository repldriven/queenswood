{:name "A suspend and a resume are each carried out at the payment provider"
 :runs-on {:payment :every}
 ;; Each is an operation on the account, pending until the provider
 ;; answers: Modulr blocks and unblocks the account, and a provider with
 ;; nothing to call answers once the account's earlier calls settle.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Account Operations"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :account
   :as :account-0
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]
          :name "Operated On"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "suspended"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/resume"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "opened"}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/operations"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [{:kind "resume"
                           :status "completed"
                           :created-by {:kind "bank"}}
                          {:kind "suspend"
                           :status "completed"
                           :created-by {:kind "bank"}}]}}
   :timeout-ms 45000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :query-params {"embed[operations]" "true"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:operations [{:kind "resume"} {:kind "suspend"}]}}}]}
