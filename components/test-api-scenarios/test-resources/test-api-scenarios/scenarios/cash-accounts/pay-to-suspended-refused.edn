{:name "An internal payment to a suspended account is rejected"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Pay To Suspended Test Org" :status "live"}}
         {:fixture :person
          :as :party-0
          :with {:token [:ref :org-0 :token]
                 :display-name "Suspended Payee"
                 :given-name "Suspended"
                 :family-name "Payee"}}
         {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
         {:fixture :account
          :as :debtor
          :with {:token [:ref :org-0 :token]
                 :party-id [:ref :party-0 :party :party-id]
                 :product-id [:ref :draft :product :product-id]
                 :name "Open Debtor"}}
         {:fixture :account
          :as :creditor
          :with {:token [:ref :org-0 :token]
                 :party-id [:ref :party-0 :party :party-id]
                 :product-id [:ref :draft :product :product-id]
                 :name "Suspended Creditor"}}
         {:command :api/request
          :request {:method :post
                    :path "/v1/cash-accounts/{account-id}/suspend"
                    :path-params
                    {:account-id [:ref :creditor :account :account-id]}
                    :auth [:ref :org-0 :token]}
          :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-account-id [:ref :creditor :account :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "To a suspended account"}}
   :assert {:status 409
            :problem {:type ":payment/creditor-account-not-operable"}}}]}
