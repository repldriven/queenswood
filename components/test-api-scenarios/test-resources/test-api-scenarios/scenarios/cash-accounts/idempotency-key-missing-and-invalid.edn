{:name "A write route refuses a missing or malformed Idempotency-Key"
 ;; The header is mandatory on every protected write, and its value must
 ;; match ^[A-Za-z0-9_-]{16,255}$ — long enough that a client cannot
 ;; collide two requests by accident. Both refusals are 400s, and they
 ;; are distinct types so a client can tell "you forgot it" from "that
 ;; will not do".
 :given
 [{:fixture :bank
   :as :bank-0
   :with {:name "Key Refusals Test Org" :status "live"}}]
 :when
 ;; No header at all, and none generated for it.
 [{:command :api/request
   :idempotency-key false
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id "pty.00000000000000000000000000"
                    :name "Never Opened"
                    :currency "GBP"
                    :product-id "prd.00000000000000000000000000"}}
   :assert {:status 400 :problem {:type "server/missing-idempotency-key"}}}
  ;; Eight characters — present, but shorter than the minimum sixteen.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-short"}
             :body {:party-id "pty.00000000000000000000000000"
                    :name "Never Opened"
                    :currency "GBP"
                    :product-id "prd.00000000000000000000000000"}}
   :assert {:status 400 :problem {:type "server/invalid-idempotency-key"}}}]}
