{:name "An account's sixth operation of the day, a resume, is refused"
 ;; The platform-restricted policy counts an account's operations, five a
 ;; day, and the refused resume leaves it suspended.
 :given [{:fixture :bank :as :bank-0 :with {:name "Operation Limits"}}
         {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
         {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
         {:fixture :account
          :as :account-0
          :with {:token [:ref :bank-0 :token]
                 :party-id [:ref :arthur :party :party-id]
                 :product-id [:ref :current :product :product-id]
                 :name "Often Frozen"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "suspended"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/resume"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "suspended"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/resume"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "suspended"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/resume"
             :path-params {:account-id [:ref :account-0 :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 429 :problem {:type ":policy/limit-exceeded"}}}]
 :then [{:command :api/request
         :request {:method :get
                   :path "/v1/cash-accounts/{account-id}"
                   :path-params
                   {:account-id [:ref :account-0 :account :account-id]}
                   :auth [:ref :bank-0 :token]}
         :assert {:status 200 :body {:status "suspended"}}}]}
