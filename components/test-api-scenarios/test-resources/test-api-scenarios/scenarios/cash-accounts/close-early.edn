{:name "An early close is refused or charged by its version's closure terms"
 ;; Windows count from the day the account came onto its version, so an
 ;; account opened today is inside each. A version refusing closures in
 ;; its first three months refuses the close with 409 and leaves the
 ;; account opened. A version charging 500 in its first year takes the
 ;; fee from the balance against 4100 fee income, and the close moves the
 ;; rest to the nominated account.
 :given
 [{:fixture :bank :as :org-0 :with {:name "Early Close Bank"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Early Closer"
          :legal-name "Early Closer"}}
  {:fixture :product :as :plain :with {:token [:ref :org-0 :token]}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Locked Saver"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :closure-terms {:interest {:kind "pay"}
                                    :early [{:unit "month" :count 3 :kind "refused"}]}
                    :effective-from "2026-01-01"}}
   :as :locked
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :locked :product-id]
                  :version-id [:ref :locked :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Penalty Saver"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :closure-terms {:interest {:kind "pay"}
                                    :early [{:unit "month"
                                             :count 12
                                             :kind "charged"
                                             :interest {:kind "pay"}
                                             :fee {:kind "flat" :amount 500}}]}
                    :effective-from "2026-01-01"}}
   :as :penalty
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :penalty :product-id]
                  :version-id [:ref :penalty :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:fixture :account
   :as :locked-account
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :locked :product-id]
          :name "Locked"}}
  {:fixture :funded-account
   :as :penalty-account
   :with {:token [:ref :org-0 :token]
          :bank-id [:ref :org-0 :bank :bank-id]
          :amount 5000
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :penalty :product-id]
          :name "Penalty"}}
  {:fixture :account
   :as :nominated
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :plain :product :product-id]
          :name "Nominated"}}
 ]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :locked-account :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 409
            :problem {:type ":cash-account/early-closure-refused"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :penalty-account :opened :account :account-id]}
             :auth [:ref :org-0 :token]
             :body {:nominated-account-id [:ref :nominated :account
                                           :account-id]}}
   :assert {:status 200 :body {:status "closing"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :penalty-account :opened :account
                                        :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "closed"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :locked-account :account
                                        :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:status "opened"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :nominated :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:available-balance {:value 4500}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :penalty-account :opened :account
                                        :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:transaction-type "fee" :side "debit" :amount 500}
                            {:transaction-type "closure"
                             :side "debit"
                             :amount 4500}]]}}}
  {:command :api/request
   :request {:method :get :path "/v1/ledger-accounts" :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:code "4100"
                             :currency "GBP"
                             :posted-balance {:value 500}}]]}}}]}
