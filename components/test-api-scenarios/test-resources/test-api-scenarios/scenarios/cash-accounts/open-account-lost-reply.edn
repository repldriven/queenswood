{:name
 "A lost open-account reply is retried under the same key and opens
        once"
 ;; The open commits and its reply never arrives, so the API answers
 ;; 500 and the cache releases its claim. The retry under the same key
 ;; runs the handler again -- it is not a replay, and carries no replay
 ;; header -- and the store's unique index on the key is what keeps it
 ;; to one account: the processor reads the first open's account back
 ;; and answers with it.
 ;;
 ;; The lost reply is produced by a test-only seam keyed on the
 ;; `ik-lost-reply-` prefix; see `test_api_scenarios/fault.clj`.
 :given [{:fixture :bank
          :as :bank-0
          :with {:name "Open Lost Reply Test" :status "live"}}
         {:fixture :person
          :as :party-0
          :with {:token [:ref :bank-0 :token]
                 :display-name "Tricia McMillan"
                 :given-name "Tricia"
                 :family-name "McMillan"}}
         {:fixture :product :as :draft :with {:token [:ref :bank-0 :token]}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-open-0001"}
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Opened Once"
                    :currency "GBP"
                    :product-id [:ref :draft :product :product-id]}}
   :assert {:status 500}}
  ;; The open the lost attempt made is committed, so the bank lists the
  ;; party's account before the retry is sent -- otherwise the retry
  ;; would race the first command rather than follow it.
  {:command :api/poll
   :request {:method :get :path "/v1/cash-accounts" :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items
                  [:m/in-any-order
                   [{:account-id [:ref :bank-0 :bank :accounts 0 :account-id]}
                    {:party-id [:ref :party-0 :party :party-id]}]]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-open-0001"}
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Opened Once"
                    :currency "GBP"
                    :product-id [:ref :draft :product :product-id]}}
   ;; The claim was released, so this ran rather than replayed -- and
   ;; still answers with the account the first attempt opened.
   :assert {:status 201
            :headers {:idempotent-replayed [:m/absent]}
            :body {:party-id [:ref :party-0 :party :party-id]}}
   :as :retried}]
 :then
 [{:command :api/request
   :request {:method :get :path "/v1/cash-accounts" :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:items
                   [:m/in-any-order
                    [{:account-id [:ref :bank-0 :bank :accounts 0 :account-id]}
                     {:account-id [:ref :retried :account-id]}]]}}}]}
