{:name "Rotating a closed cash account's payment address is rejected"
 :tags #{:api :cash-accounts :lifecycle :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-rotate-address-closed-bank-001"}
             :body {:name "Rotate Address Closed Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  ;; Active party
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-rotate-address-closed-party"}
             :body {:type "person"
                    :display-name "Closed Rotating Customer"
                    :given-name "Closed"
                    :family-name "Rotator"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888005A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}
  ;; Published product
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-rotate-address-closed-prod-001"}
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :draft :product-id]
                  :version-id [:ref :draft :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}
  ;; Open, then close the cash-account
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-rotate-address-closed-open"}
             :body {:party-id [:ref :party-0 :party-id]
                    :name "To Be Closed Then Rotated"
                    :currency "GBP"
                    :product-id [:ref :draft :product-id]}}
   :as :account-0
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-rotate-address-closed-close"}}
   :assert {:status 200 :body {:account-status "closing"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "closed"}}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/cash-accounts/{account-id}/rotate-address"
                   :path-params {:account-id [:ref :account-0 :account-id]}
                   :auth :org-0-token
                   :headers {:idempotency-key
                             "ik-rotate-address-closed-rotate"}}
         :assert {:status 409 :body {:type ":cash-account/invalid-status"}}}]}
