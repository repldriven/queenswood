{:name "A preview decides about every account and moves none"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Migration Preview Test Org" :status "live"}}
  {:fixture :product
   :as :v1
   :with {:token [:ref :org-0 :token]
          :name "Saver"
          :template-id "tpl.00000000000000000000000002"
          :interest-rate-bps 100}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product :product-id]}
             :auth [:ref :org-0 :token]
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 365
                    :effective-from "2026-06-01"}}
   :as :v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v2 :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth [:ref :org-0 :token]
             :body {:name "Saver v1 holders onto v2"
                    :source-product-id [:ref :v1 :product :product-id]
                    :target-product-id [:ref :v2 :product-id]
                    :target-version-id [:ref :v2 :version-id]}}
   :as :migration
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth [:ref :org-0 :token]}
   :as :preview
   ;; A preview says so on the record and completes having decided
   ;; about the cohort. The bank holds no accounts on this product, so
   ;; the cohort is empty — what is being proved here is that the run is
   ;; recorded and readable, not any particular count.
   :assert {:status 201
            :body {:migration-id [:ref :migration :migration-id]
                   :dry-run true
                   :status "completed"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [{:run-id [:ref :preview :run-id]
                           :dry-run true}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}/previews/{run-id}"
             :path-params {:migration-id [:ref :migration :migration-id]
                           :run-id [:ref :preview :run-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:run-id [:ref :preview :run-id]}}}
  {:command :api/request
   :request
   {:method :get
    :path
    "/v1/cash-account-migrations/{migration-id}/previews/{run-id}/accounts"
    :path-params {:migration-id [:ref :migration :migration-id]
                  :run-id [:ref :preview :run-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:items []}}}]}
