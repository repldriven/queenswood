{:name "A preview decides about every account and moves none"
 :tags #{:api :cash-account-migrations :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-preview-bank-001"}
             :body {:name "Migration Preview Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-prod-001"}
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product-id]
                  :version-id [:ref :v1 :version-id]}
    :auth :org-0-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product-id]}
             :auth :org-0-token
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 365
                    :effective-from "2026-06-01"}}
   :as :v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v2 :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth :org-0-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-mig-001"}
             :body {:name "Saver v1 holders onto v2"
                    :source-product-id [:ref :v1 :product-id]
                    :target-product-id [:ref :v2 :product-id]
                    :target-version-id [:ref :v2 :version-id]}}
   :as :migration
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-prev-001"}}
   :as :preview
   ;; A preview says so on the record and completes having decided
   ;; about the cohort. The bank holds no accounts on this product, so
   ;; the cohort is empty — what is being proved here is that the run is
   ;; recorded and readable, not any particular count.
   :assert {:status 201
            :body {:migration-id [:ref :migration :migration-id]
                   :dry-run true
                   :status "completed"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:runs [{:run-id [:ref :preview :run-id]
                           :dry-run true}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}/previews/{run-id}"
             :path-params {:migration-id [:ref :migration :migration-id]
                           :run-id [:ref :preview :run-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:run-id [:ref :preview :run-id]}}}
  {:command :api/request
   :request
   {:method :get
    :path
    "/v1/cash-account-migrations/{migration-id}/previews/{run-id}/accounts"
    :path-params {:migration-id [:ref :migration :migration-id]
                  :run-id [:ref :preview :run-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:accounts []}}}]}
