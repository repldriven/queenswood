{:name "A migration is refused when its target does not fit"
 :tags #{:api :cash-account-migrations :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-rejected-bank-001"}
             :body {:name "Migration Reject Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-create-rejected-prod-001"}
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product-id]
                  :version-id [:ref :v1 :version-id]}
    :auth :org-0-token}
   :assert {:status 200}}
  ;; A second version, left in draft on purpose.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product-id]}
             :auth :org-0-token
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 365
                    :effective-from "2026-06-01"}}
   :as :draft
   :assert {:status 201 :body {:status "draft"}}}]
 :when
 ;; Accounts may only be held on terms the bank has committed to.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth :org-0-token
             :headers {:idempotency-key "ik-create-rejected-mig-001"}
             :body {:name "Onto an unpublished version"
                    :source-product-id [:ref :v1 :product-id]
                    :target-product-id [:ref :draft :product-id]
                    :target-version-id [:ref :draft :version-id]}}
   :assert {:status 422
            :problem {:type ":cash-account-migration/target-not-published"}}}
  ;; Notice after the move is not notice.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth :org-0-token
             :headers {:idempotency-key "ik-create-rejected-mig-002"}
             :body {:name "Notice after the move"
                    :source-product-id [:ref :v1 :product-id]
                    :target-product-id [:ref :v1 :product-id]
                    :target-version-id [:ref :v1 :version-id]
                    :notified-on "2026-08-01"
                    :due-on "2026-06-01"}}
   :assert {:status 422
            :problem {:type ":cash-account-migration/notice-after-due"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}"
             :path-params {:migration-id "mig.01kz3wyzcjhkab9ch91x9ngedr"}
             :auth :org-0-token}
   :assert {:status 404
            :problem {:type ":cash-account-migration/not-found"}}}]}
