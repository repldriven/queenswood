{:name "Tenant authors a migration between two versions of a product"
 :tags #{:api :cash-account-migrations :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-and-read-bank-001"}
             :body {:name "Migration Create Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  ;; v1 — the terms accounts are on today.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-create-and-read-prod-001"}
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product-id]
                  :version-id [:ref :v1 :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}
  ;; v2 — better terms, published and in force.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product-id]}
             :auth :org-0-token
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 365
                    :effective-from "2026-06-01"}}
   :as :v2
   :assert {:status 201 :body {:status "draft" :version-number 2}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v2 :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth :org-0-token
             :headers {:idempotency-key "ik-create-and-read-mig-001"}
             :body {:name "Saver v1 holders onto v2"
                    :source-product-id [:ref :v1 :product-id]
                    :source-version-ids [[:ref :v1 :version-id]]
                    :target-product-id [:ref :v2 :product-id]
                    :target-version-id [:ref :v2 :version-id]
                    :notified-on "2026-06-01"
                    :due-on "2026-08-01"}}
   :as :migration
   ;; Authoring moves nothing — it opens in draft, and the notice dates
   ;; round-trip as ISO strings rather than the epoch-days stored.
   :assert {:status 201
            :body {:status "draft"
                   :name "Saver v1 holders onto v2"
                   :source-product-id [:ref :v1 :product-id]
                   :target-version-id [:ref :v2 :version-id]
                   :notified-on "2026-06-01"
                   :due-on "2026-08-01"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:migration-id [:ref :migration :migration-id]
                   :name "Saver v1 holders onto v2"
                   :status "draft"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations"
             :auth :org-0-token}
   :assert {:status 200
            :body {:migrations [{:migration-id
                                 [:ref :migration :migration-id]}]}}}]}
