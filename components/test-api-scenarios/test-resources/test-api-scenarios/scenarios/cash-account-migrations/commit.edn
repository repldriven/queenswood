{:name "The scheduler's migration task moves an approved migration's accounts"
 :tags #{:api :cash-account-migrations :jobs :happy}
 ;; The whole path, end to end: an account opened on v1, a migration
 ;; approved onto v2, and the scheduler carrying it out. Nothing before
 ;; the forced run may move the account — authoring moves nothing and
 ;; approving moves nothing, which is the property the API's shape
 ;; exists to hold.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-commit-bank-001"}
             :body {:name "Migration Commit Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-migration-commit-party"}
             :body {:type "person"
                    :display-name "Migrating Customer"
                    :given-name "Migrating"
                    :family-name "Customer"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "12"
                              :street "Version Road"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN888003A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}
  ;; v1, published and in force.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-commit-prod-001"}
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product-id]
                  :version-id [:ref :v1 :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}
  ;; Opened before v2 exists, so the account pins to v1 — an account
  ;; pins the version in force when it opens and does not follow later
  ;; ones. That is the whole reason a migration is needed.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-migration-commit-open"}
             :body {:party-id [:ref :party-0 :party-id]
                    :name "To Be Migrated"
                    :currency "GBP"
                    :product-id [:ref :v1 :product-id]}}
   :as :account-0
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :until {:status 200
           :body {:account-status "opened"
                  :version-id [:ref :v1 :version-id]}}}
  ;; v2 — the terms the cohort is being moved onto. Its effective-from
  ;; is in the past, so its window is open and the migration is
  ;; runnable rather than merely approved.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product-id]}
             :auth :org-0-token
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 365
                    :effective-from "2026-06-01"}}
   :as :v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v2 :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth :org-0-token
             :headers {:idempotency-key "ik-commit-mig-001"}
             :body {:name "Saver holders onto v2"
                    :source-product-id [:ref :v1 :product-id]
                    :target-product-id [:ref :v2 :product-id]
                    :target-version-id [:ref :v2 :version-id]
                    :notified-on "2026-01-01"
                    :due-on "2026-06-01"}}
   :as :migration
   :assert {:status 201 :body {:status "draft"}}}]
 :when
 ;; Approving decides that accounts will move, never that they move now.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/approve"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "approved"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:version-id [:ref :v1 :version-id]}}}
  ;; The scheduler's migration task is the only thing that moves
  ;; accounts. `records-processed` is the count the job page reads off
  ;; the task, and it is asserted because a summary whose keys the
  ;; scheduler does not read reports a silent zero.
  {:command :api/request
   :request {:method :post
             :path "/v1/jobs/{job-id}/runs"
             :path-params {:job-id "account-migration"}
             :auth :org-0-token
             :headers {:idempotency-key "ik-commit-run-001"}}
   :assert {:status 201
            :body {:job-id "account-migration"
                   :trigger-source "forced"
                   :status "succeeded"
                   :tasks [{:label "migrate"
                            :status "succeeded"
                            :records-processed 1
                            :records-failed 0}]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :account-0 :account-id]}
             :auth :org-0-token}
   ;; The same account on different terms: repinned, and its number,
   ;; its addresses and its status all where they were.
   :assert {:status 200
            :body {:account-id [:ref :account-0 :account-id]
                   :version-id [:ref :v2 :version-id]
                   :account-status "opened"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token}
   :assert {:status 200 :body {:status "completed"}}}
  ;; A commit writes its own run, distinguishable from a preview by
  ;; `dry-run` and carrying what it actually moved.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token}
   :as :runs
   :assert {:status 200
            :body {:runs [{:migration-id [:ref :migration :migration-id]
                           :dry-run false
                           :status "completed"
                           :accounts-seen 1
                           :accounts-moved 1}]}}}
  ;; And the account's own verdict says where it landed — `migrated`
  ;; rather than a preview's `eligible`, with the target recorded.
  {:command :api/request
   :request
   {:method :get
    :path
    "/v1/cash-account-migrations/{migration-id}/previews/{run-id}/accounts"
    :path-params {:migration-id [:ref :migration :migration-id]
                  :run-id [:ref :runs :runs 0 :run-id]}
    :auth :org-0-token}
   :assert {:status 200
            :body {:accounts [{:account-id [:ref :account-0 :account-id]
                               :outcome "migrated"
                               :from-version-id [:ref :v1 :version-id]
                               :to-version-id [:ref :v2 :version-id]}]}}}]}
