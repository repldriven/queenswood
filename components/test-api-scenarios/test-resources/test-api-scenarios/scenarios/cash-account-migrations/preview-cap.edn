{:name "Micro tier caps migration previews at ten per day"
 :tags #{:api :cash-account-migrations :policy :unhappy}
 ;; A preview reads every account of a product, so it is the cheapest
 ;; thing on this resource to ask for and the most expensive to serve.
 ;; The cap is what stops a dry run being used as a free full scan.
 :given
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth :admin
    :headers {:idempotency-key "ik-preview-cap-bank-001"}
    :body {:name "Preview Cap Org"
           :status "live"
           :tier "micro"
           :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prod-001"}
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product-id]
                  :version-id [:ref :v1 :version-id]}
    :auth :org-0-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product-id]}
             :auth :org-0-token
             :body {:name "Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 365
                    :effective-from "2026-06-01"}}
   :as :v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v2 :product-id]
                  :version-id [:ref :v2 :version-id]}
    :auth :org-0-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations"
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-mig-001"}
             :body {:name "Saver holders onto v2"
                    :source-product-id [:ref :v1 :product-id]
                    :target-product-id [:ref :v2 :product-id]
                    :target-version-id [:ref :v2 :version-id]}}
   :as :migration
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-001"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-002"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-003"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-004"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-005"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-006"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-007"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-008"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-009"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-010"}}
   :assert {:status 201}}]
 :when
 ;; The eleventh is refused, and refused before a run is opened — a
 ;; limit that recorded a run saying it started would misreport the
 ;; day's count to the next caller.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token
             :headers {:idempotency-key "ik-preview-cap-prev-011"}}
   :assert {:status 429 :problem {:type ":policy/limit-exceeded"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-account-migrations/{migration-id}/previews"
             :path-params {:migration-id [:ref :migration :migration-id]}
             :auth :org-0-token}
   :as :runs
   :assert {:status 200}}]}
