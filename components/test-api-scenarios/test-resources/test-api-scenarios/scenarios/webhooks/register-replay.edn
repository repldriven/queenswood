{:name "Registering twice under one key registers one endpoint"
 ;; The second request answers the endpoint the first registered, and a
 ;; fresh key registers its own: the read-back is keyed, not blanket.
 :given [{:fixture :bank :as :org-0 :with {:name "Webhook Replay Org"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :headers {:idempotency-key "ik-webhook-register-replay-001"}
             :body {:address "https://93.184.216.34/hooks"}}
   :as :first
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :headers {:idempotency-key "ik-webhook-register-replay-001"}
             :body {:address "https://93.184.216.34/hooks"}}
   :assert {:status 201
            :body {:endpoint {:endpoint-id [:ref :first :endpoint :endpoint-id]}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/webhook-endpoints"
             :auth [:ref :org-0 :token]
             :body {:address "https://93.184.216.34/hooks"}}
   :assert {:status 201}}]
 :then
 ;; Two endpoints: the replayed key's one, and the fresh key's.
 [{:command :api/request
   :request {:method :get :path "/v1/webhook-endpoints" :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:items [{} {}]}}}]}
