{:name "Tenant lists its chart of ledger accounts"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Ledger Test Bank" :status "live"}}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/ledger-accounts" :auth [:ref :org-0 :token]}
   ;; Each account carries the backend-derived posted-balance, and the
   ;; response embeds the per-currency trial-balance (Σ debit vs Σ credit,
   ;; computed server-side in bank-balance). A freshly provisioned bank
   ;; has no funded balances, so GBP ties at zero.
   :assert
   {:status 200
    :body
    {:items
     [:m/embeds
      [{:gl-code "2100"
        :gl-account-class "control"
        :gl-account-type "liability"
        :posted-balance {:currency "GBP"}}
       {:gl-code "1100" :gl-account-class "detail" :gl-account-type "asset"}
       {:gl-code "3100" :gl-account-class "control" :gl-account-type "equity"}]]
     :trial-balance [:m/embeds
                     [{:currency "GBP" :debit 0 :credit 0}]]}}}]}
