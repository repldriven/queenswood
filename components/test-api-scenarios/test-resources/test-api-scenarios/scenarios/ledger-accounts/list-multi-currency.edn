{:name "A multi-currency bank is seeded with the whole chart per currency"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Trilingual Bank"
                 :status "live"
                 :currencies ["EUR" "GBP" "USD"]}}]
 :when
 [{:command :api/request
   :request
   {:method :get :path "/v1/ledger-accounts" :auth [:ref :org-0 :token]}
   ;; The chart is seeded once per requested currency, so the nine rows
   ;; of resources/ledgers/general-ledger.edn come back three times over
   ;; -- twenty-seven in all. Seeding runs under the platform policies,
   ;; so the micro tier's own caps do not thin it out. in-any-order pins
   ;; the count, so a tenth row in any currency fails the match; maps in
   ;; expected position embed, so a row not under scrutiny needs only
   ;; its code and currency. 2400 and 5100 carry their class and type:
   ;; interest payable is a control account and interest expense an
   ;; expense detail account, which is what F6 of the gap analysis
   ;; found the TDDs disagreeing about.
   :assert
   {:status 200
    :body {:items [:m/in-any-order
                   [{:code "1100" :currency "EUR"}
                    {:code "1200" :currency "EUR"}
                    {:code "2100" :currency "EUR"}
                    {:code "2200" :currency "EUR"}
                    {:code "2300" :currency "EUR"}
                    {:code "2400"
                     :currency "EUR"
                     :account-type "control"
                     :account-class "liability"}
                    {:code "2500" :currency "EUR"}
                    {:code "3100" :currency "EUR"}
                    {:code "5100"
                     :currency "EUR"
                     :account-type "detail"
                     :account-class "expense"}
                    {:code "1100"
                     :currency "GBP"
                     :account-type "detail"
                     :account-class "asset"}
                    {:code "1200" :currency "GBP"}
                    {:code "2100"
                     :currency "GBP"
                     :account-type "control"
                     :account-class "liability"
                     :posted-balance {:currency "GBP"}}
                    {:code "2200" :currency "GBP"}
                    {:code "2300" :currency "GBP"}
                    {:code "2400"
                     :currency "GBP"
                     :account-type "control"
                     :account-class "liability"}
                    {:code "2500" :currency "GBP"}
                    {:code "3100"
                     :currency "GBP"
                     :account-type "control"
                     :account-class "equity"}
                    {:code "5100"
                     :currency "GBP"
                     :account-type "detail"
                     :account-class "expense"}
                    {:code "1100" :currency "USD"}
                    {:code "1200" :currency "USD"}
                    {:code "2100" :currency "USD"}
                    {:code "2200" :currency "USD"}
                    {:code "2300" :currency "USD"}
                    {:code "2400"
                     :currency "USD"
                     :account-type "control"
                     :account-class "liability"}
                    {:code "2500" :currency "USD"}
                    {:code "3100" :currency "USD"}
                    {:code "5100"
                     :currency "USD"
                     :account-type "detail"
                     :account-class "expense"}]]
           ;; A freshly provisioned bank has no funded balances, so every
           ;; currency ties at zero on its own.
           :trial-balance [:m/embeds
                           [{:currency "EUR" :debit 0 :credit 0}
                            {:currency "GBP" :debit 0 :credit 0}
                            {:currency "USD" :debit 0 :credit 0}]]}}}]}
