{:name "A refused grant at the token proxy is a 401, not a 500"
 :tags #{:api :auth :oauth :unhappy}
 ;; Keycloak answers a bad secret with a 200-shaped body carrying
 ;; `error` and no `access_token`. Passing that straight through left
 ;; the response failing to coerce against TokenResponse, so the caller
 ;; met a 500 for what is an ordinary authentication failure.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "OAuth Refusal Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201
            :body {:client-id [:m/regex "^bnk\\."]
                   :client-secret [:m/regex ".+"]}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/oauth/token"
             :headers {:content-type "application/x-www-form-urlencoded"}
             :form {:grant_type "client_credentials"
                    :client_id [:ref :org-0 :client-id]
                    :client_secret "wrong"
                    :scope "queenswood-api-live"}}
   :assert {:status 401 :body {:error "invalid_client"}}}]
 :then
 ;; An unknown client is refused the same way.
 [{:command :api/request
   :request {:method :post
             :path "/oauth/token"
             :headers {:content-type "application/x-www-form-urlencoded"}
             :form {:grant_type "client_credentials"
                    :client_id "bnk.no-such-client"
                    :client_secret "wrong"
                    :scope "queenswood-api-live"}}
   :assert {:status 401 :body {:error "invalid_client"}}}]}
