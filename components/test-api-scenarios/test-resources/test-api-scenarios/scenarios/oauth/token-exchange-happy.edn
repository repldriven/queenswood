{:name "Tenant exchanges client_credentials for a JWT and uses it"
 :tags #{:api :happy :oauth}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-token-exchange-happy-bank-001"}
             :body {:name "OAuth Token Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201
            :body {:client-id [:m/regex "^bnk\\."]
                   :client-secret [:m/regex ".+"]}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/oauth/token"
             :headers {:content-type "application/x-www-form-urlencoded"}
             :form {:grant_type "client_credentials"
                    :client_id [:ref :org-0 :client-id]
                    :client_secret [:ref :org-0 :client-secret]
                    :scope "queenswood-api-live"}}
   :as :token-response
   ;; `expires_in` is the lifetime *remaining*, counted from when
   ;; Keycloak issued the token rather than when it serialised the
   ;; response, so an exact 3600 loses a second whenever those fall
   ;; either side of a tick. The tolerance still fails a wrong lifetime.
   :assert {:status 200
            :body {:access_token [:m/regex ".+"]
                   :token_type "Bearer"
                   :expires_in [:m/within-delta 5 3600]}}}]
 :then [;; Bearer the freshly-minted JWT against an org-scoped endpoint
        {:command :api/request
         :request {:method :get
                   :path "/v1/parties"
                   :auth [:ref :token-response :access_token]}
         :assert {:status 200}}]}
