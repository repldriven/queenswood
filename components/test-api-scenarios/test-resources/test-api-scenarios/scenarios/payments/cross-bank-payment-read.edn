{:name "Another bank's payment reads as not found"
 ;; A payment read is scoped to the caller's bank. Bank A submits an
 ;; internal and an outbound payment; bank B's token reads each by id and
 ;; gets the same 404 body a payment that does not exist answers, and bank
 ;; A's token reads each with 200. The outbound pays bank A's own savings
 ;; account by BBAN, so it settles on bank A's books. The debtor is funded
 ;; through the simulated inbound transfer. All amounts in pence.
 :given
 [;; Bank A
  {:fixture :bank :as :bank-a :with {:name "Cross Bank Read A"}}
  {:fixture :product
   :as :product-a
   :with {:token [:ref :bank-a :token] :name "Current"}}
  {:fixture :person
   :as :party-a
   :with {:token [:ref :bank-a :token]
          :display-name "Trillian Astra"
          :given-name "Trillian"
          :family-name "Astra"
          :date-of-birth "1952-03-11"
          :national-insurance "TN556201A"
          :address {:building-number "7"
                    :street "Islington Row"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  {:fixture :account
   :as :debtor-a
   :with {:token [:ref :bank-a :token]
          :party-id [:ref :party-a :party :party-id]
          :product-id [:ref :product-a :product :product-id]
          :name "Current"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-a :token]
             :body {:party-id [:ref :party-a :party :party-id]
                    :name "Savings"
                    :currency "GBP"
                    :product-id [:ref :product-a :product :product-id]}}
   :as :creditor-a
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor-a :account-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200 :body {:account-status "opened"}}
   :as :creditor-a}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-a :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-a :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor-a :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-a :account :account-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}
  ;; Bank B
  {:fixture :bank :as :bank-b :with {:name "Cross Bank Read B"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-a :token]
             :body {:debtor-account-id [:ref :debtor-a :account :account-id]
                    :creditor-account-id [:ref :creditor-a :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "Cross bank internal"}}
   :as :internal
   :assert {:status 201 :body {:bank-id [:ref :bank-a :bank :bank-id]}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-a :token]
             :body {:debtor-account-id [:ref :debtor-a :account :account-id]
                    :creditor-bban [:ref :creditor-a :bban]
                    :creditor-name "Trillian Astra"
                    :currency "GBP"
                    :amount 1500
                    :scheme "fps"
                    :reference "Cross bank outbound"}}
   :as :outbound
   :assert {:status 201 :body {:bank-id [:ref :bank-a :bank :bank-id]}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200 :body {:payment-status "completed"}}
   :timeout-ms 10000}]
 :then
 [;; Bank B reads neither, and cannot tell them from a missing payment.
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/internal/{payment-id}"
             :path-params {:payment-id [:ref :internal :payment-id]}
             :auth [:ref :bank-b :token]}
   :assert {:status 404
            :body [:m/equals {:title "REJECTED"
                              :type ":payment/not-found"
                              :status 404
                              :detail "Payment not found"}]}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth [:ref :bank-b :token]}
   :assert {:status 404
            :body [:m/equals {:title "REJECTED"
                              :type ":payment/not-found"
                              :status 404
                              :detail "Payment not found"}]}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/internal/{payment-id}"
             :path-params {:payment-id "pmt.01kprbmgcj35ptc8npmybhh4s5"}
             :auth [:ref :bank-a :token]}
   :assert {:status 404
            :body [:m/equals {:title "REJECTED"
                              :type ":payment/not-found"
                              :status 404
                              :detail "Payment not found"}]}}
  ;; Bank A reads both.
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/internal/{payment-id}"
             :path-params {:payment-id [:ref :internal :payment-id]}
             :auth [:ref :bank-a :token]}
   :assert {:status 200
            :body {:payment-id [:ref :internal :payment-id]
                   :bank-id [:ref :bank-a :bank :bank-id]
                   :amount 2500
                   :reference "Cross bank internal"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth [:ref :bank-a :token]}
   :assert {:status 200
            :body {:payment-id [:ref :outbound :payment-id]
                   :bank-id [:ref :bank-a :bank :bank-id]
                   :amount 1500
                   :payment-status "completed"}}}]}
