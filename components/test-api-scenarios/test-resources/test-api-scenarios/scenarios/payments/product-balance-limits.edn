{:name "An account holds no less and no more than its product allows"
 ;; The saver's product allows a balance from GBP 50 to GBP 500. A
 ;; payment in that would pass the most is refused, and so is a payment
 ;; out that would leave less than the least. An account opens below its
 ;; least and may always be paid towards it. Amounts in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Balance Limits Bank"}}
  {:fixture :product
   :as :current
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :bank-0 :token]
             :body {:name "Bounded Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 300
                    :min-balance 5000
                    :max-balance 50000
                    :effective-from "2026-01-01"}}
   :as :saver
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :saver :product-id]
                  :version-id [:ref :saver :version-id]}
    :auth [:ref :bank-0 :token]}
   :assert {:status 200}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :funded-account
   :as :everyday
   :with {:bank-id [:ref :bank-0 :bank :bank-id]
          :token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]
          :amount 100000}}
  {:fixture :account
   :as :savings
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :saver :product-id]
          :name "Bounded Saver"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :everyday :opened :account :account-id]
                    :creditor-account-id [:ref :savings :account :account-id]
                    :currency "GBP"
                    :amount 60000
                    :reference "Too much"}}
   :assert
   {:status 429
    :problem {:type ":policy/limit-exceeded"
              :detail
              "The product's accounts hold at most 50000 GBP minor units"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :everyday :opened :account :account-id]
                    :creditor-account-id [:ref :savings :account :account-id]
                    :currency "GBP"
                    :amount 40000
                    :reference "Savings"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :savings :account :account-id]
                    :creditor-account-id [:ref :everyday :opened :account :account-id]
                    :currency "GBP"
                    :amount 38000
                    :reference "Too little left"}}
   :assert
   {:status 429
    :problem {:type ":policy/limit-exceeded"
              :detail
              "The product's accounts hold at least 5000 GBP minor units"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :savings :account :account-id]
                    :creditor-account-id [:ref :everyday :opened :account :account-id]
                    :currency "GBP"
                    :amount 35000
                    :reference "Down to the least"}}
   :assert {:status 201}}]
 :then
 [{:command :api/request
   :request
   {:method :get
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}"
    :path-params {:product-id [:ref :saver :product-id]
                  :version-id [:ref :saver :version-id]}
    :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:min-balance 5000 :max-balance 50000}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :savings :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 5000 :currency "GBP"}}}}]}
