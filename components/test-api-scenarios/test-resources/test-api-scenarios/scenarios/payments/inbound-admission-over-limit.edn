{:name
 "The bank refuses to admit an inbound over the limit for the kind of account it is for"
 :requires #{:inbound-admitted}
 :runs-on {:payment :every}
 ;; Form3 asks the bank to admit each inbound before it settles, and the
 ;; tier allows a current account GBP 100 a payment. One over it is
 ;; refused at admission, which Form3 fails, so nothing arrives and
 ;; nothing is recorded. Balances are in pence.
 :given
 [{:fixture :bank
   :as :bank-0
   :with {:name "Admission Over Limit" :tier "inbound-capped"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}]
 :when
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 101
                    :currency "GBP"
                    :reference "Too large"}}
   :assert {:status 202
            :body {:admission-status "failed"
                   :status-reason "account_closed_terms_and_conditions"}}}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 100
                    :currency "GBP"
                    :reference "Within"}}
   :assert {:status 202 :body {:admission-status "confirmed"}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 10000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "settled"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:items [{:amount 10000 :reference "Within"}]}}}]}
