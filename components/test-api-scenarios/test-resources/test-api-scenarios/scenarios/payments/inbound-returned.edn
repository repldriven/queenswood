{:name "An inbound admitted to an account that closes before it settles is returned"
 :requires #{:inbound-admitted}
 :runs-on {:payment :every}
 ;; Form3 settles an inbound once the bank has admitted it. One admitted
 ;; to an account that closes before it settles is parked in 2500
 ;; suspense, and the bank sends it back: the return is delivered, the
 ;; inbound becomes `returned` for the reason it was parked, and neither
 ;; suspense nor 1100 holds anything of it. Balances are in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Form3 Return" :status "live"}}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :trillian
   :with {:token [:ref :bank-0 :token]
          :display-name "Trillian Astra"
          :given-name "Trillian"
          :family-name "Astra"
          :date-of-birth "1960-03-11"
          :national-insurance "TN555933A"
          :address {:building-number "7"
                    :street "Islington Row"
                    :town "London"
                    :postcode "N1 8QH"
                    :country "GBR"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :trillian :party :party-id]
                    :name "Trillian Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :creditor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "opened"}}
   :as :creditor}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :bban]
                    :amount 7
                    :currency "GBP"
                    :reference "Late"
                    :debtor-name "Late Sender"
                    :settle "held"}}
   :as :inbound
   :assert {:status 202 :body {:admission-status "pending"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:account-status "closing"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "closed"}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-settlement"
             :body {:end-to-end-id [:ref :inbound :endToEndIdentification]}}
   :assert {:status 202 :body {:admission-status "confirmed"}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "returned"}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [{:amount 700
                           :currency "GBP"
                           :payment-status "returned"}]}}
   :timeout-ms 20000}
  {:command :api/request
   :request {:method :get :path "/v1/ledger-accounts" :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:gl-code "1100"
                             :posted-balance {:value 0 :currency "GBP"}}
                            {:gl-code "2500"
                             :posted-balance {:value 0
                                              :currency "GBP"}}]]}}}]}
