{:name "A suspended inbound is listed, read by id, and hidden from another bank"
 :tags #{:api :inbound :payments :unhappy}
 ;; An inbound to a BBAN that matches no account is parked in 2500 suspense
 ;; and recorded `suspended`. The bank lists its suspended inbounds and
 ;; finds the amount and the scheme transaction id, reads the record by id,
 ;; and another bank's token reads the same id as not found.
 ;;
 ;; The setup is `inbound-unmatched-suspense.edn`'s: an outbound to bank A's
 ;; own sort code and an account number no account holds, whose credit leg
 ;; the simulator settles to that BBAN. All amounts in pence.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-isl-bank-a-001"}
             :body {:name "Suspended List A"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-a
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-a :client-id]
         :client-secret [:ref :bank-a :client-secret]
         :status :live}
   :as :bank-a-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-isl-prod-a-001"}
             :body {:name "Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :product-a
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :product-a :product-id]
                  :version-id [:ref :product-a :version-id]}
    :auth :bank-a-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-isl-party-a-001"}
             :body {:type "person"
                    :display-name "Fenchurch Wells"
                    :given-name "Fenchurch"
                    :family-name "Wells"
                    :date-of-birth "1955-06-09"
                    :nationality "GB"
                    :address {:building-number "12"
                              :street "Rickmansworth Road"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN556211A"
                                          :issuing-country "GB"}}}
   :as :party-a
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-a :party-id]}
             :auth :bank-a-token}
   :until {:status 200 :body {:status "active"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-isl-debtor-a-001"}
             :body {:party-id [:ref :party-a :party-id]
                    :name "Fenchurch Current"
                    :currency "GBP"
                    :product-id [:ref :product-a :product-id]}}
   :as :debtor-a
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor-a :account-id]}
             :auth :bank-a-token}
   :until {:status 200 :body {:account-status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/inbound-transfer"
             :path-params {:bank-id [:ref :bank-a :bank-id]}
             :auth :admin
             :headers {:idempotency-key "ik-isl-fund-a-001"}
             :body {:account-id [:ref :debtor-a :account-id]
                    :amount 100000
                    :currency "GBP"}}
   :assert {:status 200}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-a :account-id]}
             :auth :bank-a-token}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-isl-bank-b-001"}
             :body {:name "Suspended List B"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-b
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-b :client-id]
         :client-secret [:ref :bank-b :client-secret]
         :status :live}
   :as :bank-b-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth :bank-a-token
             :headers {:idempotency-key "ik-isl-outbound-001"}
             :body {:debtor-account-id [:ref :debtor-a :account-id]
                    :creditor-bban [:str [:ref :bank-a :sort-code] "99999999"]
                    :creditor-name "Nonexistent Account"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Unmatched inbound"}}
   :assert {:status 200}}]
 :then
 [;; Bank A's only suspended inbound is the unmatched credit.
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth :bank-a-token}
   :until {:status 200
           :body {:items [{:bank-id [:ref :bank-a :bank-id]
                           :amount 2500
                           :currency "GBP"
                           :payment-status "suspended"
                           :scheme-transaction-id [:m/non-empty]}]}}
   :timeout-ms 10000
   :as :suspended}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound/{payment-id}"
             :path-params {:payment-id [:ref :suspended :items 0 :payment-id]}
             :auth :bank-a-token}
   :assert {:status 200
            :body {:payment-id [:ref :suspended :items 0 :payment-id]
                   :bank-id [:ref :bank-a :bank-id]
                   :scheme-transaction-id
                   [:ref :suspended :items 0 :scheme-transaction-id]
                   :amount 2500
                   :payment-status "suspended"}}}
  ;; Bank B cannot read it, and lists no suspended inbound of its own.
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound/{payment-id}"
             :path-params {:payment-id [:ref :suspended :items 0 :payment-id]}
             :auth :bank-b-token}
   :assert {:status 404
            :body [:m/equals {:title "REJECTED"
                              :type "payment/not-found"
                              :status 404
                              :detail "Payment not found"}]}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth :bank-b-token}
   :assert {:status 200 :body {:items []}}}]}
