{:name "A suspended inbound is listed, read by id, and hidden from another bank"
 :requires #{:inbound-notified}
 :runs-on {:payment :every}
 ;; An inbound to an account that cannot take it is parked in 2500
 ;; suspense and recorded `suspended`. The bank lists its suspended
 ;; inbounds and finds the amount and the scheme transaction id, reads the
 ;; record by id, and another bank's token reads the same id as not found.
 ;;
 ;; The inbound is the credit leg of an outbound to a suspended account of
 ;; bank A's, which the simulator settles to that account's BBAN. All
 ;; amounts in pence.
 :given
 [{:fixture :bank :as :bank-a :with {:name "Suspended List A"}}
  {:fixture :product
   :as :product-a
   :with {:token [:ref :bank-a :token] :name "Current"}}
  {:fixture :person
   :as :party-a
   :with {:token [:ref :bank-a :token]
          :display-name "Fenchurch Wells"
          :legal-name "Fenchurch Wells"}}
  {:fixture :account
   :as :debtor-a
   :with {:token [:ref :bank-a :token]
          :party-id [:ref :party-a :party :party-id]
          :product-id [:ref :product-a :product :product-id]
          :name "Fenchurch Current"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-a :bank :bank-id]}
             :body {:amount 100000 :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-a :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor-a :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-a :account :account-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-a :token]
             :body {:party-id [:ref :party-a :party :party-id]
                    :name "Fenchurch Savings"
                    :currency "GBP"
                    :product-id [:ref :product-a :product :product-id]}}
   :as :suspended-a
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :suspended-a :account-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :suspended-a}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :suspended-a :account-id]}
             :auth [:ref :bank-a :token]}
   :assert {:status 200}}
  {:fixture :bank :as :bank-b :with {:name "Suspended List B"}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-a :token]
             :body {:debtor-account-id [:ref :debtor-a :account :account-id]
                    :creditor-bban [:ref :suspended-a :bban]
                    :creditor-name "Fenchurch Wells"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "Inbound to a suspended account"}}
   :assert {:status 201}}]
 :then
 [;; Bank A's only suspended inbound is the parked credit.
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth [:ref :bank-a :token]}
   :until
   {:status 200
    :body {:items [{:bank-id [:ref :bank-a :bank :bank-id]
                    :amount 2500
                    :currency "GBP"
                    :status "suspended"
                    :scheme-transaction-id [:m/non-empty]}]}}
   :timeout-ms 10000
   :as :suspended}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound/{payment-id}"
             :path-params {:payment-id [:ref :suspended :items 0 :payment-id]}
             :auth [:ref :bank-a :token]}
   :assert {:status 200
            :body {:payment-id [:ref :suspended :items 0 :payment-id]
                   :bank-id [:ref :bank-a :bank :bank-id]
                   :scheme-transaction-id [:ref :suspended :items 0
                                           :scheme-transaction-id]
                   :amount 2500
                   :status "suspended"}}}
  ;; Bank B cannot read it, and lists no suspended inbound of its own.
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound/{payment-id}"
             :path-params {:payment-id [:ref :suspended :items 0 :payment-id]}
             :auth [:ref :bank-b :token]}
   :assert {:status 404
            :body [:m/equals
                   {:title "REJECTED"
                    :type ":payment/not-found"
                    :status 404
                    :detail "Payment not found"}]}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth [:ref :bank-b :token]}
   :assert {:status 200 :body {:items []}}}]}
