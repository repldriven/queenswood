{:name "An inbound the provider does not send back stays suspended, saying why"
 :requires #{:inbound-admitted}
 :runs-on {:payment :every}
 :tags #{:serial}
 ;; As inbound-returned, but the simulator fails the return: the inbound
 ;; stays parked in 2500 suspense, carrying the provider's reason.
 ;; Balances are in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Return Failed" :status "live"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}]
 :when
 [{:command :api/request
   :request
   {:method :post :base :payment-simulator :path "/simulate/return-refused"}
   :assert {:status 204}}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 7
                    :currency "GBP"
                    :reference "Not returned"
                    :debtor-name "Late Sender"
                    :settle "held"}}
   :as :inbound
   :assert {:status 202 :body {:admission-status "pending"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:account-status "closing"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "closed"}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-settlement"
             :body {:end-to-end-id [:ref :inbound :endToEndIdentification]}}
   :assert {:status 202 :body {:admission-status "confirmed"}}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth [:ref :bank-0 :token]}
   :until
   {:status 200
    :body {:items [{:amount 700
                    :currency "GBP"
                    :payment-status "suspended"
                    :return-failure-reason [:m/regex ".+"]}]}}
   :timeout-ms 20000}
  {:command :api/request
   :request
   {:method :get :path "/v1/ledger-accounts" :auth [:ref :bank-0 :token]}
   :assert
   {:status 200
    :body {:items [:m/embeds
                   [{:gl-code "2500"
                     :posted-balance {:value 700 :currency "GBP"}}]]}}}]}
