{:name "An inbound held for screening, then returned, credits no one"
 :requires #{:inbound-notified}
 :runs-on {:payment :every}
 ;; A test value every payment simulator shares: an inbound whose debtor
 ;; name is 6a41a29eafcf455493 is held for screening. The simulator then resolves it
 ;; by the request's `outcome`, here a return, whose rejection carries the
 ;; creditor's BBAN. The payment events record the hold `held` and, on the
 ;; return, move that record to `returned`; no money reaches the bank's
 ;; books. The simulator's amount is in pounds; balances are in pence.
 :given
 [{:fixture :bank
   :as :bank-0
   :with {:name "Inbound Held Returned" :status "live"}}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :party
   :with {:token [:ref :bank-0 :token]
          :display-name "Eddie Shipboard"
          :given-name "Eddie"
          :family-name "Shipboard"
          :date-of-birth "1958-08-08"
          :national-insurance "TN556231A"
          :address {:building-number "4"
                    :street "Magrathea Lane"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :party :party :party-id]
                    :name "Eddie Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :creditor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "opened"}}
   :as :creditor}]
 :when
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :bban]
                    :amount 25
                    :currency "GBP"
                    :reference "Held then returned"
                    :debtor-name "6a41a29eafcf455493"
                    :outcome "return"}}
   :as :inbound
   :assert {:status 202}}]
 :then
 [;; The held record, now returned, is the bank's only returned inbound.
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "returned"}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items
                  [{:end-to-end-id [:ref :inbound :endToEndIdentification]
                    :bank-id [:ref :bank-0 :bank :bank-id]
                    :creditor-account-id [:ref :creditor :account-id]
                    :amount 2500
                    :currency "GBP"
                    :payment-status "returned"}]}}
   :timeout-ms 10000
   :as :returned}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound/{payment-id}"
             :path-params {:payment-id [:ref :returned :items 0 :payment-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:payment-id [:ref :returned :items 0 :payment-id]
                   :end-to-end-id [:ref :inbound :endToEndIdentification]
                   :payment-status "returned"}}}
  ;; Nothing is left held or settled, and no money reached the creditor.
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "held"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:items []}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "settled"}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:items []}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 0 :currency "GBP"}}}
   :timeout-ms 10000}]}
