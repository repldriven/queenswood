{:name "Inbound to an unmatched account lands in 2500 suspense"
 :tags #{:api :inbound :payments :unhappy}
 ;; An inbound for a BBAN that matches no account must not be lost. The
 ;; owning bank is resolved from the BBAN's sort code, and the funds are
 ;; parked in its 2500 suspense GL account (DEBIT 1100 / CREDIT 2500)
 ;; pending reconciliation.
 ;;
 ;; We trigger it via an outbound payment whose creditor BBAN is the
 ;; bank's own sort code + a bogus account number: the simulator fires a
 ;; credit-settled to that BBAN, which settle-inbound can't match to an
 ;; account, so it suspends. All amounts in pence.
 :given
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth :admin
    :headers {:idempotency-key "ik-inbound-unmatched-suspense-bank-001"}
    :body
    {:name "Suspense Test" :status "live" :tier "micro" :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-0 :client-id]
         :client-secret [:ref :bank-0 :client-secret]
         :status :live}
   :as :bank-0-token}
  ;; The seeded chart of accounts — used to find the 2500 account id.
  {:command :api/request
   :request {:method :get :path "/v1/ledger-accounts" :auth :bank-0-token}
   :as :ledgers
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-inbound-unmatched-prod-001"}
             :body {:name "Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :current-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :current-draft :product-id]
                  :version-id [:ref :current-draft :version-id]}
    :auth :bank-0-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-sus-create-party"}
             :body {:type "person"
                    :display-name "Marvin Android"
                    :given-name "Marvin"
                    :family-name "Android"
                    :date-of-birth "1949-01-01"
                    :nationality "GB"
                    :address {:building-number "1"
                              :street "Paranoid Way"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN555300F"
                                          :issuing-country "GB"}}}
   :as :party
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party :party-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:status "active"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-sus-open-debtor"}
             :body {:party-id [:ref :party :party-id]
                    :name "Marvin Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :debtor
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}
   :as :debtor}
  ;; Fund the debtor so the outbound can leave.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/inbound-transfer"
             :path-params {:bank-id [:ref :bank-0 :bank-id]}
             :auth :admin
             :headers {:idempotency-key "ik-sus-fund-debtor"}
             :body {:account-id [:ref :debtor :account-id]
                    :amount 100000
                    :currency "GBP"}}
   :assert {:status 200}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 ;; Outbound to <bank-0 sort code> + a bogus account number. The
 ;; simulator's credit-settled to this BBAN has no matching account.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-sus-outbound-001"}
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban [:str [:ref :bank-0 :sort-code] "99999999"]
                    :creditor-name "Nonexistent Account"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Unmatched inbound"}}
   :assert {:status 200}}]
 :then
 ;; The unmatched credit lands in bank-0's 2500 suspense account.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/ledger-accounts/{account-id}/balances"
             :path-params {:account-id [:ref-find :ledgers :ledger-accounts
                                        :gl-code "2500" :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:balances [:m/embeds [{:credit 2500 :debit 0}]]}}
   :timeout-ms 10000}]}
