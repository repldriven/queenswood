{:name "An outbound refused in the submission response fails and is reversed"
 :runs-on {:payment :every}
 ;; A test value every payment simulator shares: the provider refuses a
 ;; submission to a creditor sort code of 999998, and sends no webhook.
 ;; The relay fails the intent on that attempt and writes a
 ;; transaction-rejected event, refused, so the payment brick reverses the
 ;; reservation and the payment reads "failed". The debtor is funded
 ;; through the simulator's inbound payment, whose amount is in pounds.
 ;; Balances are in pence.
 :given
 [{:fixture :bank
   :as :bank-0
   :with {:name "Outbound Submission Refused" :status "live"}}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :slartibartfast
   :with {:token [:ref :bank-0 :token]
          :display-name "Slartibartfast Magrathea"
          :legal-name "Slartibartfast Magrathea"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :slartibartfast :party :party-id]
                    :name "Slartibartfast Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :debtor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :debtor}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :debtor :bban]
                    :amount 1000
                    :currency "GBP"
                    :reference "Submission refused funding"
                    :debtor-name "Funding Sender"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}
   :timeout-ms 10000}]
 :when
 ;; Outbound £25 to a creditor whose sort code (999998) the simulator
 ;; refuses. The submission reserves the amount before the relay sends it.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "99999800000001"
                    :creditor-name "Refused Creditor"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Submission refused"}}
   :as :payment
   :assert {:status 201 :body {:payment-status "pending"}}}]
 :then
 ;; The payment fails with the refusal code, and the £25 returns to the
 ;; debtor's available balance, which was never posted away.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-status "failed"
                  :failure {:kind "refused" :reason-code "NARR"}}}
   :timeout-ms 10000}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:posted-balance {:value 100000 :currency "GBP"}
                  :available-balance {:value 100000 :currency "GBP"}}}
   :timeout-ms 10000}]}
