{:name
 "The bank admits an inbound to an opened account, and refuses one to a suspended account"
 :requires #{:inbound-admitted}
 :runs-on {:payment :every}
 ;; Form3 asks the bank to admit each inbound before it settles. One to
 ;; an opened account is admitted and credited. Once the account is
 ;; suspended the bank refuses the next, which Form3 fails as a blocked
 ;; account, and the balance does not move. Balances are in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Form3 Admission" :status "live"}}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :trillian
   :with {:token [:ref :bank-0 :token]
          :display-name "Trillian Astra"
          :legal-name "Trillian Astra"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :trillian :party :party-id]
                    :name "Trillian Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :creditor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :creditor}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :bban]
                    :amount 25
                    :currency "GBP"
                    :reference "Admitted"
                    :debtor-name "Admitted Sender"}}
   :assert {:status 202 :body {:admission-status "confirmed"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:posted-balance {:value 2500 :currency "GBP"}}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/suspend"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:status "suspended"}}}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :bban]
                    :amount 10
                    :currency "GBP"
                    :reference "Refused"
                    :debtor-name "Refused Sender"}}
   :assert {:status 202
            :body {:admission-status "failed"
                   :status-reason "blocked_account"}}}]
 :then [{:command :api/request
         :request {:method :get
                   :path "/v1/cash-accounts/{account-id}/balances"
                   :path-params {:account-id [:ref :creditor :account-id]}
                   :auth [:ref :bank-0 :token]}
         :assert {:status 200
                  :body {:posted-balance {:value 2500 :currency "GBP"}}}}]}
