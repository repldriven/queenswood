{:name
 "An inbound payment is held to the limits of the kind of account it is for"
 :requires #{:inbound-notified}
 :runs-on {:payment :every}
 ;; The tier allows a current account GBP 100 a payment and GBP 150 a
 ;; day, and own funds two payments a day. Money that has arrived is
 ;; never refused, so a payment over a limit is parked in suspense with
 ;; the limit's reason, and the account is credited only with what its
 ;; limits allow. Balances are in pence.
 :given
 [{:fixture :bank
   :as :bank-0
   :with {:name "Inbound By Product Type" :tier "inbound-capped"}}
  {:fixture :product :as :current :with {:token [:ref :bank-0 :token]}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :current :product :product-id]}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :bank-0 :bank :accounts 0
                                        :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :own-funds}]
 :when
 ;; Within the current account's limits.
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 50
                    :currency "GBP"
                    :reference "Within"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 5000 :currency "GBP"}}}}
  ;; Over GBP 100 in one payment.
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 101
                    :currency "GBP"
                    :reference "Too large"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [{:amount 10100
                           :reference "Too large"
                           :suspended-reason-code "AG01"}]}}}
  ;; The parked payment is no part of the day's value, so GBP 100 more
  ;; reaches the daily limit exactly.
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 100
                    :currency "GBP"
                    :reference "To the limit"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 15000 :currency "GBP"}}}}
  ;; One more pound is over GBP 150 for the day.
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :account :bban]
                    :amount 1
                    :currency "GBP"
                    :reference "Over the day"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [:m/in-any-order
                          [{:reference "Too large"}
                           {:amount 100
                            :reference "Over the day"
                            :suspended-reason-code "AG01"}]]}}}
  ;; Own funds are counted apart from the current account: two payments
  ;; arrive, and the day's third is parked.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth [:ref :bank-0 :token]
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 1000 :currency "GBP"}}
   :assert {:status 202}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth [:ref :bank-0 :token]
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 1000 :currency "GBP"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :own-funds :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 2000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth [:ref :bank-0 :token]
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 1000 :currency "GBP"}}
   :assert {:status 202}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/inbound"
             :query-params {"status" "suspended"}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:items [:m/in-any-order
                          [{:reference "Too large"}
                           {:reference "Over the day"}
                           {:amount 1000
                            :reference "Simulated inbound transfer"
                            :suspended-reason-code "AG01"
                            :suspended-reason [:m/regex "own funds"]}]]}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 15000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :own-funds :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200
            :body {:available-balance {:value 2000 :currency "GBP"}}}}]}
