{:name "An inbound of 0.29 credits exactly 29 pence"
 :runs-on {:payment :every}
 ;; The payment simulator's inbound payment carries its amount in pounds,
 ;; and the adapter converts the webhook's Amount to minor units. 0.29 is
 ;; the value a floating-point conversion truncates to 28, so an empty
 ;; account's posted balance must land on 29 exactly. Balances are in
 ;; pence.
 :given
 [{:fixture :bank
   :as :bank-0
   :with {:name "Inbound Pence Amount" :status "live"}}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :trillian
   :with {:token [:ref :bank-0 :token]
          :display-name "Trillian Astra"
          :legal-name "Trillian Astra"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :trillian :party :party-id]
                    :name "Trillian Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :creditor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "opened"}}
   :as :creditor}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :creditor :bban]
                    :amount 0.29
                    :currency "GBP"
                    :reference "Pence amount"
                    :debtor-name "Pence Sender"}}
   :assert {:status 202}}]
 :then [{:command :api/poll
         :request {:method :get
                   :path "/v1/cash-accounts/{account-id}/balances"
                   :path-params {:account-id [:ref :creditor :account-id]}
                   :auth [:ref :bank-0 :token]}
         :until {:status 200
                 :body {:posted-balance {:value 29 :currency "GBP"}
                        :available-balance {:value 29 :currency "GBP"}}}
         :timeout-ms 10000}]}
