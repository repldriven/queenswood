{:name "An internal payment submitted twice under one key is one payment"
 :tags #{:api :idempotency :payments :happy}
 ;; The second submission never reaches the handler: the cache answers
 ;; it from the first. Same status, same body, same payment id — so the
 ;; debtor is debited once. The replay says so in its headers: the
 ;; first answer carries no `Idempotent-Replayed`, the second carries
 ;; it set to "true", and this file asserts both.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-internal-replay-bank-001"}
             :body {:name "Internal Replay Test"
                    :status "test"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-0 :client-id]
         :client-secret [:ref :bank-0 :client-secret]
         :status :test}
   :as :bank-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-prod-001"}
             :body {:name "Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :product
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :product :product-id]
                  :version-id [:ref :product :version-id]}
    :auth :bank-0-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-party-001"}
             :body {:type "person"
                    :display-name "Ford Prefect"
                    :given-name "Ford"
                    :family-name "Prefect"
                    :date-of-birth "1952-03-11"
                    :nationality "GB"
                    :address {:building-number "17"
                              :street "Betelgeuse Way"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN555201A"
                                          :issuing-country "GB"}}}
   :as :ford
   :assert {:status 201 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :ford :party-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:status "active"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-debtor-001"}
             :body {:party-id [:ref :ford :party-id]
                    :name "Ford Current"
                    :currency "GBP"
                    :product-id [:ref :product :product-id]}}
   :as :debtor
   :assert {:status 201 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-creditor-001"}
             :body {:party-id [:ref :ford :party-id]
                    :name "Ford Savings"
                    :currency "GBP"
                    :product-id [:ref :product :product-id]}}
   :as :creditor
   :assert {:status 201 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :creditor :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  ;; Fund the debtor with £1,000 from outside.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-0 :bank-id]
                       :idempotency-key "ik-internal-replay-fund-001"}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-fund-001-pay"}
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-payment-001"}
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-account-id [:ref :creditor :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "First submission"}}
   :as :payment
   ;; The first submission ran the handler, so it is not a replay.
   :assert {:status 201 :headers {:idempotent-replayed [:m/absent]}}}]
 :then
 ;; The same key and the same body: answered from the cache, marked as
 ;; a replay, so the payment id is the first one's.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-internal-replay-payment-001"}
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-account-id [:ref :creditor :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "First submission"}}
   :assert {:status 201
            :headers {:idempotent-replayed "true"}
            :body {:payment-id [:ref :payment :payment-id]
                   :amount 2500}}}
  ;; Debited once, not twice.
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200
           :body {:available-balance {:value 97500 :currency "GBP"}}}}]}
