{:name "A lost reply is retried under the same key and pays once"
 ;; The command commits and its reply never arrives, so the API answers
 ;; 500 and the cache releases its claim rather than caching a failure.
 ;; The retry under the same key therefore runs the handler again --
 ;; it is not a replay, and carries no replay header -- and the
 ;; processor's own idempotency is what keeps it to one payment.
 ;;
 ;; The lost reply is produced by a test-only seam keyed on the
 ;; `ik-lost-reply-` prefix; see `test_api_scenarios/fault.clj`.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Internal Lost Reply Test"}}
  {:fixture :product
   :as :product
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :party
   :with {:token [:ref :bank-0 :token]
          :display-name "Tricia McMillan"
          :given-name "Tricia"
          :family-name "McMillan"}}
  {:fixture :account
   :as :debtor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :party :party :party-id]
          :product-id [:ref :product :product :product-id]
          :name "Current"}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :party :party :party-id]
          :product-id [:ref :product :product :product-id]
          :name "Savings"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 100000 :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-internal-001"}
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-account-id [:ref :creditor :account :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "Lost reply"}}
   :assert {:status 500}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-lost-reply-internal-001"}
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-account-id [:ref :creditor :account :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "Lost reply"}}
   :as :retry
   ;; The claim was released, so this ran rather than replayed.
   :assert {:status 201 :headers {:idempotent-replayed [:m/absent]}}}]
 :then [{:command :api/poll
         :request {:method :get
                   :path "/v1/cash-accounts/{account-id}/balances"
                   :path-params
                   {:account-id [:ref :debtor :account :account-id]}
                   :auth [:ref :bank-0 :token]}
         :until {:status 200
                 :body {:available-balance {:value 97500 :currency "GBP"}}}}
        {:command :api/request
         :request {:method :get
                   :path "/v1/payments/internal/{payment-id}"
                   :path-params {:payment-id [:ref :retry :payment-id]}
                   :auth [:ref :bank-0 :token]}
         :assert {:status 200 :body {:amount 2500 :reference "Lost reply"}}}]}
