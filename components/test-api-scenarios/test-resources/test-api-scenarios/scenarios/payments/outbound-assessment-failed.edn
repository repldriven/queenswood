{:name "Outbound rejected at message assessment — funds reversed"
 :runs-on {:payment :every}
 ;; A test value every payment simulator shares: a creditor sort code of
 ;; 000000 is declined before settlement. The adapter reports it as a
 ;; transaction-rejected event, so the payment brick reverses the
 ;; in-flight legs (DEBIT 1200 / CREDIT debtor) and flips the payment to
 ;; "failed", declined.
 ;; All amounts in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Assessment Fail Test"}}
  ;; Current product (0 bps), published.
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  ;; Party → active.
  {:fixture :person
   :as :trillian
   :with {:token [:ref :bank-0 :token]
          :display-name "Trillian Astra"
          :given-name "Trillian"
          :family-name "Astra"
          :date-of-birth "1958-09-03"
          :national-insurance "TN555101D"
          :address {:building-number "42"
                    :street "Improbability Drive"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  ;; Debtor account → opened.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :trillian :party :party-id]
                    :name "Trillian Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :debtor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:account-status "opened"}}
   :as :debtor}
  ;; Fund the debtor with £1,000 from outside.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 ;; Outbound £25 to a creditor whose sort code (000000) fails assessment.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "00000000000001"
                    :creditor-name "Unreachable Creditor"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Assessment failure"}}
   :as :payment
   :assert {:status 201}}]
 :then
 ;; The payment lands on "failed", declined, and the £25 returns to the
 ;; debtor.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-status "failed"
                  :failure {:kind "declined" :reason-code "NARR"}}}
   :timeout-ms 10000}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}
   :timeout-ms 10000}]}
