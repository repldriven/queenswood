{:name "A completed payment the beneficiary's bank sends back is returned"
 :tags #{:api :outbound :payments :unhappy :outbound-returned}
 ;; An outbound to another bank completes, then that bank returns it,
 ;; coded AC01: the payment reads returned with the reason, the debtor is
 ;; credited again as an outbound-return, and a second return of the same
 ;; payment is refused by the scheme. All amounts in pence.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-outbound-returned-bank-001"}
             :body {:name "Outbound Returned Test Org"
                    :status "test"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :test}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :org-0-token
             :headers {:idempotency-key "ik-outbound-returned-party"}
             :body {:type "person"
                    :display-name "Returned Payment Holder"
                    :given-name "Returned"
                    :family-name "Holder"
                    :date-of-birth "1970-01-01"
                    :nationality "GB"
                    :address {:building-number "155"
                              :street "Country Lane"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN889012A"
                                          :issuing-country "GB"}}}
   :as :party-0
   :assert {:status 201 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :party-0 :party-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:status "active"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-outbound-returned-prod-001"}
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :draft :product-id]
                  :version-id [:ref :draft :version-id]}
    :auth :org-0-token}
   :assert {:status 200 :body {:status "published"}}}
  {:command :api/request
   :request {:method :get :path "/v1/ledger-accounts" :auth :org-0-token}
   :as :ledgers
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :org-0-token
             :headers {:idempotency-key "ik-outbound-returned-open-debtor"}
             :body {:party-id [:ref :party-0 :party-id]
                    :name "Funded Debtor"
                    :currency "GBP"
                    :product-id [:ref :draft :product-id]}}
   :as :debtor
   :assert {:status 201 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:account-status "opened"}}}
  ;; Fund the debtor so the outbound can leave.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :org-0 :bank-id]
                       :idempotency-key "ik-outbound-returned-fund"}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth :org-0-token
             :headers {:idempotency-key "ik-outbound-returned-fund-pay"}
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :org-0-token}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth :org-0-token
             :headers {:idempotency-key "ik-outbound-returned-outbound"}
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Marvin"
                    :currency "GBP"
                    :amount 4200
                    :scheme "fps"
                    :reference "Sent back"}}
   :as :outbound
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth :org-0-token}
   :until {:status 200 :body {:payment-status "completed"}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/outbound-return"
             :body {:end-to-end-id [:ref :outbound :payment-id]
                    :reason-code "AC01"}}
   :assert {:status 202}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth :org-0-token}
   :until {:status 200
           :body {:payment-status "returned"
                  :return {:reason-code "AC01"}}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:posted-balance {:value 100000 :currency "GBP"}
                   :available-balance {:value 100000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :org-0-token}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:reference "Sent back"
                             :transaction-type "outbound-return"
                             :side "credit"
                             :amount 4200}]]}}}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/outbound-return"
             :body {:end-to-end-id [:ref :outbound :payment-id]}}
   :assert {:status 409}}]}
