{:name "A completed payment the beneficiary's bank sends back is returned"
 :requires #{:outbound-returned}
 :runs-on {:payment :every}
 ;; An outbound to another bank completes, then that bank returns it,
 ;; coded AC01: the payment reads returned with the reason, the debtor is
 ;; credited again as an outbound-return, and a second return of the same
 ;; payment is refused by the scheme. All amounts in pence.
 :given
 [{:fixture :bank :as :org-0 :with {:name "Outbound Returned Test Org"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Returned Payment Holder"
          :given-name "Returned"
          :family-name "Holder"
          :national-insurance "TN889012A"}}
  {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
  {:command :api/request
   :request {:method :get :path "/v1/ledger-accounts" :auth [:ref :org-0 :token]}
   :as :ledgers
   :assert {:status 200}}
  {:fixture :account
   :as :debtor
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :draft :product :product-id]
          :name "Funded Debtor"}}
  ;; Fund the debtor so the outbound can leave.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-bban "20000012345678"
                    :creditor-name "Marvin"
                    :currency "GBP"
                    :amount 4200
                    :scheme "fps"
                    :reference "Sent back"}}
   :as :outbound
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:payment-status "completed"}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/outbound-return"
             :body {:end-to-end-id [:ref :outbound :payment-id]
                    :reason-code "AC01"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:payment-status "returned"
                  :return {:reason-code "AC01"}}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:posted-balance {:value 100000 :currency "GBP"}
                   :available-balance {:value 100000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:reference "Sent back"
                             :transaction-type "outbound-return"
                             :side "credit"
                             :amount 4200}]]}}}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/outbound-return"
             :body {:end-to-end-id [:ref :outbound :payment-id]}}
   :assert {:status 409}}]}
