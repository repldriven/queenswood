{:name "Outbound held by the scheme, then declined — funds reversed"
 :tags #{:api :outbound :payments :unhappy}
 ;; ClearBank's documented sandbox trigger: an outbound Faster Payment
 ;; whose creditor Name is 6a41a29eafcf455493 is held for screening
 ;; (OutboundHeldTransaction), then declined — funds returned and a
 ;; TransactionRejected webhook with CancellationCode HOPRJ. The
 ;; bank-payment event-processor reverses the in-flight legs (DEBIT 1200
 ;; pending-outbound / CREDIT debtor) and flips the payment to "failed".
 ;;
 ;; The submission debits the debtor's posted balance into 1200 at once,
 ;; so the £25 leaves available immediately and returns on the reversal.
 ;; All amounts in pence.
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-outbound-held-then-bank-001"}
             :body {:name "Outbound Decline Test"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :bank-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-0 :client-id]
         :client-secret [:ref :bank-0 :client-secret]
         :status :live}
   :as :bank-0-token}
  ;; Current product (0 bps), published.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-outbound-held-then-prod-001"}
             :body {:name "Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :current-draft
   :assert {:status 201 :body {:status "draft"}}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :current-draft :product-id]
                  :version-id [:ref :current-draft :version-id]}
    :auth :bank-0-token}
   :assert {:status 200 :body {:status "published"}}}
  ;; Party → active (Onfido sim auto-passes non-"Reject" names).
  {:command :api/request
   :request {:method :post
             :path "/v1/parties"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-obd-create-party"}
             :body {:type "person"
                    :display-name "Zaphod Beeblebrox"
                    :given-name "Zaphod"
                    :family-name "Beeblebrox"
                    :date-of-birth "1949-02-11"
                    :nationality "GB"
                    :address {:building-number "42"
                              :street "Improbability Drive"
                              :town "Cottington"
                              :postcode "CT12 4XY"
                              :country "GBR"}
                    :national-identifier {:type "national-insurance"
                                          :value "TN555100C"
                                          :issuing-country "GB"}}}
   :as :zaphod
   :assert {:status 200 :body {:status "pending"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/parties/{party-id}"
             :path-params {:party-id [:ref :zaphod :party-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:status "active"}}}
  ;; Debtor account → opened.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-obd-open-debtor"}
             :body {:party-id [:ref :zaphod :party-id]
                    :name "Zaphod Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product-id]}}
   :as :debtor
   :assert {:status 200 :body {:account-status "opening"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200 :body {:account-status "opened"}}
   :as :debtor}
  ;; Fund the debtor with £1,000 from outside.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/banks/{bank-id}/inbound-transfer"
             :path-params {:bank-id [:ref :bank-0 :bank-id]}
             :auth :admin
             :headers {:idempotency-key "ik-obd-fund-debtor"}
             :body {:account-id [:ref :debtor :account-id]
                    :amount 100000
                    :currency "GBP"}}
   :assert {:status 200}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 ;; Outbound £25 to a creditor whose name triggers the held→decline path.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth :bank-0-token
             :headers {:idempotency-key "ik-obd-outbound-001"}
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "04000400000001"
                    :creditor-name "6a41a29eafcf455493"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Held then declined"}}
   :as :payment
   :assert {:status 200}}]
 :then
 ;; The payment is held for screening and then declined: it lands on
 ;; "failed" with the HOPRJ cancellation code, and the £25 returns to
 ;; the debtor's available balance.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth :bank-0-token}
   :until {:status 200
           :body {:payment-status "failed" :cancellation-code "HOPRJ"}}
   :timeout-ms 10000}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth :bank-0-token}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}
   :timeout-ms 10000}]}
