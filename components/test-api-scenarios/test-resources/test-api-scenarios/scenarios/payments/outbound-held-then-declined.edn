{:name "Outbound held by the scheme, then declined — funds reversed"
 :requires #{:screened}
 :runs-on {:payment :every}
 ;; A test value every payment simulator shares: an outbound Faster
 ;; Payment whose creditor name is 6a41a29eafcf455493 is held for
 ;; screening, then declined, which the adapter reports as a decline coded
 ;; NARR. The bank-payment event-processor reverses the in-flight legs
 ;; (DEBIT 1200 pending-outbound / CREDIT debtor) and flips the payment to
 ;; "failed".
 ;;
 ;; The submission debits the debtor's posted balance into 1200 at once,
 ;; so the £25 leaves available immediately and returns on the reversal.
 ;; All amounts in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Outbound Decline Test"}}
  ;; Current product (0 bps), published.
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  ;; Party → active once the person shows a matching document.
  {:fixture :person
   :as :zaphod
   :with {:token [:ref :bank-0 :token]
          :display-name "Zaphod Beeblebrox"
          :legal-name "Zaphod Beeblebrox"}}
  ;; Debtor account → opened.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :zaphod :party :party-id]
                    :name "Zaphod Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :debtor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :debtor}
  ;; Fund the debtor with £1,000 from outside.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 100000 :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 ;; Outbound £25 to a creditor whose name triggers the held→decline path.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "6a41a29eafcf455493"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Held then declined"}}
   :as :payment
   :assert {:status 201}}]
 :then
 ;; The payment is held for screening and then declined: it lands on
 ;; "failed" as a decline coded NARR, and the £25 returns to
 ;; the debtor's available balance.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-status "failed"
                  :failure {:kind "declined" :reason-code "NARR"}}}
   :timeout-ms 10000}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}
   :timeout-ms 10000}]}
