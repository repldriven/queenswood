{:name "Two banks reusing one idempotency key each get their own payment"
 :runs-on {:payment :every}
 ;; The F1 collision, through HTTP. A payment's idempotency key is
 ;; unique within a bank, not across the platform: two tenants that
 ;; pick the same key each get their own payment, and neither is
 ;; refused nor handed the other's.
 :given
 [
  ;; Bank A
  {:fixture :bank :as :bank-a :with {:name "Payments Key Scope A"}}
  {:fixture :product
   :as :product-a
   :with {:token [:ref :bank-a :token] :name "Current"}}
  {:fixture :person
   :as :party-a
   :with {:token [:ref :bank-a :token]
          :date-of-birth "1950-07-27"
          :national-insurance "TN555401D"
          :address {:building-number "155"
                    :street "Improbability Drive"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  {:fixture :account
   :as :debtor-a
   :with {:token [:ref :bank-a :token]
          :party-id [:ref :party-a :party :party-id]
          :product-id [:ref :product-a :product :product-id]
          :name "Current"}}
  {:fixture :account
   :as :creditor-a
   :with {:token [:ref :bank-a :token]
          :party-id [:ref :party-a :party :party-id]
          :product-id [:ref :product-a :product :product-id]
          :name "Savings"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-a :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-a :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor-a :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-a :account :account-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}
  ;; Bank B
  {:fixture :bank :as :bank-b :with {:name "Payments Key Scope B"}}
  {:fixture :product
   :as :product-b
   :with {:token [:ref :bank-b :token] :name "Current"}}
  {:fixture :person
   :as :party-b
   :with {:token [:ref :bank-b :token]
          :display-name "Marvin Android"
          :given-name "Marvin"
          :family-name "Android"
          :date-of-birth "1961-11-04"
          :national-insurance "TN555402E"
          :address {:building-number "42"
                    :street "Improbability Drive"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  {:fixture :account
   :as :debtor-b
   :with {:token [:ref :bank-b :token]
          :party-id [:ref :party-b :party :party-id]
          :product-id [:ref :product-b :product :product-id]
          :name "Current"}}
  {:fixture :account
   :as :creditor-b
   :with {:token [:ref :bank-b :token]
          :party-id [:ref :party-b :party :party-id]
          :product-id [:ref :product-b :product :product-id]
          :name "Savings"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-b :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-2
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-b :token]
             :body {:debtor-account-id [:ref :funded-2 :account-id]
                    :creditor-account-id [:ref :debtor-b :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-b :account :account-id]}
             :auth [:ref :bank-b :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}
  ]
 :when
 ;; The same key literal, sent by two different principals.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-a :token]
             :headers {:idempotency-key "ik-payments-shared-key-001"}
             :body {:debtor-account-id [:ref :debtor-a :account :account-id]
                    :creditor-account-id [:ref :creditor-a :account :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "Bank A payment"}}
   :as :payment-a
   :assert {:status 201 :body {:bank-id [:ref :bank-a :bank :bank-id]
                               :amount 2500
                               :reference "Bank A payment"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-b :token]
             :headers {:idempotency-key "ik-payments-shared-key-001"}
             :body {:debtor-account-id [:ref :debtor-b :account :account-id]
                    :creditor-account-id [:ref :creditor-b :account :account-id]
                    :currency "GBP"
                    :amount 7100
                    :reference "Bank B payment"}}
   :as :payment-b
   :assert {:status 201 :body {:bank-id [:ref :bank-b :bank :bank-id]
                               :amount 7100
                               :reference "Bank B payment"}}}]
 :then
 ;; Two payments, not one replayed. B's answer is B's own — a different
 ;; amount and reference than A's, which a replay could not produce.
 [{:command :api/request
   :request {:method :get
             :path "/v1/payments/internal/{payment-id}"
             :path-params {:payment-id [:ref :payment-a :payment-id]}
             :auth [:ref :bank-a :token]}
   :assert {:status 200
            :body {:payment-id [:ref :payment-a :payment-id]
                   :bank-id [:ref :bank-a :bank :bank-id]
                   :amount 2500
                   :reference "Bank A payment"}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/internal/{payment-id}"
             :path-params {:payment-id [:ref :payment-b :payment-id]}
             :auth [:ref :bank-b :token]}
   :assert {:status 200
            :body {:payment-id [:ref :payment-b :payment-id]
                   :bank-id [:ref :bank-b :bank :bank-id]
                   :amount 7100
                   :reference "Bank B payment"}}}
  ;; Each bank was debited for its own payment and no other.
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-a :account :account-id]}
             :auth [:ref :bank-a :token]}
   :until {:status 200
           :body {:available-balance {:value 97500 :currency "GBP"}}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor-b :account :account-id]}
             :auth [:ref :bank-b :token]}
   :until {:status 200
           :body {:available-balance {:value 92900 :currency "GBP"}}}}]}
