{:name "Three concurrent submissions on one key make one payment"
 ;; Whether a losing request finds the winner still in flight or
 ;; already committed is the scheduler's business, so the assertion is
 ;; the invariant: exactly one execution, and every other answer either
 ;; a 409 or an exact replay. The 409 specifically is pinned with a
 ;; latch in the idempotency brick's own test.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Internal Race Test"}}
  {:fixture :product
   :as :product
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :party
   :with {:token [:ref :bank-0 :token]
          :display-name "Random Frequentflyer"
          :given-name "Random"
          :family-name "Frequentflyer"
          :date-of-birth "1955-05-05"
          :national-insurance "TN555601F"
          :address {:building-number "9"
                    :street "Improbability Drive"
                    :town "Cottington"
                    :postcode "CT12 4XY"
                    :country "GBR"}}}
  {:fixture :account
   :as :debtor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :party :party :party-id]
          :product-id [:ref :product :product :product-id]
          :name "Current"}}
  {:fixture :account
   :as :creditor
   :with {:token [:ref :bank-0 :token]
          :party-id [:ref :party :party :party-id]
          :product-id [:ref :product :product :product-id]
          :name "Savings"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :bank-0 :bank :bank-id]}
             :body {:amount 100000
                    :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 [{:command :api/race
   :count 3
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :bank-0 :token]
             :headers {:idempotency-key "ik-internal-race-payment-1"}
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-account-id [:ref :creditor :account :account-id]
                    :currency "GBP"
                    :amount 2500
                    :reference "Raced payment"}}
   :as :responses
   :assert {:status 201 :fresh 1}}]
 :then
 ;; One payment, so one debit.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 97500 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/payments/internal/{payment-id}"
             :path-params {:payment-id [:ref :responses 0 :body :payment-id]}
             :auth [:ref :bank-0 :token]}
   :assert {:status 200 :body {:amount 2500 :reference "Raced payment"}}}]}
