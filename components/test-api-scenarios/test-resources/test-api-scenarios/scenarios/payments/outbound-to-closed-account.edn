{:name "A payment to a closed account's address is returned"
 :requires #{:inbound-notified :outbound-returned}
 :runs-on {:payment :every}
 ;; A closed account's provider account is closed too, so the provider
 ;; takes nothing in for it: an outbound from a funded account to the
 ;; closed account's own address completes, then comes back as a return
 ;; coded AC04. The debtor is credited again, and neither the closed
 ;; account nor 2500 suspense is. All amounts in pence.
 :given
 [{:fixture :bank :as :org-0 :with {:name "Inbound To Closed BBAN Test Org"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Closed Address Holder"
          :legal-name "Closed Holder"}}
  {:fixture :product :as :draft :with {:token [:ref :org-0 :token]}}
  {:command :api/request
   :request
   {:method :get :path "/v1/ledger-accounts" :auth [:ref :org-0 :token]}
   :as :ledgers
   :assert {:status 200}}
  {:fixture :account
   :as :debtor
   :with {:token [:ref :org-0 :token]
          :party-id [:ref :party-0 :party :party-id]
          :product-id [:ref :draft :product :product-id]
          :name "Funded Debtor"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Closed Creditor"
                    :currency "GBP"
                    :product-id [:ref :draft :product :product-id]}}
   :as :closed
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :closed :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :closed}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts/{account-id}/close"
             :path-params {:account-id [:ref :closed :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :closed :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200 :body {:status "closed"}}}
  ;; Fund the debtor so the outbound can leave.
  {:command :api/request
   :request {:method :post
             :path "/v1/simulate/inbound-transfer"
             :auth :admin
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}
             :body {:amount 100000 :currency "GBP"}}
   :as :funded-1
   :assert {:status 200}}
  ;; The money reaches the customer from the bank's own funds.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/internal"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :funded-1 :account-id]
                    :creditor-account-id [:ref :debtor :account :account-id]
                    :currency "GBP"
                    :amount 100000
                    :reference "Funding"}}
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :org-0 :token]
             :body {:debtor-account-id [:ref :debtor :account :account-id]
                    :creditor-bban
                    [:str [:ref :closed :payment-addresses 0 :scan :sort-code]
                     [:ref :closed :payment-addresses 0 :scan
                      :account-number]]
                    :creditor-name "Closed Creditor"
                    :currency "GBP"
                    :amount 4200
                    :scheme "fps"
                    :reference "Inbound to a closed address"}}
   :as :outbound
   :assert {:status 201}}]
 :then
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :outbound :payment-id]}
             :auth [:ref :org-0 :token]}
   :until {:status 200
           :body {:payment-status "returned"
                  :return {:reason-code "AC04" :reason "BENACCCLOSED"}}}
   :timeout-ms 10000}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:posted-balance {:value 100000 :currency "GBP"}
                   :available-balance {:value 100000 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/transactions"
             :path-params {:account-id [:ref :debtor :account :account-id]}
             :auth [:ref :org-0 :token]}
   :assert
   {:status 200
    :body {:items [:m/embeds
                   [{:reference "Inbound to a closed address"
                     :transaction-type "outbound-return"
                     :side "credit"
                     :amount 4200}]]}}}
  ;; Nothing arrived: neither the closed account nor suspense moved.
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :closed :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:posted-balance {:value 0 :currency "GBP"}
                   :available-balance {:value 0 :currency "GBP"}}}}
  {:command :api/request
   :request {:method :get
             :path "/v1/ledger-accounts/{account-id}/balances"
             :path-params {:account-id [:ref-find :ledgers :items
                                        :gl-code "2500" :account-id]}
             :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:items [:m/embeds [{:credit 0 :debit 0}]]}}}]}
