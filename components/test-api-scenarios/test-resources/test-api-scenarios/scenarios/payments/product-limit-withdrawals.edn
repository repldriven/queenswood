{:name "A saver allowing one withdrawal a year refuses a second"
 :requires #{:screened}
 ;; The product allows one payment out a year. A withdrawal counts from
 ;; its submission, and one the scheme declines gives its allowance back:
 ;; an outbound payment whose creditor name is 6a41a29eafcf455493 is held
 ;; for screening and then declined, as every payment simulator does.
 ;; Amounts in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Limited Access Saver Bank"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :bank-0 :token]
             :body {:name "Limited Access Saver"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 450
                    :payment-limits
                    [{:direction "out" :measure "count" :max 1 :period "year"}]
                    :effective-from "2026-01-01"}}
   :as :saver
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :saver :product-id]
                  :version-id [:ref :saver :version-id]}
    :auth [:ref :bank-0 :token]}
   :assert {:status 200}}
  {:fixture :person :as :arthur :with {:token [:ref :bank-0 :token]}}
  {:fixture :funded-account
   :as :savings
   :with {:bank-id [:ref :bank-0 :bank :bank-id]
          :token [:ref :bank-0 :token]
          :party-id [:ref :arthur :party :party-id]
          :product-id [:ref :saver :product-id]
          :name "Limited Access Saver"
          :amount 100000}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :savings :opened :account :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "6a41a29eafcf455493"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "Declined"}}
   :as :declined
   :assert {:status 201}}
  ;; While the first is in flight a second is refused.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :savings :opened :account :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "Ford Prefect"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "Too soon"}}
   :assert {:status 429
            :problem {:type ":policy/limit-exceeded"
                      :detail
                      "The product allows at most 1 payment out per year"}}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :declined :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "failed"}}}
  ;; The declined withdrawal gave its allowance back.
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :savings :opened :account :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "Ford Prefect"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "The year's withdrawal"}}
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :savings :opened :account :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "Ford Prefect"
                    :currency "GBP"
                    :amount 2500
                    :scheme-type "fps"
                    :reference "A second"}}
   :assert {:status 429 :problem {:type ":policy/limit-exceeded"}}}]}
