{:name "Two outbound submissions with one body and two keys make two payments"
 ;; The idempotency key, not the body, identifies a submission. A caller
 ;; that retries with a new key has asked for a second payment and gets
 ;; one: two payment ids, both settled, and the debtor debited twice.
 ;; The debtor is funded through the payment simulator's inbound
 ;; payment, whose amount is in pounds. Balances are in pence.
 :given
 [{:fixture :bank :as :bank-0 :with {:name "Outbound Two Keys" :status "live"}}
  {:fixture :product
   :as :current-draft
   :with {:token [:ref :bank-0 :token] :name "Current"}}
  {:fixture :person
   :as :zaphod
   :with {:token [:ref :bank-0 :token]
          :display-name "Zaphod Beeblebrox"
          :legal-name "Zaphod Beeblebrox"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :bank-0 :token]
             :body {:party-id [:ref :zaphod :party :party-id]
                    :name "Zaphod Current"
                    :currency "GBP"
                    :product-id [:ref :current-draft :product :product-id]}}
   :as :debtor
   :assert {:status 201}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200 :body {:status "opened"}}
   :as :debtor}
  {:command :api/request
   :request {:method :post
             :base :payment-simulator
             :path "/simulate/inbound-payment"
             :body {:bban [:ref :debtor :bban]
                    :amount 1000
                    :currency "GBP"
                    :reference "Two keys funding"
                    :debtor-name "Funding Sender"}}
   :assert {:status 202}}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 100000 :currency "GBP"}}}
   :timeout-ms 10000}]
 :when
 ;; One body, sent under two keys.
 [{:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "Ford Prefect"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Two keys"}}
   :as :payment-a
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/payments/outbound"
             :auth [:ref :bank-0 :token]
             :body {:debtor-account-id [:ref :debtor :account-id]
                    :creditor-bban "04006200000001"
                    :creditor-name "Ford Prefect"
                    :currency "GBP"
                    :amount 2500
                    :scheme "fps"
                    :reference "Two keys"}}
   :as :payment-b
   :assert {:status 201
            :body {:payment-id [:m/mismatch [:ref :payment-a :payment-id]]}}}]
 :then
 ;; Both payments exist and settle, and each took its own 25.00.
 [{:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment-a :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-id [:ref :payment-a :payment-id]
                  :payment-status "completed"}}
   :timeout-ms 10000}
  {:command :api/poll
   :request {:method :get
             :path "/v1/payments/outbound/{payment-id}"
             :path-params {:payment-id [:ref :payment-b :payment-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:payment-id [:ref :payment-b :payment-id]
                  :payment-status "completed"}}
   :timeout-ms 10000}
  {:command :api/poll
   :request {:method :get
             :path "/v1/cash-accounts/{account-id}/balances"
             :path-params {:account-id [:ref :debtor :account-id]}
             :auth [:ref :bank-0 :token]}
   :until {:status 200
           :body {:available-balance {:value 95000 :currency "GBP"}}}
   :timeout-ms 10000}]}
