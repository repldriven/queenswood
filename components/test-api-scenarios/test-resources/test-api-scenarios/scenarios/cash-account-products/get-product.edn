{:name "Tenant retrieves a product with its version inline"
 :tags #{:api :cash-account-products :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-get-product-bank-001"}
             :body {:name "Get Product Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-get-product-prod-001"}
             :body {:name "Savings Account"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 250
                    :effective-from "2026-01-01"}}
   :as :product-0
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/cash-account-products/{product-id}"
             :path-params {:product-id [:ref :product-0 :product-id]}
             :auth :org-0-token}
   :assert
   {:status 200
    :body {:product-id [:ref :product-0 :product-id]
           :versions [{:version-id [:ref :product-0 :version-id]
                       :status "draft"
                       :name "Savings Account"}]}}}]}
