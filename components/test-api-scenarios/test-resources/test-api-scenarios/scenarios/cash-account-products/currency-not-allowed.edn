{:name "A currency the product's template doesn't allow is rejected"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Currency Not Allowed Test Org"
                 :status "live"
                 :currencies ["EUR" "GBP"]}}]
 :when
 ;; The savings template allows GBP alone, and the bank declaring EUR
 ;; doesn't widen it — the template is what refuses.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Savings EUR"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "EUR"
                    :interest-rate-bps 250
                    :effective-from "2026-01-01"}}
   :assert {:status 422
            :problem {:type ":cash-account-product/currency-not-allowed"}}}
  ;; The control, and the reason it runs second: the rejection above
  ;; created no product, so this one is still the bank's first savings
  ;; product and clears the micro per-type cap. Run first, it would
  ;; take that slot and the EUR request would trip the cap — which is
  ;; checked before the currency — instead.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Savings GBP"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 250
                    :effective-from "2026-01-01"}}
   :assert {:status 201
            :body {:status "draft"
                   :product-type "savings"
                   :allowed-currencies ["GBP"]}}}]}
