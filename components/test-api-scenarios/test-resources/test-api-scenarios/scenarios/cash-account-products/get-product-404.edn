{:name "Unknown product id returns 404"
 :tags #{:api :cash-account-products :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-get-product-404-bank-001"}
             :body {:name "404 Product Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when [{:command :api/request
         :request {:method :get
                   :path "/v1/cash-account-products/{product-id}"
                   :path-params {:product-id "prd.00000000000000000000000000"}
                   :auth :org-0-token}
         :assert {:status 404
                  :problem {:type ":cash-account-product/product-not-found"}}}]}
