{:name "An effective-to on or before effective-from is rejected"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Invalid Window Test Org" :status "live"}}]
 :when
 ;; effective-to strictly before effective-from.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Backwards Window"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-06-01"
                    :effective-to "2026-01-01"}}
   :assert {:status 422
            :problem {:type ":cash-account-product/invalid-effective-window"}}}
  ;; And the boundary: equal dates are an empty window, also rejected.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Empty Window"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"
                    :effective-to "2026-01-01"}}
   :assert {:status 422
            :problem {:type ":cash-account-product/invalid-effective-window"}}}
  ;; The control: a window that opens before it closes is accepted.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Valid Window"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"
                    :effective-to "2026-06-01"}}
   :assert {:status 201
            :body {:status "draft"
                   :effective-from "2026-01-01"
                   :effective-to "2026-06-01"}}}]}
