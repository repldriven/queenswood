{:name "Account opening pins to the version effective today"
 ;; Three products, one per type because the micro tier caps products
 ;; at one per type, each carrying two published versions that put the
 ;; window resolver under a different case. One party serves all three
 ;; — the IDV cascade is the expensive part of the setup.
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Effective Dating Test Org" :status "live"}}
  {:fixture :person
   :as :party-0
   :with {:token [:ref :org-0 :token]
          :display-name "Trillian Astra"
          :legal-name "Trillian Astra"}}
  ;; --- Current: a live version and a future-dated successor ---------
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Current v1"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2020-01-01"}}
   :as :cur-v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :cur-v1 :product-id]
                  :version-id [:ref :cur-v1 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :cur-v1 :product-id]}
             :auth [:ref :org-0 :token]
             :body {:name "Current v2"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2099-01-01"}}
   :as :cur-v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :cur-v1 :product-id]
                  :version-id [:ref :cur-v2 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  ;; --- Savings: an expired version and its live successor -----------
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Savings v1"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 250
                    :effective-from "2020-01-01"
                    :effective-to "2021-01-01"}}
   :as :sav-v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :sav-v1 :product-id]
                  :version-id [:ref :sav-v1 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :sav-v1 :product-id]}
             :auth [:ref :org-0 :token]
             :body {:name "Savings v2"
                    :currency "GBP"
                    :interest-rate-bps 250
                    :effective-from "2021-01-01"}}
   :as :sav-v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :sav-v1 :product-id]
                  :version-id [:ref :sav-v2 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  ;; --- Term deposit: two live versions with overlapping windows -----
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Term v1"
                    :template-id "tpl.00000000000000000000000003"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2020-01-01"
                    :effective-to "2099-01-01"}}
   :as :td-v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :td-v1 :product-id]
                  :version-id [:ref :td-v1 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :td-v1 :product-id]}
             :auth [:ref :org-0 :token]
             :body {:name "Term v2"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2024-01-01"
                    :effective-to "2099-01-01"}}
   :as :td-v2
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :td-v1 :product-id]
                  :version-id [:ref :td-v2 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}]
 :when
 ;; v2 opens in 2099, so today still resolves to v1.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Current GBP"
                    :currency "GBP"
                    :product-id [:ref :cur-v1 :product-id]}}
   :assert {:status 201
            :body {:product-id [:ref :cur-v1 :product-id]
                   :version-id [:ref :cur-v1 :version-id]
                   :product-type "current"}}}
  ;; v1's window closed in 2021, so the open falls to v2.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Savings GBP"
                    :currency "GBP"
                    :product-id [:ref :sav-v1 :product-id]}}
   :assert {:status 201
            :body {:product-id [:ref :sav-v1 :product-id]
                   :version-id [:ref :sav-v2 :version-id]
                   :product-type "savings"}}}
  ;; Both windows contain today, so the greatest effective-from wins.
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-accounts"
             :auth [:ref :org-0 :token]
             :body {:party-id [:ref :party-0 :party :party-id]
                    :name "Term GBP"
                    :currency "GBP"
                    :product-id [:ref :td-v1 :product-id]}}
   :assert {:status 201
            :body {:product-id [:ref :td-v1 :product-id]
                   :version-id [:ref :td-v2 :version-id]
                   :product-type "term-deposit"}}}]}
