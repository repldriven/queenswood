{:name "Tenant lists their cash-account products"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "List Products Test Org" :status "live"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :product-1
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Savings Account"
                    :template-id "tpl.00000000000000000000000002"
                    :currency "GBP"
                    :interest-rate-bps 250
                    :effective-from "2026-01-01"}}
   :as :product-2
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/cash-account-products" :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:items [:m/embeds
                           [{:product-id [:ref :product-1 :product-id]}
                            {:product-id [:ref :product-2 :product-id]}]]}}}]}
