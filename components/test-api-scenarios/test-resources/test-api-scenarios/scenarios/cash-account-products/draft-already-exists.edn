{:name "Opening a draft while one already exists is rejected"
 :tags #{:api :cash-account-products :lifecycle :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-draft-already-exists-bank-001"}
             :body {:name "Draft Already Exists Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-draft-already-exists-prod-001"}
             :body {:name "Initial Draft"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201 :body {:status "draft"}}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/cash-account-products/{product-id}/versions"
                   :path-params {:product-id [:ref :v1 :product-id]}
                   :auth :org-0-token
                   :body {:name "Second Draft"
                          :template-id "tpl.00000000000000000000000001"
                          :currency "GBP"
                          :interest-rate-bps 0
                          :effective-from "2026-02-01"}}
         :assert {:status 409
                  :problem {:type
                            ":cash-account-product/draft-already-exists"}}}]}
