{:name "Updating a published version is rejected as immutable"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Immutable Update Test Org" :status "live"}}
  {:fixture :product :as :v1 :with {:token [:ref :org-0 :token] :name "v1"}}]
 :when
 [{:command :api/request
   :request {:method :put
             :path
             "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :v1 :product :product-id]
                           :version-id [:ref :v1 :product :version-id]}
             :auth [:ref :org-0 :token]
             :body {:name "Attempted Rename"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :assert {:status 409
            :problem {:type ":cash-account-product/version-immutable"}}}]}
