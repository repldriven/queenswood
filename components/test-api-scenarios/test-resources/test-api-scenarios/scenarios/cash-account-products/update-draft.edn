{:name "Tenant updates a draft version"
 :tags #{:api :cash-account-products :happy :lifecycle}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-update-draft-bank-001"}
             :body {:name "Update Draft Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-update-draft-prod-001"}
             :body {:name "Initial Name"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :draft
   :assert {:status 201 :body {:status "draft" :name "Initial Name"}}}]
 :when
 [{:command :api/request
   :request {:method :put
             :path
             "/v1/cash-account-products/{product-id}/versions/{version-id}"
             :path-params {:product-id [:ref :draft :product-id]
                           :version-id [:ref :draft :version-id]}
             :auth :org-0-token
             :body {:name "Renamed"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 150
                    :effective-from "2026-01-01"}}
   :assert {:status 200
            :body {:product-id [:ref :draft :product-id]
                   :version-id [:ref :draft :version-id]
                   :version-number 1
                   :status "draft"
                   :name "Renamed"
                   :allowed-currencies ["GBP"]
                   :interest-rate-bps 150}}}]}
