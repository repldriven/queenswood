{:name "Tenant opens a new draft after publishing the previous version"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Open New Draft Test Org" :status "live"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "v1"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :v1
   :assert {:status 201}}
  {:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :v1 :product-id]
                  :version-id [:ref :v1 :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200}}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products/{product-id}/versions"
             :path-params {:product-id [:ref :v1 :product-id]}
             :auth [:ref :org-0 :token]
             :body {:name "v2"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 100
                    :effective-from "2026-06-01"}}
   :as :v2
   :assert
   {:status 201
    :body {:product-id [:ref :v1 :product-id]
           :version-id [:m/mismatch
                        [:m/equals [:ref :v1 :version-id]]]
           :version-number 2
           :status "draft"
           :name "v2"}}}]}
