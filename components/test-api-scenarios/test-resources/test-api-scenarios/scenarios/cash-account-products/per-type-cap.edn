{:name "Micro tier caps cash-account-products at one per product type"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Per-Type Cap Org" :status "live"}}
  ;; First current product is fine (the own-funds house product is a
  ;; separate, internal product type that the cap excludes).
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :effective-from "2026-01-01"}}
   :as :product-0
   :assert {:status 201}}]
 :when
 ;; A second product of the same type trips the micro per-type limit.
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Second Current"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :effective-from "2026-01-01"}}
   :assert {:status 429 :problem {:type ":policy/limit-exceeded"}}}]}
