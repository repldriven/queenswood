{:name "Tenant publishes a draft version"
 :given
 [{:fixture :bank
   :as :org-0
   :with {:name "Publish Draft Test Org" :status "live"}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :draft
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/cash-account-products/{product-id}/versions/{version-id}/publish"
    :path-params {:product-id [:ref :draft :product-id]
                  :version-id [:ref :draft :version-id]}
    :auth [:ref :org-0 :token]}
   :assert {:status 200
            :body {:product-id [:ref :draft :product-id]
                   :version-id [:ref :draft :version-id]
                   :status "published"}}}]}
