{:name "The product listing excludes the bank's own-funds house product"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Hides Internal Test Org" :status "live"}}]
 :when
 ;; Provisioning created and published one own-funds product per
 ;; declared currency, so a bank that has defined nothing still holds
 ;; a product. The listing shows none of them.
 [{:command :api/request
   :request
   {:method :get :path "/v1/cash-account-products" :auth [:ref :org-0 :token]}
   :assert {:status 200 :body {:items []}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth [:ref :org-0 :token]
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :product-0
   :assert {:status 201}}
  ;; And after defining one, the listing is that one alone.
  {:command :api/request
   :request
   {:method :get :path "/v1/cash-account-products" :auth [:ref :org-0 :token]}
   :assert
   {:status 200
    :body {:items [{:product-id [:ref :product-0 :product-id]
                    :versions [{:product-type "current"}]}]}}}]}
