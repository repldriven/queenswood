{:name "Tenant creates a cash-account product"
 :tags #{:api :cash-account-products :happy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-create-product-happy-bank-001"}
             :body {:name "Products Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :post
             :path "/v1/cash-account-products"
             :auth :org-0-token
             :headers {:idempotency-key "ik-create-product-happy-prod-001"}
             :body {:name "Current Account"
                    :template-id "tpl.00000000000000000000000001"
                    :currency "GBP"
                    :interest-rate-bps 0
                    :effective-from "2026-01-01"}}
   :as :product-0
   :assert {:status 201
            :body {:product-id [:m/regex "^prd\\."]
                   :version-id [:m/regex "^prv\\."]
                   :version-number 1
                   :status "draft"
                   :name "Current Account"
                   :product-type "current"
                   :balance-sheet-side "liability"
                   :allowed-currencies ["GBP"]
                   :allowed-payment-address-schemes ["scan"]
                   :interest-rate-bps 0
                   :effective-from "2026-01-01"}}}]}
