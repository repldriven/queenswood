{:name "A bank reads its own policies and audit log, and an operator any bank's"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Reading Bank" :status "live"}}
  {:fixture :bank :as :org-1 :with {:name "Other Reading Bank" :status "live"}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :bank :client-id]
         :client-secret [:ref :org-0 :bank :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/bank/policies"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/effective-policy"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-0 :bank :bank-id]}}
   :assert {:status 200 :body {:items [{:kind "bank-created"}]}}}]
 :then
 [;; Another bank's are refused, whether or not it exists.
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/policies"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
   :assert {:status 403}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/effective-policy"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
   :assert {:status 403}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :org-0-token
             :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
   :assert {:status 403}}
  ;; An operator names the bank in the path alone.
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :admin
             :headers {:bank-id [:ref :org-1 :bank :bank-id]}}
   :assert {:status 200 :body {:items [{:kind "bank-created"}]}}}]}
