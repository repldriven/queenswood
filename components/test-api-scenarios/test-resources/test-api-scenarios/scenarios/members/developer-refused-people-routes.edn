{:name "A developer reads the bank's people and is refused changing them"
 ;; The people routes that write are gated `org:admin`, which a
 ;; developer's levels miss, so each refusal is the edge's, whatever
 ;; the target.
 :given
 [{:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "developer-owner"
   :password "developer-owner"
   :as :owner-token}
  {:command :auth/mint-user-token
   :realm :queenswood
   :client-id "queenswood-console"
   :username "developer-developer"
   :password "developer-developer"
   :as :developer-token}
  {:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :body {:name "Developer Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]
                    :owner-email "developer-owner@queenswood.local"}}
   :as :bank
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :bank :owner-invitation
                                           :invitation-id]}
             :auth :owner-token}
   :as :owner-member
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "developer-developer@queenswood.local"
                    :role "developer"}}
   :as :invitation
   :assert {:status 201}}
  {:command :api/request
   :request {:method :post
             :path "/v1/me/invitations/{invitation-id}/accept"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :developer-token}
   :as :developer-member
   :assert {:status 201}}]
 :when
 [{:command :api/request
   :request {:method :get
             :path "/v1/members"
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/bank/audit-events"
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations"
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:email "developer-guest@example.test" :role "viewer"}}
   :assert {:status 403
            :problem {:type "auth/forbidden"
                      :detail "Insufficient privileges"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/members/{member-id}/change-role"
             :path-params {:member-id [:ref :owner-member
                                           :member-id]}
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:role "viewer"}}
   :assert {:status 403 :problem {:type "auth/forbidden"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/members/{member-id}/remove"
             :path-params {:member-id [:ref :owner-member
                                           :member-id]}
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}
             :body {:reason "Not permitted"}}
   :assert {:status 403 :problem {:type "auth/forbidden"}}}
  {:command :api/request
   :request {:method :post
             :path "/v1/invitations/{invitation-id}/withdraw"
             :path-params {:invitation-id [:ref :invitation :invitation-id]}
             :auth :developer-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert {:status 403 :problem {:type "auth/forbidden"}}}]
 :then
 [{:command :api/request
   :request {:method :get
             :path "/v1/members"
             :auth :owner-token
             :headers {:bank-id [:ref :bank :bank-id]}}
   :assert
   {:status 200
    :body
    {:items [:m/in-any-order
             [{:member-id [:ref :owner-member
                               :member-id]
               :role "owner"}
              {:member-id [:ref :developer-member
                               :member-id]
               :role "developer"}]]}}}]}
