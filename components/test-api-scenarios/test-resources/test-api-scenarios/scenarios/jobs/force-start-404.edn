{:name "Force-starting an unknown job returns 404"
 :tags #{:api :jobs :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-force-start-404-bank-001"}
             :body {:name "Force Start 404 Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/jobs/{job-id}/runs"
                   :path-params {:job-id "no-such-job"}
                   :auth :org-0-token
                   :headers {:idempotency-key "ik-force-start-404-run-001"}}
         :assert {:status 404 :problem {:type ":scheduler/job-not-found"}}}]}
