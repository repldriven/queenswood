{:name "A system job's cadence is locked; only its time is editable"
 :tags #{:api :happy :jobs :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-system-job-locked-bank-001"}
             :body {:name "System Job Test Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 ;; Editing the time of day on the seeded system account-migration job
 ;; is allowed and keeps its daily cadence.
 [{:command :api/request
   :request {:method :put
             :path "/v1/jobs/{job-id}/schedule"
             :path-params {:job-id "account-migration"}
             :auth :org-0-token
             :body {:run-time-minutes 300}}
   :assert {:status 200
            :body {:kind "system" :periodicity "daily" :run-time-minutes 300}}}
  ;; Changing its cadence is rejected — the platform fixes it.
  {:command :api/request
   :request {:method :put
             :path "/v1/jobs/{job-id}/schedule"
             :path-params {:job-id "account-migration"}
             :auth :org-0-token
             :body {:periodicity "monthly"}}
   :assert {:status 422 :problem {:type ":scheduler/system-job-locked"}}}
  ;; A system job cannot be paused either.
  {:command :api/request
   :request {:method :put
             :path "/v1/jobs/{job-id}/schedule"
             :path-params {:job-id "account-migration"}
             :auth :org-0-token
             :body {:enabled false}}
   :assert {:status 422 :problem {:type ":scheduler/system-job-locked"}}}]}
