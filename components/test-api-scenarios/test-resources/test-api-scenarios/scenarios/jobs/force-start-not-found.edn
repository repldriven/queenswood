{:name "Force-starting an unknown job returns 404"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Force Start 404 Test Org" :status "live"}}]
 :when [{:command :api/request
         :request {:method :post
                   :path "/v1/jobs/{job-id}/runs"
                   :path-params {:job-id "no-such-job"}
                   :auth [:ref :org-0 :token]}
         :assert {:status 404 :problem {:type ":scheduler/job-not-found"}}}]}
