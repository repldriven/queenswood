{:name "Tenant lists its scheduled jobs"
 :given
 [{:fixture :bank :as :org-0 :with {:name "Jobs Test Bank" :status "live"}}]
 :when
 ;; Every bank is seeded three default jobs at provisioning: the
 ;; user-owned daily-interest (daily; accrue then capitalize; allowed
 ;; cadence is daily-only since accrue is), the system-owned
 ;; account-migration (daily at 00:00; cadence fixed, though its task
 ;; allows any cadence) and the user-owned hourly-rewards (on the hour;
 ;; hourly or daily).
 [{:command :api/request
   :request {:method :get :path "/v1/jobs" :auth [:ref :org-0 :token]}
   :assert
   {:status 200
    :body
    {:items [:m/embeds
             [{:job-id "daily-interest"
               :name "Daily interest"
               :kind "user"
               :task-kinds ["accrue" "capitalize"]
               :periodicity "daily"
               :allowed-periodicities ["daily"]
               :run-time-minutes 1020
               :enabled true}
              {:job-id "account-migration"
               :kind "system"
               :periodicity "daily"
               :run-time-minutes 0
               :allowed-periodicities ["daily" "monthly" "yearly"]}
              {:job-id "hourly-rewards"
               :name "Hourly rewards"
               :kind "user"
               :task-kinds ["reward"]
               :periodicity "hourly"
               :allowed-periodicities ["hourly" "daily"]
               :run-time-minutes 0
               :enabled true}]]}}}]}
