{:name "Tenant lists its scheduled jobs"
 :tags #{:api :happy :jobs}
 :given
 [{:command :api/request
   :request
   {:method :post
    :path "/v1/banks"
    :auth :admin
    :headers {:idempotency-key "ik-jobs-list-happy-bank-001"}
    :body
    {:name "Jobs Test Bank" :status "live" :tier "micro" :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 ;; Every bank is seeded two default jobs at provisioning: the
 ;; user-owned daily-interest (daily; accrue then capitalize; allowed
 ;; cadence is daily-only since accrue is) and the system-owned
 ;; account-migration (daily at 00:00; cadence fixed, though its task
 ;; allows any cadence).
 [{:command :api/request
   :request {:method :get :path "/v1/jobs" :auth :org-0-token}
   :assert
   {:status 200
    :body
    {:jobs [:m/embeds
            [{:job-id "daily-interest"
              :name "Daily interest"
              :kind "user"
              :task-kinds ["accrue" "capitalize"]
              :periodicity "daily"
              :allowed-periodicities ["daily"]
              :run-time-minutes 1020
              :enabled true}
             {:job-id "account-migration"
              :kind "system"
              :periodicity "daily"
              :run-time-minutes 0
              :allowed-periodicities ["daily" "monthly" "yearly"]}]]}}}]}
