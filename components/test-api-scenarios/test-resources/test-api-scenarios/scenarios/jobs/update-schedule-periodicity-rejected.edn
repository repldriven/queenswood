{:name "A periodicity the job's tasks disallow is rejected"
 :tags #{:api :jobs :unhappy}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-update-schedule-bank-001"}
             :body {:name "Schedule Reject Test Org"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 ;; daily-interest carries accrue (daily-only), so its allowed set is
 ;; daily — switching it to monthly is rejected.
 [{:command :api/request
   :request {:method :put
             :path "/v1/jobs/{job-id}/schedule"
             :path-params {:job-id "daily-interest"}
             :auth :org-0-token
             :body {:periodicity "monthly"}}
   :assert {:status 422
            :problem {:type ":scheduler/periodicity-not-allowed"}}}]}
