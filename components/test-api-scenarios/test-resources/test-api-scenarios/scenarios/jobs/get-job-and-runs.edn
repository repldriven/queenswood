{:name "Tenant retrieves a job and its (empty) run history"
 :tags #{:api :happy :jobs}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-get-job-and-runs-bank-001"}
             :body {:name "Jobs Runs Test Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when [{:command :api/request
         :request {:method :get
                   :path "/v1/jobs/{job-id}"
                   :path-params {:job-id "daily-interest"}
                   :auth :org-0-token}
         :assert
         {:status 200
          :body {:job-id "daily-interest" :periodicity "daily" :enabled true}}}
        ;; A job that has never fired carries no runs.
        {:command :api/request
         :request {:method :get
                   :path "/v1/jobs/{job-id}/runs"
                   :path-params {:job-id "daily-interest"}
                   :auth :org-0-token}
         :assert {:status 200 :body {:runs []}}}]}
