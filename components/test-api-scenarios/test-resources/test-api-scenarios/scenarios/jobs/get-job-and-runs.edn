{:name "Tenant retrieves a job and its (empty) run history"
 :given [{:fixture :bank
          :as :org-0
          :with {:name "Jobs Runs Test Bank" :status "live"}}]
 :when [{:command :api/request
         :request {:method :get
                   :path "/v1/jobs/{job-id}"
                   :path-params {:job-id "daily-interest"}
                   :auth [:ref :org-0 :token]}
         :assert
         {:status 200
          :body {:job-id "daily-interest" :periodicity "daily" :status "active"}}}
        ;; A job that has never fired carries no runs.
        {:command :api/request
         :request {:method :get
                   :path "/v1/jobs/{job-id}/runs"
                   :path-params {:job-id "daily-interest"}
                   :auth [:ref :org-0 :token]}
         :assert {:status 200 :body {:items []}}}]}
