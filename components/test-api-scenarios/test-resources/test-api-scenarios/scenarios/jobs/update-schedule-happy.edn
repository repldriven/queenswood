{:name "Editing a job's schedule persists time then pauses it"
 :tags #{:api :happy :jobs}
 :given
 [{:command :api/request
   :request {:method :post
             :path "/v1/banks"
             :auth :admin
             :headers {:idempotency-key "ik-update-schedule-happy-bank-001"}
             :body {:name "Schedule Edit Test Bank"
                    :status "live"
                    :tier "micro"
                    :currencies ["GBP"]}}
   :as :org-0
   :assert {:status 201}}
  {:command :auth/mint-token
   :for {:client-id [:ref :org-0 :client-id]
         :client-secret [:ref :org-0 :client-secret]
         :status :live}
   :as :org-0-token}]
 :when
 ;; Omitted fields keep their current value, so changing only the time
 ;; leaves the daily cadence intact.
 [{:command :api/request
   :request {:method :put
             :path "/v1/jobs/{job-id}/schedule"
             :path-params {:job-id "daily-interest"}
             :auth :org-0-token
             :body {:run-time-minutes 360}}
   :assert {:status 200
            :body {:job-id "daily-interest"
                   :periodicity "daily"
                   :run-time-minutes 360
                   :enabled true}}}
  ;; Pause is just toggling enabled.
  {:command :api/request
   :request {:method :put
             :path "/v1/jobs/{job-id}/schedule"
             :path-params {:job-id "daily-interest"}
             :auth :org-0-token
             :body {:enabled false}}
   :assert {:status 200 :body {:run-time-minutes 360 :enabled false}}}
  ;; Reload to prove the paused state round-trips through FDB — an unset
  ;; optional bool must decode back to false, not vanish.
  {:command :api/request
   :request {:method :get
             :path "/v1/jobs/{job-id}"
             :path-params {:job-id "daily-interest"}
             :auth :org-0-token}
   :assert {:status 200 :body {:run-time-minutes 360 :enabled false}}}]}
