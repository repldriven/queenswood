{:name "A service credential naming another bank in Bank-Id is refused"
 ;; The same bearer reads its own bank, with or without the header, so
 ;; what refuses the last read is the bank the header names.
 :given
 [{:fixture :bank :as :bank-a :with {:name "Credential Bank A" :status "live"}}
  {:fixture :bank :as :bank-b :with {:name "Credential Bank B" :status "live"}}
  {:command :auth/mint-token
   :for {:client-id [:ref :bank-a :bank :client-id]
         :client-secret [:ref :bank-a :bank :client-secret]
         :status :live}
   :as :bank-a-token}]
 :when
 [{:command :api/request
   :request {:method :get :path "/v1/cash-accounts" :auth :bank-a-token}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :headers {:bank-id [:ref :bank-a :bank :bank-id]}}
   :assert {:status 200}}
  {:command :api/request
   :request {:method :get
             :path "/v1/cash-accounts"
             :auth :bank-a-token
             :headers {:bank-id [:ref :bank-b :bank :bank-id]}}
   :assert {:status 403
            :problem {:type "auth/forbidden"
                      :detail "The caller is not a member of this bank"}}}]}
