{:name "Duplicate national-identifier within an org is rejected"
 ;; Pins the rejection kind that the property test only sees as a generic
 ;; `:denied` outcome. Two creates with the same NI marker in the same org
 ;; — the second must reject with `:party/identification-rejected` (the
 ;; opaque contractual kind that API responses surface; the underlying
 ;; cause is not revealed to callers). Cross-org reuse is allowed and is
 ;; covered by the property test, so it isn't repeated here.
 :given [{:command :create-bank :args []}
         {:command :create-person-party :args [:bank-0 :ni-shared]}]
 :when [{:command :assert-no-anomaly :args []}
        {:command :create-person-party :args [:bank-0 :ni-shared]}]
 :then [{:command :assert-outcome :args [:denied]}
        {:command :assert-rejection-kind
         :args [:party/identification-rejected]}]}
