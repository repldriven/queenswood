{:name "Open an account for a person party"
 ;; Tenant onboards a person-party (the IDV chain runs and activates
 ;; the party transparently), then opens a customer account on the
 ;; org's auto-published settlement product for that person — the
 ;; canonical "Arthur opens his current account" shape (modulo
 ;; product-type, which we leave at settlement here).
 :given [{:command :create-bank :args []}                          ; org-0,
                                                                   ; prod-0,
                                                                   ; party-0
                                                                   ; (org),
                                                                   ; acct-0
         {:command :create-person-party :args [:bank-0]}           ; party-1
                                                                   ; (person,
                                                                   ; auto-active)
         {:command :open-account :args [:bank-0 :party-1 :prod-0]} ; acct-1
                                                                   ; owned by
                                                                   ; person
         {:command :inbound-transfer :args [:acct-0 1000]}] ; fund
                                                            ; settlement-side
 :when [{:command :internal-transfer :args [:acct-0 :acct-1 600]}]
 :then [{:command :assert-no-anomaly :args []}
        {:command :assert-balance :args [:acct-0 400]}
        {:command :assert-balance :args [:acct-1 600]}]}
