{:name "Internal transfer with unknown currency is rejected"
 ;; Two accounts in one org, both GBP (the only currency the
 ;; scenario harness allocates). Submitting an internal transfer
 ;; with `:currency "EUR"` must reject at the domain
 ;; `ensure-currency-matches` guard before any leg is recorded.
 :given [{:command :create-bank :args []}
         {:command :create-person-party :args [:bank-0]}
         {:command :open-account :args [:bank-0 :party-1 :prod-0]}
         {:command :inbound-transfer :args [:acct-0 1000]}]
 :when [{:command :internal-transfer :args [:acct-0 :acct-1 100 "EUR"]}]
 :then [{:command :assert-rejection-kind :args [:payment/currency-mismatch]}
        {:command :assert-balance :args [:acct-0 1000]}
        {:command :assert-balance :args [:acct-1 0]}]}
