{:name "Outbound payment with a negative amount is rejected"
 ;; A funded customer account submits an outbound payment with a
 ;; negative amount. The transaction-layer leg validation rejects
 ;; (`:transaction/invalid-amount`) before any balance moves and
 ;; before the scheme adapter command is published.
 :given [{:command :create-bank :args []}
         {:command :inbound-transfer :args [:acct-0 1000]}]
 :when [{:command :outbound-payment :args [:acct-0 -100]}]
 :then [{:command :assert-rejection-kind :args [:transaction/invalid-amount]}
        {:command :assert-balance :args [:acct-0 1000]}]}
