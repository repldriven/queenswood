{:name "Cross-org internal transfer is rejected"
 ;; Two orgs, each with one account. The funded account belongs to
 ;; org-0; the empty one to org-1. submit-internal resolves the
 ;; organization from the debtor and looks up the creditor under the
 ;; same org — so the cross-org creditor lookup fails, the API
 ;; rejects, and balances stay put.
 :given [{:command :create-bank :args []} {:command :create-bank :args []}
         {:command :inbound-transfer :args [:acct-0 1000]}]
 :when [{:command :internal-transfer :args [:acct-0 :acct-1 400]}]
 :then [{:command :assert-rejection-kind :args [:cash-account/not-found]}
        {:command :assert-balance :args [:acct-0 1000]}
        {:command :assert-balance :args [:acct-1 0]}]}
