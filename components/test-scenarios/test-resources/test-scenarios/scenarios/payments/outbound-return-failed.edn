{:name "Returning a failed outbound fails and moves no money"
 ;; A return names a payment that never left: the handler fails, so the
 ;; event is redelivered and dead-lettered rather than committed past,
 ;; and the failed payment's released reservation stays released.
 :given [{:command :create-bank :args []}
         {:command :inbound-transfer :args [:acct-0 1000]}
         {:command :outbound-payment-refused :args [:acct-0 250]}
         {:command :reject-outbound-payment :args [:pmt-0]}]
 :when [{:command :assert-outbound-status
         :args [:pmt-0 :outbound-payment-status-failed]}
        {:command :assert-balance :args [:acct-0 1000]}
        {:command :return-outbound-event :args [:pmt-0 250]}]
 :then [{:command :assert-outcome :args [:denied]}
        {:command :assert-rejection-kind :args [:payment/return-outbound]}
        {:command :assert-outbound-status
         :args [:pmt-0 :outbound-payment-status-failed]}
        {:command :assert-balance :args [:acct-0 1000]}
        {:command :assert-gl-balance
         :args [:bank-0 :ledger-account-code-cash-at-correspondent "GBP" -1000]}
        {:command :assert-gl-balance
         :args [:bank-0 :ledger-account-code-pending-outbound "GBP" 0]}]}
