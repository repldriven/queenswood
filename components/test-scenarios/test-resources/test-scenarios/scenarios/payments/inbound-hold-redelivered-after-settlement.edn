{:name "A hold redelivered after its settlement records nothing"
 :model :reality
 ;; Delivery is at-least-once, so a hold can arrive again after the
 ;; settlement that released it. It names the settled record's end-to-end
 ;; id, creditor and amount, and that record answers it: no second hold is
 ;; recorded, and the account is credited once.
 :given [{:command :create-bank :args []}
         {:command :hold-inbound :args [:acct-0 1000 :e2e-redelivered]}
         {:command :release-inbound :args [:acct-0]}]
 :when [{:command :hold-inbound :args [:acct-0 1000 :e2e-redelivered]}]
 :then [{:command :assert-no-anomaly :args []}
        {:command :assert-inbound-status
         :args [:e2e-redelivered :inbound-payment-status-settled :acct-0]}
        {:command :assert-balance :args [:acct-0 1000]}]}
