{:name "A rejection after the provider returned a payment moves no money"
 ;; The provider settles the payment and then returns it, so its money is
 ;; back on the debtor. A rejection arriving after that has nothing left
 ;; in flight to reverse: the payment stays `returned` and the debtor's
 ;; balance where the return left it.
 :given [{:command :create-bank :args []}
         {:command :inbound-transfer :args [:acct-0 1000]}
         {:command :outbound-payment :args [:acct-0 250]}
         {:command :return-outbound-payment :args [:pmt-0]}]
 :when [{:command :assert-outbound-status
         :args [:pmt-0 :outbound-payment-status-returned]}
        {:command :assert-balance :args [:acct-0 1000]}
        {:command :reject-outbound-payment :args [:pmt-0]}]
 :then [{:command :assert-outbound-status
         :args [:pmt-0 :outbound-payment-status-returned]}
        {:command :assert-balance :args [:acct-0 1000]}
        {:command :assert-gl-balance
         :args [:bank-0 :ledger-account-code-pending-outbound "GBP" 0]}
        {:command :assert-gl-balance
         :args [:bank-0 :ledger-account-code-customer-deposits-current "GBP"
                1000]}]}
