{:name "Outbound payment is denied when capability is explicitly denied"
 :model :reality
 ;; Bind a deny rule for `:outbound-payment-action-send` to org-0.
 ;; The platform-tier rule still allows, but explicit deny wins
 ;; (see `bank-policy/capability.clj`). Submitting an outbound
 ;; payment must reject with `:policy/denied`; balance unchanged.
 :given
 [{:command :create-bank :args []}
  {:command :inbound-transfer :args [:acct-0 1000]}
  {:command :bind-policy
   :args [:bank-0
          {:name "Test: deny outbound-payment capability"
           :category :policy-category-restricted
           :capabilities
           [{:effect :effect-deny
             :reason "Test: outbound payments disallowed"
             :kind
             {:outbound-payment {:action :outbound-payment-action-send}}}]}]}]
 :when [{:command :outbound-payment :args [:acct-0 100]}]
 :then [{:command :assert-rejection-kind :args [:policy/denied]}
        {:command :assert-balance :args [:acct-0 1000]}]}
