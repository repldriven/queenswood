{:name "Daily outbound-payment count limit is enforced per org"
 :model :reality
 ;; Bind a tight `max 2 outbound-payments per day` policy to org-0,
 ;; then submit two outbound payments (within cap) and a third
 ;; (over cap). The third must be rejected with
 ;; `:policy/limit-exceeded`; the debtor balance must reflect only
 ;; the two successful debits.
 :given
 [{:command :create-bank :args []}
  {:command :inbound-transfer :args [:acct-0 1000]}
  {:command :bind-policy
   :args
   [:bank-0
    {:name "Test: max 2 outbound payments per day"
     :category :policy-category-restricted
     :limits
     [{:kind {:outbound-payment {}}
       :bound {:kind {:max {:aggregate
                            {:kind
                             {:count {:value 2 :window :time-window-daily}}}}}}
       :reason "Test-bound daily count cap"}]}]}
  {:command :outbound-payment :args [:acct-0 100]}
  {:command :outbound-payment :args [:acct-0 100]}]
 :when [{:command :outbound-payment :args [:acct-0 100]}]
 :then [{:command :assert-rejection-kind :args [:policy/limit-exceeded]}
        {:command :assert-balance :args [:acct-0 800]}]}
