{:name "Daily internal-payment count limit is enforced per org"
 ;; Bind a tight `max 2 internal-payments per day` policy to org-0,
 ;; then submit two transfers (within cap) and a third (over cap).
 ;; The third must be rejected with `:policy/limit-exceeded`; the
 ;; balances must reflect only the two successful moves.
 ;;
 ;; This exercises (a) the per-org PolicyBinding resolution that
 ;; `get-effective-policies` does, and (b) the `check-daily-count`
 ;; gate in the payment domain. The platform-tier `100,000/day`
 ;; rule still applies — it just isn't the binding constraint.
 :given
 [{:command :create-bank :args []}
  {:command :create-person-party :args [:bank-0]}
  {:command :open-account :args [:bank-0 :party-1 :prod-0]}
  {:command :inbound-transfer :args [:acct-0 1000]}
  {:command :bind-policy
   :args
   [:bank-0
    {:name "Test: max 2 internal payments per day"
     :category :policy-category-restricted
     :limits
     [{:kind {:internal-payment {}}
       :bound {:kind {:max {:aggregate
                            {:kind
                             {:count {:value 2 :window :time-window-daily}}}}}}
       :reason "Test-bound daily count cap"}]}]}
  {:command :internal-transfer :args [:acct-0 :acct-1 100]}
  {:command :internal-transfer :args [:acct-0 :acct-1 100]}]
 :when [{:command :internal-transfer :args [:acct-0 :acct-1 100]}]
 :then [{:command :assert-rejection-kind :args [:policy/limit-exceeded]}
        {:command :assert-balance :args [:acct-0 800]}
        {:command :assert-balance :args [:acct-1 200]}]}
