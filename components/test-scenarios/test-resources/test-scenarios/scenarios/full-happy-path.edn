{:name
 "Full happy path: two parties, two products, transfers, payment, interest"
 :tags #{:capstone :happy-path}
 ;; Replays the manual UI smoke test end-to-end:
 ;;
 ;;   - Customer org with a settlement account auto-created
 ;;   - Two products: current (rate 0) and savings (rate 3650 bps)
 ;;   - Two person parties — Arthur and Ford — each with a current
 ;;     and a savings account
 ;;   - Settlement funded with £50,000
 ;;   - Each party rewarded £1,000 into their current account
 ;;   - Arthur moves £750 current → savings
 ;;   - Ford moves £350 current → savings
 ;;   - Ford pays £25 outbound (scheme path)
 ;;   - Daily interest accrues on the savings products and is capitalised
 ;;
 ;; All amounts in pence (1 minor unit). Accrual moves no money the
 ;; customer can spend — it credits an internal accrued bucket, which
 ;; `available-balance` does not count — so only capitalisation shows
 ;; up in a projected balance.
 :given [;; --- Org setup
         ;; -------------------------------------------------- org-0,
         ;; prod-0 (settlement, published), party-0 (org-party,
         ;; active), acct-0 (settlement)
         {:command :create-bank :args []} {:command :assert-no-anomaly :args []}
         ;; --- Products
         ;; ---------------------------------------------------
         ;; prod-1 = current (rate 0), prod-2 = savings (rate 3650 bps)
         {:command :create-product :args [:bank-0 :current 0]}
         {:command :create-product :args [:bank-0 :savings 3650]}
         {:command :publish-product :args [:prod-1]}
         {:command :publish-product :args [:prod-2]}
         {:command :assert-no-anomaly :args []}
         ;; --- Parties
         ;; ---------------------------------------------------- Arthur
         ;; Dent → party-1, Ford Prefect → party-2 (both auto-active via
         ;; the IDV chain — `:create-person-party` waits for the chain to
         ;; settle before the next verb runs).
         {:command :create-person-party :args [:bank-0]}
         {:command :create-person-party :args [:bank-0]}
         {:command :assert-no-anomaly :args []}
         ;; --- Customer accounts
         ;; ------------------------------------------ acct-1 = Arthur
         ;; current  acct-2 = Arthur savings acct-3 = Ford   current
         ;; acct-4 = Ford   savings
         {:command :open-account :args [:bank-0 :party-1 :prod-1]}
         {:command :open-account :args [:bank-0 :party-1 :prod-2]}
         {:command :open-account :args [:bank-0 :party-2 :prod-1]}
         {:command :open-account :args [:bank-0 :party-2 :prod-2]}
         {:command :assert-no-anomaly :args []}
         ;; --- Money in
         ;; --------------------------------------------------- £50,000
         ;; into settlement
         {:command :inbound-transfer :args [:acct-0 5000000]}
         ;; £1,000 reward to each party's current
         {:command :internal-transfer :args [:acct-0 :acct-1 100000]}
         {:command :internal-transfer :args [:acct-0 :acct-3 100000]}
         {:command :assert-no-anomaly :args []}]
 :when [;; --- Customer activity ------------------------------------------
        ;; Arthur: £750 current → savings
        {:command :internal-transfer :args [:acct-1 :acct-2 75000]}
        ;; Ford: £350 current → savings
        {:command :internal-transfer :args [:acct-3 :acct-4 35000]}
        ;; Ford: £25 outbound payment to Arthur — settles the beer and
        ;; nuts debt before they get on the spaceship. The three-arg
        ;; form routes via Arthur's BBAN; the bank-payment event-processor
        ;; recognises the creditor as internal and credits Arthur's
        ;; current on settlement. The verb itself polls the OutboundPayment
        ;; until it's `:completed`, so model-eq lines up without an
        ;; explicit wait step.
        {:command :outbound-payment :args [:acct-3 :acct-1 2500]}]
 :then
 ;; The provider settles the scheme leg and bank-payment's
 ;; event-processor on schemes-payments-event recognises the
 ;; creditor BBAN as internal, posting an inbound credit to
 ;; Arthur's current. The verb sleeps after submit-outbound long
 ;; enough for the chain to settle, so the subsequent model-eq
 ;; check sees the credited state.
 [;; --- Pre-interest balances --------------------------------------
  ;;   settlement   (acct-0): 50,000 - 1,000 - 1,000     = 48,000.00 =
  ;;   4_800_000 Arthur cur   (acct-1): 1,000 - 750 + 25           =
  ;;   275.00 =    27_500 Arthur sav   (acct-2):              + 750
  ;;   =    750.00 =    75_000 Ford   cur   (acct-3): 1,000 - 350 - 25
  ;;        =    625.00 =    62_500 Ford   sav   (acct-4):              +
  ;;        350         =    350.00 =    35_000
  {:command :assert-no-anomaly :args []}
  {:command :assert-balance :args [:acct-0 4800000]}
  {:command :assert-balance :args [:acct-1 27500]}
  {:command :assert-balance :args [:acct-2 75000]}
  {:command :assert-balance :args [:acct-3 62500]}
  {:command :assert-balance :args [:acct-4 35000]}
  ;; --- Interest run -----------------------------------------------
  ;; Daily interest on savings at 3650 bps:
  ;;   Arthur sav  75_000 → 75 pence accrued
  ;;   Ford   sav  35_000 → 35 pence accrued
  ;; Both land in customer.interest-accrued, with no transaction
  ;; written per account. The bank side is one entry for the whole
  ;; run — DR 5100 / CR 2400, both untracked by the rig — so the
  ;; tracked settlement account (acct-0) stays at 4_800_000.
  {:command :accrue-interest :args [:bank-0 20260501]}
  {:command :assert-balance :args [:acct-0 4800000]}
  ;; Capitalisation: 2 legs per customer — the accrued bucket
  ;; debited, the default bucket credited. The bank's side is one
  ;; entry per currency and product type at close, on GL accounts.
  ;; The customer's default grows by the accrued amount; settlement
  ;; (acct-0) stays untouched:
  ;;   Arthur savings.default  += 75      →    75_075
  ;;   Ford   savings.default  += 35      →    35_035
  ;;   current accounts and acct-0 unchanged.
  {:command :capitalize-interest :args [:bank-0 20260501]}
  {:command :assert-balance :args [:acct-0 4800000]}
  {:command :assert-balance :args [:acct-1 27500]}
  {:command :assert-balance :args [:acct-2 75075]}
  {:command :assert-balance :args [:acct-3 62500]}
  {:command :assert-balance :args [:acct-4 35035]}
  {:command :assert-no-anomaly :args []}]}
