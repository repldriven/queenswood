{:name "A held inbound whose release the policy refuses is parked in suspense"
 :tags #{:held :inbound :payments :suspense}
 ;; A hold runs no checks, so it is recorded under a policy that denies
 ;; inbound receipt. Its release runs the checks a settlement runs: the
 ;; denial parks the money in 2500 suspense (DEBIT 1100 / CREDIT 2500)
 ;; and the hold becomes `suspended`, so no step fails and the account is
 ;; never credited.
 :given
 [{:command :create-bank :args []}
  {:command :bind-policy
   :args [:bank-0
          {:name "Test: deny inbound-payment capability"
           :category :policy-category-restricted
           :capabilities
           [{:effect :effect-deny
             :reason "Test: inbound payments disallowed"
             :kind
             {:inbound-payment {:action :inbound-payment-action-receive}}}]}]}]
 :when [{:command :hold-inbound :args [:acct-0 1000 :e2e-refused]}
        {:command :assert-inbound-status
         :args [:e2e-refused :inbound-payment-status-held :acct-0]}
        {:command :release-inbound :args [:acct-0]}]
 :then [{:command :assert-no-anomaly :args []}
        {:command :assert-inbound-status
         :args [:e2e-refused :inbound-payment-status-suspended :acct-0]}
        {:command :assert-balance :args [:acct-0 0]}
        {:command :assert-gl-balance
         :args [:bank-0 :gl-account-code-suspense "GBP" 1000]}
        {:command :assert-gl-balance
         :args [:bank-0 :gl-account-code-cash-at-correspondent "GBP" -1000]}
        {:command :assert-gl-balance
         :args [:bank-0 :gl-account-code-customer-deposits-current "GBP"
                0]}]}
