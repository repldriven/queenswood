{:name
 "Tenant-defined product: create, publish, open a customer account, transfer"
 ;; Models the production flow: Queenswood onboards a tenant
 ;; (`:create-bank`); the tenant defines and publishes a current
 ;; product; the tenant onboards a person-party (IDV runs
 ;; transparently); the tenant opens a customer account on the
 ;; published product for that person; an internal transfer moves
 ;; funds from the org's settlement account to the customer one.
 :given [{:command :create-bank :args []}                      ; org-0,
                                                               ; prod-0,
                                                               ; party-0
                                                               ; (org), acct-0
         {:command :create-product :args [:bank-0 :current 0]} ; prod-1
                                                               ; (draft)
         {:command :publish-product :args [:prod-1]} ; prod-1 published
         {:command :create-person-party :args [:bank-0]}           ; party-1
                                                                   ; (person,
                                                                   ; auto-active)
         {:command :open-account :args [:bank-0 :party-1 :prod-1]} ; acct-1 on
                                                                   ; prod-1,
                                                                   ; owned by
                                                                   ; person
         {:command :inbound-transfer :args [:acct-0 500]}]
 :when [{:command :internal-transfer :args [:acct-0 :acct-1 200]}]
 :then [{:command :assert-no-anomaly :args []}
        {:command :assert-balance :args [:acct-0 300]}
        {:command :assert-balance :args [:acct-1 200]}]}
