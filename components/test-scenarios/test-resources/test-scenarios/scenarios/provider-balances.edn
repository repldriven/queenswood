{:name "The provider holds what the ledger does, flow by flow"
 :tags #{:edn-only :payments :provider :interest :suspense}
 ;; Where the payment provider holds a balance for each account, every
 ;; posting that moves money between accounts is mirrored there. After
 ;; each flow the provider balance of every customer account equals its
 ;; posted balance, and the bank's provider balances together equal 1100
 ;; cash at correspondent, the money the scheme moved: the house account
 ;; holds its own posted balance and the bank's GL money besides.
 ;;
 ;; The bank's own funds arrive from outside the scheme, as the sandbox's
 ;; simulated inbound posts them, so the provider credits the house from
 ;; outside. An inbound to acct-0 lands in its provider account as the
 ;; scheme left it. An internal payment moves between the two provider
 ;; accounts. Interest capitalised is paid from own funds. An inbound the
 ;; daily count refuses parks in 2500, and its money moves from the
 ;; receiving account's provider account to own funds.
 :given
 [{:command :create-bank :args []}
  {:command :create-product :args [:bank-0 :savings 3650]}
  {:command :publish-product :args [:prod-1]}
  {:command :create-person-party :args [:bank-0]}
  {:command :open-account :args [:bank-0 :party-1 :prod-1]}
  {:command :fund-house :args [:bank-0 500000]}
  {:command :inbound-transfer :args [:acct-0 100000]}]
 :when
 [{:command :assert-provider-balances :args [:bank-0]}
  {:command :internal-transfer :args [:acct-0 :acct-1 60000]}
  {:command :assert-provider-balances :args [:bank-0]}
  {:command :accrue-interest :args [:bank-0 20260501]}
  {:command :capitalize-interest :args [:bank-0 20260501]}
  {:command :assert-provider-balances :args [:bank-0]}
  {:command :bind-policy
   :args
   [:bank-0
    {:name "Test: max 1 inbound payment per day"
     :category :policy-category-restricted
     :limits
     [{:kind {:inbound-payment {}}
       :bound {:kind {:max {:aggregate
                            {:kind
                             {:count {:value 1 :window :time-window-daily}}}}}}
       :reason "Test-bound daily count cap"}]}]}
  {:command :inbound-transfer :args [:acct-0 2500 :e2e-refused]}]
 :then
 [{:command :assert-no-anomaly :args []}
  {:command :assert-inbound-status
   :args [:e2e-refused :inbound-payment-status-suspended]}
  {:command :assert-gl-balance
   :args [:bank-0 :gl-account-code-suspense "GBP" 2500]}
  {:command :assert-provider-balances :args [:bank-0]}]}
