{:name
 "A second force-start of the daily-interest job is a no-op per the daily limit"
 :model :reality
 ;; Bind a `max 1 accrual run per day` policy, then force-start the
 ;; seeded daily-interest job twice for the same day. The first run
 ;; accrues + capitalises and records a succeeded SchedulerRun; the
 ;; second re-runs accrue, which the daily-count limit rejects with
 ;; `:policy/limit-exceeded` — so run-job records a failed run and
 ;; returns the rejection rather than double-posting. force-start uses
 ;; today's epoch-day, so both runs share the same dedup key.
 :given
 [{:command :create-bank :args []}
  {:command :bind-policy
   :args
   [:bank-0
    {:name "Test: max 1 accrual run per day"
     :category :policy-category-restricted
     :limits
     [{:kind {:interest {:filters [{:action :interest-action-accrue}]}}
       :bound {:kind {:max {:aggregate
                            {:kind
                             {:count {:value 1 :window :time-window-daily}}}}}}
       :reason "Test-bound daily accrual cap"}]}]}
  {:command :force-start-job :args [:bank-0 "daily-interest"]}]
 :when [{:command :force-start-job :args [:bank-0 "daily-interest"]}]
 :then [{:command :assert-rejection-kind :args [:policy/limit-exceeded]}]}
