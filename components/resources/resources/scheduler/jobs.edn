;; Default scheduled jobs seeded into every bank at provisioning.
;; Templates carry no :bank-id / timestamps — those are stamped at
;; seed time. :job-id is stable so re-seeding overwrites in place.
;; :schedule is a Quartz cron in UTC, which each task's cadence limits
;; (accrue exactly daily), so [accrue capitalize] is daily.
;; :kind is user (operator-editable) or system (platform-fixed cadence,
;; only the time of day editable).
[{:job-id "daily-interest"
  :name "Daily interest"
  :task-kinds [:scheduler-task-kind-accrue :scheduler-task-kind-capitalize]
  :schedule "0 0 17 * * ?"
  :status :scheduler-job-status-active
  :kind :scheduler-job-kind-user}
 ;; System job: account migration runs every day at 00:00 UTC. It
 ;; commits every migration that is approved and due, and is the only
 ;; thing in the system that moves an account between products.
 {:job-id "account-migration"
  :name "Account migration"
  :task-kinds [:scheduler-task-kind-account-migration]
  :schedule "0 0 0 * * ?"
  :status :scheduler-job-status-active
  :kind :scheduler-job-kind-system}]
