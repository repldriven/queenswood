{:compact-views #{}
 :interface-ns "interface"
 :projects
 {"development" {:alias "dev"}
  ;; resources, test-resources and test-startup carry shared classpath
  ;; resources (Testcontainers configs, application-test.yml files) that
  ;; no brick imports. Polylith tracks source imports only, so :necessary
  ;; suppresses the false-positive warning 207 for them.
  "operational-processors-service" {:alias "ops"
                                    :necessary ["resources" "test-resources"
                                                "test-startup"]}
  "financial-processors-service" {:alias "fin"
                                  :necessary ["resources" "test-resources"
                                              "test-startup"]}
  "api-service" {:alias "api"
                 :necessary ["resources" "test-resources" "test-startup"]}
  "bootstrap-service" {:alias "bbs"
                       :necessary ["resources" "test-resources"
                                   "test-startup"]}
  "migrator-service" {:alias "mig"
                      :necessary ["resources" "test-resources"
                                  "test-startup"]}
  "exclusive-dispatchers-service" {:alias "exd"
                                   :necessary ["resources" "test-resources"
                                               "test-startup"]}
  "external-adapters-service" {:alias "ext"
                               :necessary ["resources" "test-resources"
                                           "test-startup"]}
  "monolith-service" {:alias "mon"
                      :necessary ["resources" "test-resources"
                                  "test-startup"]}}
 :tag-patterns {:release "v[0-9]*" :stable "stable-*"}
 :test {:create-test-runner
        com.repldriven.mono.external-test-runner.core/create}
 :top-namespace "com.repldriven.queenswood"
 :vcs {:auto-add true :name "git"}}
