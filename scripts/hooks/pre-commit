#!/usr/bin/env bash
set -e

# Format and lint are mono's, sourced from the imported hook library. A
# worktree whose post-checkout could not import gets one more try here.
lib=.mono/scripts/hooks/lib.sh
if [ ! -f "$lib" ] && [ -f scripts/mono-import.sh ]; then
  bash scripts/mono-import.sh >/dev/null 2>&1 || true
fi
if [ ! -f "$lib" ]; then
  echo "pre-commit: $lib is missing — run: just mono-import" >&2
  exit 1
fi
. "$lib"

echo "Checking for system identifiers..."
bash scripts/hooks/check-system-ids.sh --staged

files=$(hook_staged_clojure_files)

if [ -n "$files" ]; then
  hook_format "$files"
  hook_lint "$files"

  hook_semgrep "$files" .mono/.config/semgrep/semgrep.yml .config/semgrep/semgrep.yml

  echo "Checking Queenswood guardrails..."
  bash scripts/hooks/enforce-idioms.sh --staged
fi

helm_files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^infra/helm/queenswood/' || true)

if [ -n "$helm_files" ]; then
  # `helm dependency update` is skipped: a prior `just helm-*` recipe
  # populates charts/, and without one `helm template` fails naming the
  # missing chart.
  echo "Validating Helm chart..."
  helm lint infra/helm/queenswood >/dev/null
  helm template queenswood infra/helm/queenswood \
    --set image.tag=dev \
    | kubeconform -strict -ignore-missing-schemas -summary
fi
