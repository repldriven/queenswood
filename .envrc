source_up_if_exists
if has nix; then
  use flake .
else
  echo "nix not found — run scripts/check-setup.sh for install instructions"
fi

# Read by `just mono-import`, so a bump re-evaluates this file.
watch_file deps/mono-dev/deps.edn

echo "Prepping libraries..."
clj -X:deps prep :aliases '[:dev]'

# Hooks live in the git dir, which is not versioned, so the tracked
# scripts do nothing until they are copied in. Entering the primary
# checkout is the one moment that reliably happens — and direnv is
# allowed per directory, so this does not fire in a worktree. The import
# goes first: install-hooks is one of the recipes it lays down, and
# direnv abandons the evaluation at the first failing command.
if has just; then
  if just mono-import; then
    just install-hooks
    # And the rules themselves, which post-checkout installs for a
    # worktree but cannot install here: a clone's own checkout runs
    # before there is any hook to run. Only when missing — refreshing a
    # current one is what `just tessl-plugins-check` is for.
    [ -f .tessl/RULES.md ] || just tessl-plugins-install
  else
    echo "mono-import failed — run just mono-import, then just install-hooks"
  fi
fi
