;; Single source of the mono build coordinate: the uberjar every project's
;; :build alias runs. Projects reference this by :local/root as
;; ext/mono-build; bases/build keeps only protobuf generation, which mono
;; has no counterpart for.
;;
;; A separate lib symbol from com.repldriven/mono, like ../mono-test-runner,
;; and never on a runtime classpath. Bump all five together unless there is
;; a reason not to.
{:deps {com.repldriven.mono/build
        {:git/url "https://github.com/repldriven/mono.git"
         :git/sha "6963f5e5f9e1d44214db526531b0d4c7a3a91c01"
         :deps/root "bases/build"}}}
