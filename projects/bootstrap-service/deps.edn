{:aliases
 {:build {:deps {bases/build {:local/root "../../bases/build"}}
          :exec-args {:lib 'com.repldriven.queenswood/bootstrap-service
                      :main com.repldriven.queenswood.bootstrap.main
                      :major-minor-version "0.0"}
          :ns-default com.repldriven.queenswood.build.build}
  :test
  {:extra-deps
   {ext/mono {:local/root "../../deps/mono-test"}
    ext/mono-test-runner {:local/root "../../deps/mono-test-runner"}
    component/test-resources {:local/root "../../components/test-resources"}
    component/testcontainers {:local/root "../../components/testcontainers"}
    component/test-schema {:local/root "../../components/test-schema"}
    component/test-startup {:local/root "../../components/test-startup"}}}}
 ;; The whole closure of what the Job seeds: policies and the four
 ;; cash-account-product templates, over FDB. `cash-account-product` is
 ;; here for its `system.clj`, which registers the
 ;; `cash-account-product-templates/template` kind the application.yml
 ;; instantiates — no code references the brick.
 :deps {ext/mono {:local/root "../../deps/mono"}
        component/cash-account-product {:local/root
                                        "../../components/cash-account-product"}
        component/cash-account-product-query
        {:local/root "../../components/cash-account-product-query"}
        component/fdb {:local/root "../../components/fdb"}
        component/policy {:local/root "../../components/policy"}
        component/resources {:local/root "../../components/resources"}
        component/schema {:local/root "../../components/schema"}
        base/bootstrap {:local/root "../../bases/bootstrap"}
        org.clojure/clojure {:mvn/version "1.12.5"}
        pin/clojure-core-async {:local/root "../../deps/clojure-core-async"}}
 :paths ["resources"]}
