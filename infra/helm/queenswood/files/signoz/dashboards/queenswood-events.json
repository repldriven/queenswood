      "28588246-05fd-5512-949a-df2dbdfd399c": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Events in the time range",
            "description": ""
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "count()",
                        "alias": "events"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'process-event' AND service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "",
                    "groupBy": [
                      {
                        "name": "event",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "limit": 25,
                    "order": [
                      {
                        "key": {
                          "name": "count()"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
