      "5e4aa87a-9fa0-5f98-9ab7-fceb10a0d179": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Queue depth",
            "description": "Messages each consumer group has yet to commit on each topic, read from the broker every 15 seconds. A depth that grows is a consumer falling behind what is sent to it. Reply groups are left out: each process reads replies from the newest on, in a group of its own"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "kafka.consumer_group.lag_sum",
                        "timeAggregation": "max",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "group NOT LIKE '%command-response%'"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{group}} on {{topic}}",
                    "groupBy": [
                      {
                        "name": "group",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "topic",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
