{
  "name": "queenswood-events",
  "schemaVersion": "v6",
  "tags": [
    {
      "key": "team",
      "value": "queenswood"
    }
  ],
  "spec": {
    "display": {
      "name": "Queenswood events and bus",
      "description": "Events the changelog relays publish and the bricks that react to them, and every message sent on the bus. A failed event is marked as an error and redelivered."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "service",
            "description": "The services this dashboard reads"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          }
        }
      }
    ],
    "panels": {
      "cc43e818-2bcb-584e-bfbc-0dedd3927a66": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Events processed",
            "description": ""
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "rate()"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'process-event' AND service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{event}}",
                    "groupBy": [
                      {
                        "name": "event",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "53d34f8b-2172-563d-bab8-da6206c4ed6d": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Event failures",
            "description": "Each one is redelivered by the bus"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'process-event' AND service.name IN $service AND has_error = true"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{event}}",
                    "groupBy": [
                      {
                        "name": "event",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
