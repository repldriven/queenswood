                    "legend": "{{command.status}}",
                    "groupBy": [
                      {
                        "name": "command.status",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
