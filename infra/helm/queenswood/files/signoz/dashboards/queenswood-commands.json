{
  "name": "queenswood-commands",
  "schemaVersion": "v6",
  "tags": [
    {
      "key": "team",
      "value": "queenswood"
    }
  ],
  "spec": {
    "display": {
      "name": "Queenswood commands",
      "description": "Commands on the bus. `command-send` times the round trip a caller waits for, reply included; `process-command` times the processor's own work. Both record the reply as `command.status`, and only a FAILED command is marked as an error."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "service",
            "description": "The services this dashboard reads"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          }
        }
      }
    ],
    "panels": {
      "2d0db05a-623f-5424-ac29-94b03c3016f2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Commands processed",
            "description": ""
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "rate()"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'process-command' AND service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{command}}",
                    "groupBy": [
                      {
                        "name": "command",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "9ce2351c-54be-57e5-b00f-023a1c329620": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Commands in the time range",
            "description": ""
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "count()",
                        "alias": "commands"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'process-command' AND service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "",
                    "groupBy": [
                      {
                        "name": "command",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "limit": 25,
                    "order": [
                      {
                        "key": {
                          "name": "count()"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
