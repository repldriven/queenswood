      "b7681bf6-d222-55be-9b8b-f51c19b3adc5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rejected transactions, by category and reason",
            "description": ""
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "count()",
                        "alias": "rejections"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'fdb-transaction' AND service.name IN $service AND fdb.outcome = 'rejected'"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "",
                    "groupBy": [
                      {
                        "name": "fdb.category",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "fdb.reason",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "limit": 25,
                    "order": [
                      {
                        "key": {
                          "name": "count()"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
