                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'fdb-transaction' AND service.name IN $service AND fdb.outcome = 'failed'"
                    },
                    "having": {
                      "expression": ""
