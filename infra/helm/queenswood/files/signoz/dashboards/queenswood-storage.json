{
  "name": "queenswood-storage",
  "schemaVersion": "v6",
  "tags": [
    {
      "key": "team",
      "value": "queenswood"
    }
  ],
  "spec": {
    "display": {
      "name": "Queenswood storage and outbound calls",
      "description": "FoundationDB transactions by category and outcome, and the calls the platform makes out to providers. A transaction a domain rule rejects rolls back as `rejected`, and only a `failed` one is an error."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "service",
            "description": "The services this dashboard reads"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          }
        }
      }
    ],
    "panels": {
      "7cc592f5-26dc-5b3d-801d-f0ee9deec242": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Transactions, by category",
            "description": "The outbound pollers dominate the count; narrow the service to see the rest"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "expression": "rate()"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'fdb-transaction' AND service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{fdb.category}}",
                    "groupBy": [
                      {
                        "name": "fdb.category",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "limit": 15,
                    "order": [
                      {
                        "key": {
                          "name": "rate()"
                        },
                        "direction": "desc"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
