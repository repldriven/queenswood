{
  "name": "queenswood-jvm",
  "schemaVersion": "v6",
  "tags": [
    {
      "key": "team",
      "value": "queenswood"
    }
  ],
  "spec": {
    "display": {
      "name": "Queenswood JVMs",
      "description": "Each service's JVM, from the runtime metrics mono's telemetry SDK exports: garbage collection, heap, CPU and threads, to set against a slow stage in a trace."
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "service",
            "description": "The services this dashboard reads"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "traces"
            }
          }
        }
      }
    ],
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "GC",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/411911a7-b843-5d49-9fc4-ee7bbe6142a5"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/9f76fa14-8b97-55e2-b8ca-c4b860ecd8c3"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/a608dffb-3bb2-5d26-b609-019b82e38fd2"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Memory",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/525360db-71eb-5623-aa83-598b6d7ba90c"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/9e67afe2-1763-5401-adab-ee9301764248"
