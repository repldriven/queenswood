    ],
    "panels": {
      "411911a7-b843-5d49-9fc4-ee7bbe6142a5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Time in garbage collection",
            "description": "Seconds a second each service spends collecting, 1 being all of it. A collector that stops every thread -- Serial, on a one-CPU service -- stalls every request for this long"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "jvm.gc.duration.sum",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{service.name}}",
                    "groupBy": [
                      {
                        "name": "service.name",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "9f76fa14-8b97-55e2-b8ca-c4b860ecd8c3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Collections a second, by collector",
            "description": "Young collections are routine; a rising rate of full or concurrent ones is the heap running short"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "jvm.gc.duration.count",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service"
                    },
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{service.name}} {{jvm.gc.name}}",
                    "groupBy": [
                      {
                        "name": "service.name",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "jvm.gc.name",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
