      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "CPU and threads",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/a3c7667a-3442-5e6f-ac7b-494262c3d63b"
              }
            },
