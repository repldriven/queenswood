{
  "name": "queenswood-api-requests",
  "schemaVersion": "v2",
  "source": "traces",
  "spec": {
    "displayName": "API requests",
    "panelType": "list",
    "requestType": "raw",
    "queries": [
      {
        "type": "builder_query",
        "spec": {
          "name": "A",
          "signal": "traces",
          "filter": {
            "expression": "service.name = 'api-service' AND kind_string = 'Server'"
          },
          "order": [
            {
              "key": {
                "name": "timestamp",
                "fieldContext": "span"
              },
              "direction": "desc"
            }
          ],
          "selectFields": [
            {"name": "timestamp", "fieldContext": "span", "signal": "traces"},
            {"name": "http.request.method", "fieldContext": "attribute", "fieldDataType": "string", "signal": "traces"},
            {"name": "http.route", "fieldContext": "attribute", "fieldDataType": "string", "signal": "traces"},
            {"name": "url.path", "fieldContext": "attribute", "fieldDataType": "string", "signal": "traces"},
            {"name": "http.response.status_code", "fieldContext": "attribute", "fieldDataType": "number", "signal": "traces"},
            {"name": "duration_nano", "fieldContext": "span", "fieldDataType": "number", "signal": "traces"},
            {"name": "trace_id", "fieldContext": "span", "fieldDataType": "string", "signal": "traces"}
          ]
        }
      }
    ],
    "selectedFields": [
      {"name": "timestamp", "fieldContext": "span", "signal": "traces"},
      {"name": "http.request.method", "fieldContext": "attribute", "fieldDataType": "string", "signal": "traces"},
      {"name": "http.route", "fieldContext": "attribute", "fieldDataType": "string", "signal": "traces"},
      {"name": "url.path", "fieldContext": "attribute", "fieldDataType": "string", "signal": "traces"},
      {"name": "http.response.status_code", "fieldContext": "attribute", "fieldDataType": "number", "signal": "traces"},
      {"name": "duration_nano", "fieldContext": "span", "fieldDataType": "number", "signal": "traces"},
      {"name": "trace_id", "fieldContext": "span", "fieldDataType": "string", "signal": "traces"}
    ]
  }
}
