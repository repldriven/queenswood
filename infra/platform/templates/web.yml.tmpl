# The site the apex answers with: a Firebase Hosting site in a project
# of its own at the organisation, and the names below the apex that
# redirect to it. Nothing reconciles it -- `just web-apply` connects
# what is absent and `just web-status` reports the records apex.yml
# still lacks. See ADR-0044.
domain: "${DOMAIN}"
projectId: "${PROJECT}"
site: "${PROJECT}"
names:
${NAMES}
