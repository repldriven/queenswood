server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Runtime config injection. The SPA loads /env.js BEFORE its
    # main module so window.__env is populated by the time
    # keycloak-js initialises. Values come from container env vars,
    # which Helm wires from chart values so the same image works in
    # kind and on GKE without a rebuild.
    location = /env.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 'window.__env={"keycloakUrl":"${KEYCLOAK_URL}","keycloakRealm":"${KEYCLOAK_REALM}","keycloakClientId":"${KEYCLOAK_CLIENT_ID}","keycloakIdpHint":"${KEYCLOAK_IDP_HINT}"};';
    }

    # bank-api proxy. proxy_pass without trailing slash forwards the
    # full URI so /v1/me reaches bank-api at /v1/me unchanged. Same
    # pattern as bank-app — the SPA stays same-origin and bypasses
    # CORS entirely.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /oauth/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The simulated identity provider's hosted page, which a
    # verification hand-off opens. The trailing slash strips the
    # prefix; the page finds its decision route from its own path.
    location /identity-provider/ {
        proxy_pass ${IDENTITY_PROVIDER_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Onfido's, the longer prefix, so it wins over the one above.
    location /identity-provider/onfido/ {
        proxy_pass ${ONFIDO_IDENTITY_PROVIDER_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin Keycloak proxy. Browser hits
    # `${current-origin}/keycloak/...`; nginx forwards the path
    # unchanged to upstream, where Keycloak runs natively under
    # `/keycloak/` (`KC_HTTP_RELATIVE_PATH=/keycloak`) and so already
    # builds URLs with that prefix. `$http_host` (not `$host`)
    # preserves the request's port in X-Forwarded-Host -- `$host`
    # drops it. Keycloak (`KC_PROXY_HEADERS=xforwarded`,
    # `KC_HOSTNAME_STRICT=false`) uses that forwarded host as the
    # authority in its generated discovery URLs, redirect URLs, and
    # JWT `iss` claim, so sign-in round-trips through the SPA origin
    # and the token's `iss` matches the verifier's `expectedIssuer`.
    location /keycloak/ {
        proxy_pass ${KEYCLOAK_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # SPA fallback — client-side routing means deep links aren't
    # real files; nginx returns index.html and Svelte handles it.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
