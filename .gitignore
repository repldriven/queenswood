**/classes
**/target
**/.artifacts
**/.cpcache
**/.DS_Store
**/.gradle
**/generated
**/src/gen

# Yarn 4 / npm workspace artefacts. The workspace root and every
# JS-bearing brick (bases/console, bases/bank-app,
# components/ui) shares the same set of throwaways.
**/node_modules/
**/dist/
**/.vite/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
**/.pnp.*

# Vite env files. `.env` and `.env.example` are committed; `.env.local`
# and `.env.*.local` carry developer-specific values and stay local.
**/.env.local
**/.env.*.local

# User-specific stuff
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf
.idea/**/statistic.xml
.idea/dictionaries/**
.idea/libraries/**

# File-based project format
*.iws
*.ipr

# Cursive Clojure plugin
.idea/replstate.xml
*.iml

# Claude Code — only the per-machine and runtime artefacts.
# Everything else under .claude/ is committed: settings.json,
# launch.json, skills/, hooks/.
.claude/settings.local.json
.claude/preview/
.claude/worktrees/

# Clojure tools
.calva
**/.calva-repl
*cider-error*
bases/**/.clj-kondo
components/**/.clj-kondo
projects/**/.clj-kondo
.clj-kondo/*
!.clj-kondo/config.edn
!.clj-kondo/hooks/
bases/**/.lsp
components/**/.lsp
projects/**/.lsp
.lsp/*
!.lsp/config.edn

# REPL and linting files
.nrepl-port
**/.nrepl-port
.rebel_readline_history
.eastwood
.direnv/

# Generated OpenAPI spec
docs/openapi.yaml

# Local runtime artifacts
*.log
log.txt
result.json
__pycache__/
**/__pycache__/
schemathesis-report/

# GCP service-account key written by `just gcp-bootstrap`
gcp-creds.json

# Helm dependency caches (regenerated by `helm dependency update`).
# The vendored chart at infra/helm/queenswood/charts/fdb-operator/
# IS source-of-truth and stays committed.
infra/helm/queenswood/Chart.lock
infra/helm/queenswood/charts/*.tgz
infra/helm/boot-management-plane/Chart.lock
infra/helm/boot-management-plane/charts/*.tgz

# Tessl per-machine agent/editor config (generated by `tessl init`)
.vscode/
.tessl/
.claude/skills/tessl__*
.agents/
.github/skills/

# Scanner output. prowler writes a run's JSON, CSV and HTML here every
# time, and a scan result is a moment rather than a fact about the repo.
output/

# Factory run output, rewritten by every run. As output/ above.
docs/plan/gaps/

# Gas City per-machine rig state, written by the factory tooling.
.gc/
